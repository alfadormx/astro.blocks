{
  "name": "astroblocks",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview --host",
    "astro": "astro",
    "check": "pnpm run check:astro && pnpm run check:lint && pnpm run check:prettier && pnpm run test:unit && pnpm run test:astro && pnpm run test:browser",
    "check:astro": "astro check",
    "check:lint": "eslint .",
    "check:prettier": "prettier --check .",
    "test:unit": "vitest run",
    "test:astro": "vitest run --config vitest.astro.config.ts",
    "test:browser": "node scripts/test-browser.mjs",
    "fix": "pnpm run fix:eslint && pnpm run fix:prettier",
    "fix:eslint": "eslint . --fix",
    "fix:prettier": "prettier --write .",
    "models:generate": "node scripts/generate-ring-models.mjs",
    "stills:generate": "node scripts/generate-ring-stills.mjs"
  },
  "dependencies": {
    "@astrolib/analytics": "^0.6.1",
    "@iconify-json/flat-color-icons": "^1.2.3",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.151",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/tabler": "^1.2.43",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.5",
    "astro-icon": "^1.2.0",
    "astro-seo": "^1.2.0",
    "clsx": "^2.1.1",
    "js-yaml": "^5.5.0",
    "leaflet": "^1.9.4",
    "lodash.merge": "^4.6.2",
    "plyr": "^3.8.5",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "three": "^0.187.0",
    "unpic": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@playwright/test": "^1.64.1",
    "@types/js-yaml": "^4.0.9",
    "@types/leaflet": "^1.9.22",
    "@types/lodash.merge": "^4.6.9",
    "@types/three": "^0.187.0",
    "@typescript-eslint/parser": "^8.72.1",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
