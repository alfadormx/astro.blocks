---
import { METADATA } from 'site-config';
import type { MetaDataIcons } from '#types/metadata.types';

export interface Props {
  /** Icons to link (default: `metadata.icons` from the site config). */
  icons?: MetaDataIcons;
}

const { icons = METADATA.icons } = Astro.props;
---

{icons?.favicon && <link rel="icon" href={icons.favicon} />}
{icons?.apple && <link rel="apple-touch-icon" sizes="180x180" href={icons.apple} />}
{icons?.icon16 && <link rel="icon" type="image/png" sizes="16x16" href={icons.icon16} />}
{icons?.icon32 && <link rel="icon" type="image/png" sizes="32x32" href={icons.icon32} />}
{icons?.maskIcon && <link rel="mask-icon" href={icons.maskIcon} color={icons.maskIconColor} />}
