---
import type { HeaderProps } from '#types/header.types';
import { cn } from '#utils/styles';
import Container from '#components/blocks/layout/Container.astro';
import NavigationTreeHorizontal from './NavigationTreeHorizontal.astro';
import ThemeToggle from '#components/blocks/primitives/ThemeToggle.astro';
import Button from '#components/blocks/primitives/Button.astro';
import type { ButtonProps } from '#types/button.types';
import type { ContainerProps } from '#types/container.types';
import type { NavigationTreeHorizontalProps } from '#types/navigationtreehorizontal.types';
import Logo from '#components/blocks/primitives/Logo.astro';
import { mergeConfigs } from '#utils/mergeConfigs';

type Props = HeaderProps;

const {
  isSticky = false,
  isFloating = false,
  buttonsGap = 'normal',
  buttonsClass,
  container,
  logo,
  leftNavigationTreeHorizontal,
  rightNavigationTreeHorizontal,
  defaultNavigationTreeHorizontalConfig,
  themeToggle,
  leftButtons = [],
  rightButtons = [],
  defaultButtonConfig,
  class: className = '',
  // eslint-disable-next-line @typescript-eslint/no-unused-vars
  children: _children,
  ...attrs
} = Astro.props;

const buttonsGapClasses = {
  none: 'gap-0',
  tight: 'gap-2',
  normal: 'gap-4',
  loose: 'gap-6',
} as const;

const defaultContainerConfig = {
  htmlTag: 'header',
  content: { air: 'none' },
  spacing: { padding: 'py-3 px-4 md:py-4 md:px-6 lg:px-8' },
} as ContainerProps;

const internalButtonConfig: Partial<ButtonProps> = {
  variant: 'ghost',
  intent: 'neutral',
  shape: 'rounded',
  width: 'auto',
};

const mergedContainerConfig = mergeConfigs({}, defaultContainerConfig, container);
const mergedLeftNavigationTreeHorizontal = leftNavigationTreeHorizontal
  ? mergeConfigs<NavigationTreeHorizontalProps>(
      {},
      defaultNavigationTreeHorizontalConfig,
      leftNavigationTreeHorizontal
    )
  : undefined;
const mergedRightNavigationTreeHorizontal = rightNavigationTreeHorizontal
  ? mergeConfigs<NavigationTreeHorizontalProps>(
      {},
      defaultNavigationTreeHorizontalConfig,
      rightNavigationTreeHorizontal
    )
  : undefined;
const buttonsWrapperClass = cn(
  'flex flex-row flex-wrap gap-1',
  buttonsGapClasses[buttonsGap],
  buttonsClass
);

const topClasses = cn(
  isFloating ? 'fixed top-0 left-0 right-0 z-50' : isSticky ? 'sticky top-0 z-40' : ''
);
---

<div
  class={topClasses}
  {...attrs}
  data-header
  data-header-sticky={isSticky || isFloating ? '' : undefined}
>
  <Container {...mergedContainerConfig}>
    <div class={cn('flex flex-wrap items-center gap-y-2', className)} data-header-row>
      <!-- Left Zone: leftButtons + leftNavigationTreeHorizontal -->
      <div class="flex min-w-fit flex-1 basis-0 flex-wrap items-center gap-2 whitespace-nowrap **:shrink-0">
        {leftButtons.length > 0 && (
          <div class={buttonsWrapperClass}>
            {leftButtons.map((button) => (
              <Button {...mergeConfigs({}, internalButtonConfig, defaultButtonConfig, button)} />
            ))}
          </div>
        )}

        {mergedLeftNavigationTreeHorizontal?.items && (
          <NavigationTreeHorizontal {...mergedLeftNavigationTreeHorizontal} />
        )}
      </div>

      <Logo {...logo} />

      <!-- Right Zone: rightNavigationTreeHorizontal + theme toggle + rightButtons -->
      <div class="flex min-w-fit flex-1 basis-0 flex-wrap items-center justify-end gap-2 whitespace-nowrap **:shrink-0">
        {mergedRightNavigationTreeHorizontal?.items && (
          <NavigationTreeHorizontal {...mergedRightNavigationTreeHorizontal} />
        )}

        {themeToggle && <ThemeToggle {...themeToggle} />}

        {rightButtons.length > 0 && (
          <div class={buttonsWrapperClass}>
            {rightButtons.map((button) => (
              <Button {...mergeConfigs({}, internalButtonConfig, defaultButtonConfig, button)} />
            ))}
          </div>
        )}
      </div>
    </div>
  </Container>
</div>

<script>
  const OFFSET_VAR = '--scroll-padding-top';

  // A sticky header inside its own scroll box covers nothing the document scrolls to.
  function scrollsWithDocument(el: HTMLElement): boolean {
    for (let node = el.parentElement; node && node !== document.body; node = node.parentElement) {
      const { overflowY } = getComputedStyle(node);
      if (overflowY === 'auto' || overflowY === 'scroll') return false;
    }
    return true;
  }

  function initHeaders() {
    window.__headerOffsetObserver?.disconnect();
    window.__headerOffsetObserver = undefined;
    document.documentElement.style.removeProperty(OFFSET_VAR);

    const headers = [...document.querySelectorAll<HTMLElement>('[data-header]')];
    const sticky = headers.filter(
      (h) => h.hasAttribute('data-header-sticky') && scrollsWithDocument(h)
    );

    if (sticky.length) {
      let frame = 0;
      const write = () => {
        frame = 0;
        const height = Math.max(...sticky.map((h) => h.offsetHeight));
        document.documentElement.style.setProperty(OFFSET_VAR, `${height}px`);
      };
      const observer = new ResizeObserver(() => {
        if (!frame) frame = requestAnimationFrame(write);
      });
      sticky.forEach((h) => observer.observe(h));
      window.__headerOffsetObserver = observer;
      write();
    }

    headers.forEach((h) => (h.dataset.headerReady = ''));
  }

  function initHeaderScroll() {
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (!header || window.__headerScrollInitialized) return;
    const handleScroll = () => {
      if (window.scrollY > header.offsetHeight) header.setAttribute('data-scrolled', 'true');
      else header.removeAttribute('data-scrolled');
    };
    handleScroll();
    window.addEventListener('scroll', handleScroll, { passive: true });
    window.__headerScrollInitialized = true;
  }

  function init() {
    initHeaders();
    initHeaderScroll();
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
  document.addEventListener('astro:after-swap', initHeaders);
</script>
