---
import 'site-styles';

import { I18N, METADATA } from 'site-config';

import CommonMeta from '@alfadormx/blocks/meta/CommonMeta.astro';
import Favicons from '@alfadormx/blocks/meta/Favicons.astro';
import Analytics from '@alfadormx/blocks/meta/Analytics.astro';
import Metadata from '@alfadormx/blocks/meta/Metadata.astro';
import SiteVerification from '@alfadormx/blocks/meta/SiteVerification.astro';
import Container from '@alfadormx/blocks/layout/Container.astro';
import type { MetaData } from '@alfadormx/blocks/types/metadata';
import type { ContainerProps } from '@alfadormx/blocks/types/container';
import type { HeadlineProps } from '@alfadormx/blocks/types/headline';
import type {
  NavigationTreeItem,
  NavigationTreeProps,
} from '@alfadormx/blocks/types/navigationtree';
import Headline from '@alfadormx/blocks/primitives/Headline.astro';
import NavigationTree from '@alfadormx/blocks/composite/NavigationTree.astro';
import Header from '@alfadormx/blocks/composite/Header.astro';
import Pager from '@alfadormx/blocks/composite/Pager.astro';
import Modal from '@alfadormx/blocks/layout/Modal.astro';
import { mergeConfigs } from '@alfadormx/blocks/utils/mergeConfigs';
import merge from 'lodash.merge';
import { docLinks } from '../_site';
import { DOCS_HOME, currentSection, fullTree, neighbours, type DocLink } from '../_nav';
import { sections } from '../_sections';

export type Props = {
  langCode?: string;
  metadata?: Partial<MetaData>;
  topmostContainer?: Partial<ContainerProps>;
  headline?: Partial<HeadlineProps>;
};

const { langCode, metadata, topmostContainer, headline } = Astro.props;

const currentLang =
  I18N.languages.find((lang: (typeof I18N.languages)[number]) => lang.code === langCode) ||
  I18N.languages.find((lang: (typeof I18N.languages)[number]) => lang.code === I18N.default) ||
  I18N.languages[0];

const htmlLang = currentLang.code;
const htmlDir = currentLang.direction;

const colorScheme = METADATA.theme?.colorScheme || 'light dark';

const defaultMetadata = {
  title: {
    template: '%s | AstroBlocks Documentation',
  },
  description:
    'AstroBlocks is a modern and accessible collection of components and layouts for Astro.',
  keywords: [
    'astro',
    'astroblocks',
    'components',
    'layouts',
    'ui',
    'design system',
    'accessible',
    'modern',
  ],
};

const defaultTopmostContainer = {
  content: { widthType: 'full', air: 'none' },
} as ContainerProps;

const defaultHeadline: HeadlineProps = {
  htmlTag: 'h1',
  class: 'mt-0 mb-10 border-b border-border pb-6',
  titleClass: 'text-4xl',
};

const mergedMetadata = merge({}, defaultMetadata, metadata);
const mergedTopmostContainer = mergeConfigs({}, defaultTopmostContainer, topmostContainer);
const mergedHeadline = mergeConfigs({}, defaultHeadline, headline);

const links = await docLinks();
const path = Astro.url.pathname;
const section = currentSection(links, path);

// Groups read as bold headings with the chevron on the right; pages are small and muted.
const group = (item: NavigationTreeItem): NavigationTreeItem => ({
  ...item,
  iconPosition: 'right',
  class: 'justify-between font-semibold text-normal',
});
const tree: NavigationTreeItem[] = [
  { label: 'Overview', href: DOCS_HOME },
  ...fullTree(links, sections).map(group),
];
const docsNav: NavigationTreeProps = {
  items: tree,
  expansionStrategy: 'always',
  childrenClass: 'ml-3 pl-2 border-l border-border',
  defaultItemConfig: { size: 'sm', class: 'py-1' },
  inactiveItemConfig: { class: 'font-normal text-muted hover:text-normal' },
  activeItemConfig: { variant: 'ghost', intent: 'primary', class: 'bg-primary/10' },
};
const { previous, next } = neighbours(links, path);
const pagerButton = (l?: DocLink) => (l ? { href: l.href, subtitle: l.title } : undefined);
---

<!doctype html>
<html lang={htmlLang} dir={htmlDir}>
  <head>
    <CommonMeta />
    <Favicons />
    <Metadata {...mergedMetadata} alternates={false} />
    <SiteVerification />
    <Analytics />

    <!-- Initialize theme before page renders to prevent FOUC -->
    <script is:inline define:vars={{ colorScheme }}>
      (function () {
        // Parse color scheme config to determine behavior
        // Values: "normal", "light", "dark", "light dark", "dark light", "only light", "only dark"
        const scheme = colorScheme;

        if (scheme === 'only light') {
          document.documentElement.setAttribute('data-theme', 'light');
          localStorage.setItem('theme', 'light');
          return;
        }
        if (scheme === 'only dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
          localStorage.setItem('theme', 'dark');
          return;
        }

        const storedTheme = localStorage.getItem('theme');
        if (storedTheme === 'light' || storedTheme === 'dark') {
          document.documentElement.setAttribute('data-theme', storedTheme);
          return;
        }

        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        let theme;

        if (scheme === 'dark light') {
          theme = prefersDark ? 'dark' : 'light';
        } else {
          theme = prefersDark ? 'dark' : 'light';
        }

        document.documentElement.setAttribute('data-theme', theme);
        localStorage.setItem('theme', theme);
      })();
    </script>
  </head>
  <body>
    <Container {...mergedTopmostContainer}>
      <Header
        isSticky
        class="grid grid-cols-[auto_auto_1fr] gap-x-2"
        logo={{
          label: 'AstroBlocks',
          href: DOCS_HOME,
          icon: { name: 'heroicons:cube' },
          labelClass: 'text-lg font-bold',
        }}
        container={{
          content: { widthType: 'full' },
          background: { class: 'bg-background' },
          border: { width: 'border-b', color: 'border-border' },
          spacing: { padding: 'py-2 px-4' },
        }}
        leftButtons={[
          {
            'data-modal-trigger': 'docs-menu',
            'aria-label': 'Open documentation menu',
            icon: { name: 'heroicons:bars-3' },
            class: 'md:hidden',
          },
        ]}
        themeToggle={{}}
      />
      <Modal id="docs-menu" position="left" size="sm" class="p-4 pt-16">
        <NavigationTree {...docsNav} />
      </Modal>
      <Container
        htmlTag="div"
        content={{ widthType: 'full', air: 'none' }}
        layout={{ type: 'grid', class: 'grid-cols-1 md:grid-cols-[17rem_minmax(0,1fr)]' }}
      >
        {/* 57px: the sticky header (py-2, a 40px button, a 1px border). */}
        <aside
          class="hidden md:block sticky top-14.25 self-start h-[calc(100vh-57px)] overflow-y-auto border-r border-border p-4"
          data-docs-sidebar
        >
          <NavigationTree {...docsNav} />
        </aside>
        <main class="min-w-0 px-4 py-10 md:px-10">
          <div class="mx-auto max-w-5xl">
            <Headline {...mergedHeadline} />
            <slot />
            {section && (
              <Pager
                id="docs-pager"
                langCode={htmlLang}
                ariaLabel="Documentation pages"
                prevButton={pagerButton(previous)}
                nextButton={pagerButton(next)}
                class="mt-16 border-t border-border pt-8"
              />
            )}
          </div>
        </main>
      </Container>
    </Container>
    <script>
      // Bring the current page into view in the sidebar without scrolling the window.
      const sidebar = document.querySelector<HTMLElement>('[data-docs-sidebar]');
      const current = sidebar?.querySelector<HTMLElement>('[aria-current="page"]');
      if (sidebar && current) {
        sidebar.scrollTop = current.offsetTop - sidebar.clientHeight / 2;
      }
    </script>
  </body>
</html>
