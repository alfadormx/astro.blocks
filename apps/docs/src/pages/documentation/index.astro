---
import Layout from './_layouts/Layout.astro';
import ItemsGrid from '@alfadormx/blocks/composite/ItemsGrid.astro';
import { I18N } from 'site-config';
import { collectionIndex } from '@alfadormx/blocks/collections';
import { sections, type SectionKey } from './_sections';
import type { ItemProps } from '@alfadormx/blocks/types/item';
import type { LayerConfig } from '@alfadormx/blocks/types/config';

const metadata = {
  title: {
    default: 'Components',
  },
};

const entries = await collectionIndex('documentation', I18N.default);

// Guides and base tokens are where a newcomer starts, so they lead the page instead of the catalogue.
const START_HERE: readonly SectionKey[] = ['guides', 'base'];
const startHere = START_HERE.flatMap((key) => entries.filter((e) => e.data.section === key));

// Demo guides are listed with their screenshots under "See it in a site", not again in the catalogue.
const OWN_LIST: readonly SectionKey[] = [...START_HERE, 'demos'];

const groups = sections
  .filter((section) => !OWN_LIST.includes(section.key))
  .map((section) => ({ section, entries: entries.filter((e) => e.data.section === section.key) }))
  .filter((g) => g.entries.length);

// Each item is a single Button carrying label and subtitle, so the whole card is one link.
const linkItem: LayerConfig<ItemProps> = {
  orientation: 'horizontal',
  class: 'h-full',
  contentClass: 'w-full h-full',
  actionsClass: 'mt-0 md:mt-0 h-full',
  defaultActionConfig: {
    variant: 'outline',
    intent: 'neutral',
    width: 'full',
    class: 'h-full items-start justify-start text-left font-normal',
    labelClass: 'text-normal',
    subtitleClass: 'text-sm text-muted',
  },
};

const demos = [
  {
    title: 'SaaS landing',
    description:
      'Hero, logos, features, pricing, testimonials, FAQ and a blog, with anchor navigation.',
    guide: '/documentation/demos/Saas',
    demo: '/demos/preview/saas',
    image: '~/assets/images/demos/saas/content-a.jpg',
  },
  {
    title: 'Portfolio',
    description:
      'Hero, case study galleries, team, testimonials and a contact form across several pages.',
    guide: '/documentation/demos/Portfolio',
    demo: '/demos/preview/portfolio',
    image: '~/assets/images/demos/portfolio/hero.jpg',
  },
  {
    title: 'Local business',
    description:
      'Hero, services, reviews, opening hours, a lazy map beside a contact form, and events.',
    guide: '/documentation/demos/Local',
    demo: '/demos/preview/local',
    image: '~/assets/images/demos/local/hero.jpg',
  },
  {
    title: 'Jewellery store',
    description:
      'Hero video, tabbed collections, a 3D ring configurator under a sticky header, a map and a contact form.',
    guide: '/documentation/demos/Jewellery',
    demo: '/demos/preview/jewellery',
    image: '~/assets/images/demos/jewellery/card.jpg',
  },
];
---

<Layout
  metadata={metadata}
  headline={{
    tagline: 'Documentation',
    title: 'Components',
    subtitle: 'Every block in the library, grouped by type.',
  }}
>
  <h2>Start here</h2>
  <ItemsGrid
    columns={2}
    gap="tight"
    class="mb-12"
    defaultItemConfig={linkItem}
    items={startHere.map((e) => ({
      actions: [{ label: e.data.title, subtitle: e.data.description, href: e.href }],
    }))}
  />

  <h2>See it in a site</h2>
  <p>
    Demo sites built only from these blocks, themed with token overrides. Open a demo, or read its
    guide to see how each section is assembled from blocks.
  </p>
  <ItemsGrid
    columns={2}
    gap="tight"
    class="mb-12"
    defaultItemConfig={{
      orientation: 'vertical',
      class: 'h-full items-start text-left gap-4 rounded border border-border p-5',
      contentClass: 'items-start text-left',
      mediaClass: 'w-full aspect-video object-cover rounded',
      titleClass: 'text-lg font-semibold mb-1',
      textClass: 'text-sm text-muted mb-0',
      actionsClass: 'mt-auto flex-row flex-wrap gap-3',
      defaultActionConfig: { size: 'sm', intent: 'neutral' },
    }}
    items={demos.map((demo) => ({
      image: { src: demo.image, alt: '', width: 480, height: 270, layout: 'cover' },
      title: demo.title,
      content: demo.description,
      actions: [
        { label: 'Read the guide', href: demo.guide, variant: 'solid' },
        {
          label: 'Open the demo',
          href: demo.demo,
          target: '_blank',
          variant: 'outline',
          icon: { name: 'heroicons:arrow-top-right-on-square' },
          iconPosition: 'right',
        },
      ],
    }))}
  />

  {groups.map(({ section, entries }) => (
    <Fragment>
      <h2>{section.label}</h2>
      <p>{section.description}</p>
      <ItemsGrid
        columns={3}
        gap="tight"
        class="mb-12"
        defaultItemConfig={{
          ...linkItem,
          defaultActionConfig: {
            ...linkItem.defaultActionConfig,
            variant: 'ghost',
            labelClass: 'text-link',
            class: 'h-full items-start justify-start text-left font-normal px-2 py-1',
          },
        }}
        items={entries.map((e) => ({
          actions: [{ label: e.data.title, subtitle: e.data.description, href: e.href }],
        }))}
      />
    </Fragment>
  ))}
</Layout>
