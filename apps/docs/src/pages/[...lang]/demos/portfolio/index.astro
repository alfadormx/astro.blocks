---
import PortfolioLayout from './_layouts/Layout.astro';
import Hero from '@alfadormx/blocks/composite/Hero.astro';
import Testimonials from '@alfadormx/blocks/composite/Testimonials.astro';
import CollectionList from '@alfadormx/blocks/composite/CollectionList.astro';
import ItemsGrid from '@alfadormx/blocks/composite/ItemsGrid.astro';
import Container from '@alfadormx/blocks/layout/Container.astro';
import TwoColumnContainer from '@alfadormx/blocks/layout/TwoColumnContainer.astro';
import Button from '@alfadormx/blocks/primitives/Button.astro';
import Headline from '@alfadormx/blocks/primitives/Headline.astro';
import type { HeadlineProps } from '@alfadormx/blocks/types/headline';
import type { ItemProps } from '@alfadormx/blocks/types/item';
import { cn } from '@alfadormx/blocks/utils/styles';
import { collectionUrl, getFeatured } from '@alfadormx/blocks/collections';
import { localizedPaths, useCopy } from '@alfadormx/blocks/copy';
import { ARROW_LINK, MONO_LABEL, PROJECT_CARD, asProjects, portfolioHome } from './_site';

export const getStaticPaths = () => localizedPaths();

type Props = { langCode: string; basePath: string };

const { langCode, copy } = useCopy(Astro, 'portfolio');
const home = portfolioHome(langCode);

const SECTION_LABEL: HeadlineProps = {
  htmlTag: 'h2',
  align: 'left',
  class: 'mt-0 mb-6 md:mb-8',
  titleClass: `${MONO_LABEL} mb-0`,
};

const projects = asProjects(await getFeatured('cases', 6, langCode));

const stats: ItemProps[] = Object.values(copy.home.impact.items).map((stat) => ({
  title: stat.value,
  content: stat.label,
}));
---

<PortfolioLayout langCode={langCode} metadata={{ title: { default: copy.home.pageTitle } }}>
  <Hero
    headline={{
      tagline: copy.home.hero.tagline,
      title: copy.home.hero.title,
      align: 'left',
      class: 'my-0 max-w-5xl space-y-3',
      taglineClass: MONO_LABEL,
      titleClass: 'text-3xl md:text-5xl font-medium tracking-tighter leading-[1.05] mb-0',
    }}
    container={{ minHeight: 'min-h-[calc(100svh-4.5rem)]' }}
  />

  <Container>
    <Headline {...SECTION_LABEL} title={copy.home.work.tagline} />
    <CollectionList
      entries={projects}
      langCode={langCode}
      columns={3}
      gap="tight"
      defaultCaseStudyCardConfig={PROJECT_CARD}
    />
    <Button
      {...ARROW_LINK}
      label={copy.home.work.all}
      href={collectionUrl('cases', langCode)}
      align="right"
      class={cn(ARROW_LINK.class, 'mt-12 md:mt-16')}
    />
  </Container>

  <Container>
    <TwoColumnContainer ratio="1:1" gap="loose">
      <Headline slot="left" {...SECTION_LABEL} title={copy.home.impact.tagline} />
      <ItemsGrid
        slot="right"
        columns={1}
        gap="none"
        items={stats}
        defaultItemConfig={{
          orientation: 'horizontal',
          class: 'items-start text-left border-b border-border-emphasis py-8 first:pt-0',
          contentClass: 'items-start text-left',
          titleClass: 'text-6xl md:text-7xl font-light tracking-tighter leading-none mb-6',
          textClass: `${MONO_LABEL} text-normal mb-0`,
        }}
      />
    </TwoColumnContainer>
  </Container>

  <Testimonials
    headline={{ ...SECTION_LABEL, title: copy.home.testimonial.tagline }}
    testimonials={[
      {
        quote: copy.home.testimonial.quote,
        author: {
          name: copy.home.testimonial.name,
          role: copy.home.testimonial.role,
          avatar: { src: '~/assets/images/demos/portfolio/avatar-a.jpg', alt: '' },
        },
      },
    ]}
    columns={1}
    container={{ content: { boxWidth: 'max-w-4xl' } }}
    defaultTestimonialConfig={{
      class: 'gap-16 md:gap-24 bg-transparent border-border-emphasis p-6 md:p-8',
      quoteClass: 'text-xl md:text-2xl leading-snug tracking-tight text-normal',
    }}
  />

  <Container>
    <Headline
      subtitle={copy.home.cta.text}
      align="left"
      class="mt-0 mb-10 md:mb-14"
      subtitleClass="text-2xl md:text-4xl text-normal tracking-tight leading-[1.15] max-w-6xl"
    />
    <Button {...ARROW_LINK} label={copy.home.cta.action} href={`${home}/about`} align="left" />
  </Container>
</PortfolioLayout>
