---
import LocalLayout from '../_layouts/Layout.astro';
import Container from '@alfadormx/blocks/layout/Container.astro';
import CollectionList from '@alfadormx/blocks/composite/CollectionList.astro';
import Headline from '@alfadormx/blocks/primitives/Headline.astro';
import { collectionPages, renderList } from '@alfadormx/blocks/collections';
import { useCopy } from '@alfadormx/blocks/copy';

export const getStaticPaths = () => collectionPages('events');
const { langCode, entries, page } = await renderList(Astro);
const { copy } = useCopy(Astro, 'local');
---

<LocalLayout langCode={langCode} metadata={{ title: { default: copy.events.pageTitle } }}>
  <Container>
    <Headline title={copy.events.title} htmlTag="h1" />
    <CollectionList entries={entries} page={page} langCode={langCode} />
  </Container>
</LocalLayout>
