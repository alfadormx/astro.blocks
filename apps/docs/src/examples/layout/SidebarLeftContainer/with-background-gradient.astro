---
import SidebarLeftContainer from '@alfadormx/blocks/layout/SidebarLeftContainer.astro';
import Button from '@alfadormx/blocks/primitives/Button.astro';
import Headline from '@alfadormx/blocks/primitives/Headline.astro';
---

<SidebarLeftContainer
  htmlTag="section"
  containerWidthType="full"
  background={{ class: 'bg-linear-to-r from-tertiary to-accent' }}
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-12' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  spacing={{ margin: 'mb-8' }}
>
  <div slot="sidebar" class="bg-surface/90 backdrop-blur p-6 rounded shadow-lg">
    <p class="font-semibold">Quick Links</p>
    <ul>
      <li>
        <a href="#" class="text-link hover:underline">
          Getting Started
        </a>
      </li>
      <li>
        <a href="#" class="text-link hover:underline">
          Documentation
        </a>
      </li>
      <li>
        <a href="#" class="text-link hover:underline">
          API Reference
        </a>
      </li>
      <li>
        <a href="#" class="text-link hover:underline">
          Support
        </a>
      </li>
    </ul>
  </div>
  <div slot="main" class="bg-surface/90 backdrop-blur p-6 rounded shadow-lg">
    <Headline
      title="Welcome to Our Platform"
      htmlTag="h4"
      class="my-0"
      titleClass="mb-4 text-2xl"
    />
    <p class="mb-4">
      Discover powerful features designed to streamline your workflow and boost productivity.
    </p>
    <p class="mb-4">
      Our intuitive interface makes it easy to get started, while advanced features give you the
      flexibility you need as you grow.
    </p>
    <Button label="Get Started" intent="tertiary" />
  </div>
</SidebarLeftContainer>
