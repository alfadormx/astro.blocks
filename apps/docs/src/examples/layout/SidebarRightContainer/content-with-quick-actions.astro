---
import SidebarRightContainer from '@alfadormx/blocks/layout/SidebarRightContainer.astro';
import Button from '@alfadormx/blocks/primitives/Button.astro';
import Headline from '@alfadormx/blocks/primitives/Headline.astro';
---

<SidebarRightContainer
  htmlTag="section"
  containerWidthType="full"
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-12' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  spacing={{ margin: 'mb-8' }}
>
  <div slot="main" class="bg-surface p-6 rounded border border-border">
    <Headline title="Project Details" htmlTag="h4" class="my-0" titleClass="mb-4 text-2xl" />
    <p>
      This is a comprehensive overview of the current project status, including milestones,
      deliverables, and team assignments.
    </p>
    <div class="grid grid-cols-3 gap-4 mt-6">
      <div class="bg-primary text-background p-4 rounded">
        <div class="text-2xl font-bold">8</div>
        <div class="text-sm">Tasks Completed</div>
      </div>
      <div class="bg-warning text-background p-4 rounded">
        <div class="text-2xl font-bold">5</div>
        <div class="text-sm">In Progress</div>
      </div>
      <div class="bg-tertiary text-background p-4 rounded">
        <div class="text-2xl font-bold">12</div>
        <div class="text-sm">Pending</div>
      </div>
    </div>
  </div>
  <div slot="sidebar" class="bg-surface border border-border p-6 rounded">
    <Headline title="Actions" htmlTag="h4" class="my-0" titleClass="mb-4 text-lg" />
    <nav class="space-y-2">
      <Button label="Edit Project" variant="ghost" width="full" class="justify-start" />
      <Button label="Add Task" variant="ghost" width="full" class="justify-start" />
      <Button label="Assign Team" variant="ghost" width="full" class="justify-start" />
      <Button label="Export Report" variant="ghost" width="full" class="justify-start" />
    </nav>
  </div>
</SidebarRightContainer>
