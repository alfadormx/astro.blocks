---
import SidebarRightContainer from '@alfadormx/blocks/layout/SidebarRightContainer.astro';
import Button from '@alfadormx/blocks/primitives/Button.astro';
import Headline from '@alfadormx/blocks/primitives/Headline.astro';
---

<SidebarRightContainer
  htmlTag="section"
  containerWidthType="full"
  background={{ class: 'bg-linear-to-r from-info to-primary' }}
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-12' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  spacing={{ margin: 'mb-8' }}
>
  <div slot="main" class="bg-surface/90 backdrop-blur p-6 rounded shadow-lg">
    <Headline title="Premium Features" htmlTag="h4" class="my-0" titleClass="mb-4 text-2xl" />
    <p>
      Unlock advanced capabilities designed for power users and teams. Get access to exclusive
      features that streamline your workflow.
    </p>
    <ul>
      <li>✓ Advanced analytics and reporting</li>
      <li>✓ Priority customer support</li>
      <li>✓ Custom integrations</li>
      <li>✓ Team collaboration tools</li>
    </ul>
    <Button label="Upgrade Now" intent="secondary" />
  </div>
  <div slot="sidebar" class="bg-surface/90 backdrop-blur p-6 rounded shadow-lg">
    <Headline title="Pricing" htmlTag="h4" class="my-0" titleClass="mb-4 text-lg" />
    <div class="text-center mb-4">
      <div class="text-3xl font-bold text-info">$49</div>
      <div class="text-sm text-muted">per month</div>
    </div>
    <ul class="space-y-2 text-sm">
      <li>
        <a href="#" class="text-muted hover:underline">
          Compare Plans
        </a>
      </li>
      <li>
        <a href="#" class="text-muted hover:underline">
          FAQ
        </a>
      </li>
      <li>
        <a href="#" class="text-muted hover:underline">
          Contact Sales
        </a>
      </li>
    </ul>
  </div>
</SidebarRightContainer>
