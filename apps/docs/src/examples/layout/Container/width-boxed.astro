---
import Container from '@alfadormx/blocks/layout/Container.astro';
---

<Container
  containerWidthType="boxed"
  content={{ border: { width: 'border', color: 'border-border-emphasis border-dotted' } }}
  border={{ width: 'border', color: 'border-border' }}
