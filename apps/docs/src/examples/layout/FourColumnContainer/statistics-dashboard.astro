---
import FourColumnContainer from '@alfadormx/blocks/layout/FourColumnContainer.astro';
---

<FourColumnContainer
  containerWidthType="full"
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-12' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  gap="normal"
  spacing={{ margin: 'mb-8' }}
>
  <div slot="left" class="bg-primary/10 p-6 rounded-lg border-2 border-primary/30">
    <div class="text-3xl font-bold text-primary mb-2">1.2M</div>
    <p class="text-normal">Active Users</p>
  </div>
  <div slot="centerLeft" class="bg-success/10 p-6 rounded-lg border-2 border-success/30">
    <div class="text-3xl font-bold text-success mb-2">98%</div>
    <p class="text-normal">Satisfaction Rate</p>
  </div>
  <div slot="centerRight" class="bg-secondary/10 p-6 rounded-lg border-2 border-secondary/30">
    <div class="text-3xl font-bold text-secondary mb-2">24/7</div>
    <p class="text-normal">Support Available</p>
  </div>
  <div slot="right" class="bg-accent/10 p-6 rounded-lg border-2 border-accent/30">
    <div class="text-3xl font-bold text-accent mb-2">150+</div>
    <p class="text-normal">Countries</p>
  </div>
</FourColumnContainer>
