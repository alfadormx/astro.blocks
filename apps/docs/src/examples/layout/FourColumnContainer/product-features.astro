---
import FourColumnContainer from '@alfadormx/blocks/layout/FourColumnContainer.astro';
---

<FourColumnContainer
  containerWidthType="full"
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-12' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  gap="loose"
  spacing={{ margin: 'mb-8' }}
>
  <div slot="left">
    <div class="bg-linear-to-br from-primary to-primary-hover w-16 h-16 rounded-lg mb-4 flex items-center justify-center text-background text-2xl">
      📱
    </div>
    <p class="font-semibold">Mobile First</p>
    <p class="text-sm text-normal">Optimized for all mobile devices with responsive design.</p>
  </div>
  <div slot="centerLeft">
    <div class="bg-linear-to-br from-success to-success-hover w-16 h-16 rounded-lg mb-4 flex items-center justify-center text-background text-2xl">
      ⚡
    </div>
    <p class="font-semibold">Lightning Fast</p>
    <p class="text-sm text-normal">Blazing fast performance with optimized code.</p>
  </div>
  <div slot="centerRight">
    <div class="bg-linear-to-br from-secondary to-secondary-hover w-16 h-16 rounded-lg mb-4 flex items-center justify-center text-background text-2xl">
      🎨
    </div>
    <p class="font-semibold">Customizable</p>
    <p class="text-sm text-normal">Fully customizable with Tailwind CSS utilities.</p>
  </div>
  <div slot="right">
    <div class="bg-linear-to-br from-accent to-accent-hover w-16 h-16 rounded-lg mb-4 flex items-center justify-center text-background text-2xl">
      🔧
    </div>
    <p class="font-semibold">Easy Setup</p>
    <p class="text-sm text-normal">Get started in minutes with simple configuration.</p>
  </div>
</FourColumnContainer>
