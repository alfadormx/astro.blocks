---
import FourColumnContainer from '@alfadormx/blocks/layout/FourColumnContainer.astro';
import Image from '@alfadormx/blocks/primitives/Image.astro';
---

<FourColumnContainer
  containerWidthType="full"
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-8' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  gap="tight"
  spacing={{ margin: 'mb-8' }}
>
  <div slot="left">
    <Image
      src="~/assets/images/content/code-on-laptop.jpg"
      alt="Code on a laptop screen"
      width={400}
      height={192}
      class="w-full h-48 object-cover rounded"
    />
  </div>
  <div slot="centerLeft">
    <Image
      src="~/assets/images/content/conference-audience.jpg"
      alt="Audience at a conference talk"
      width={400}
      height={192}
      class="w-full h-48 object-cover rounded"
    />
  </div>
  <div slot="centerRight">
    <Image
      src="~/assets/images/content/dictionary-page.jpg"
      alt="Open dictionary page"
      width={400}
      height={192}
      class="w-full h-48 object-cover rounded"
    />
  </div>
  <div slot="right">
    <Image
      src="~/assets/images/content/writing-notebook.jpg"
      alt="Hand writing in a notebook"
      width={400}
      height={192}
      class="w-full h-48 object-cover rounded"
    />
  </div>
</FourColumnContainer>
