---
import TwoColumnContainer from '@alfadormx/blocks/layout/TwoColumnContainer.astro';
import Headline from '@alfadormx/blocks/primitives/Headline.astro';
---

<TwoColumnContainer
  containerWidthType="full"
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-8' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  spacing={{ margin: 'mb-8' }}
>
  <div slot="left" class="space-y-4">
    <Headline title="Free Plan" htmlTag="h4" class="my-0" titleClass="mb-4 text-xl" />
    <div class="flex items-start gap-2">
      <span class="text-success">✓</span>
      <span>Basic features</span>
    </div>
    <div class="flex items-start gap-2">
      <span class="text-success">✓</span>
      <span>Up to 5 users</span>
    </div>
    <div class="flex items-start gap-2">
      <span class="text-error">✗</span>
      <span>Advanced analytics</span>
    </div>
    <div class="flex items-start gap-2">
      <span class="text-error">✗</span>
      <span>Priority support</span>
    </div>
  </div>
  <div slot="right" class="space-y-4">
    <Headline title="Pro Plan" htmlTag="h4" class="my-0" titleClass="mb-4 text-xl" />
    <div class="flex items-start gap-2">
      <span class="text-success">✓</span>
      <span>All features</span>
    </div>
    <div class="flex items-start gap-2">
      <span class="text-success">✓</span>
      <span>Unlimited users</span>
    </div>
    <div class="flex items-start gap-2">
      <span class="text-success">✓</span>
      <span>Advanced analytics</span>
    </div>
    <div class="flex items-start gap-2">
      <span class="text-success">✓</span>
      <span>Priority support</span>
    </div>
  </div>
</TwoColumnContainer>
