---
import TwoColumnContainer from '@alfadormx/blocks/layout/TwoColumnContainer.astro';
---

<TwoColumnContainer
  containerWidthType="full"
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-8' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  responsive={true}
  spacing={{ margin: 'mb-8' }}
>
  <div slot="left" class="bg-accent text-background p-6 rounded">
    <p class="font-semibold">Column 1</p>
    <p>This layout stacks vertically on mobile, side-by-side on desktop.</p>
  </div>
  <div slot="right" class="bg-error text-background p-6 rounded">
    <p class="font-semibold">Column 2</p>
    <p>Set responsive=true for mobile-friendly layouts.</p>
  </div>
</TwoColumnContainer>
