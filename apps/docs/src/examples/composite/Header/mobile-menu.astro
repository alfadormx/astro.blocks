---
import HeaderBlock from '@alfadormx/blocks/composite/Header.astro';
import ModalBlock from '@alfadormx/blocks/layout/Modal.astro';
import NavigationTree from '@alfadormx/blocks/composite/NavigationTree.astro';
import type { NavigationTreeItem } from '@alfadormx/blocks/types/navigationtree';

const navItems: NavigationTreeItem[] = [
  { label: 'Home', href: '/' },
  {
    label: 'Products',
    children: [
      { label: 'Product 1', href: '/products/1' },
      { label: 'Product 2', href: '/products/2' },
      { label: 'Product 3', href: '/products/3' },
    ],
  },
  {
    label: 'Services',
    children: [
      { label: 'Consulting', href: '/services/consulting' },
      { label: 'Development', href: '/services/development' },
      { label: 'Design', href: '/services/design' },
    ],
  },
];
---

<HeaderBlock
  logo={{
    image: {
      src: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=200&h=200&fit=crop',
      alt: 'Logo',
      width: 48,
      height: 48,
    },
  }}
  leftButtons={[
    {
      'data-modal-trigger': 'mobile-menu-basic',
      icon: { name: 'heroicons:bars-3' },
      variant: 'ghost',
      intent: 'neutral',
      class: 'lg:hidden',
    },
  ]}
/>

<ModalBlock id="mobile-menu-basic" position="left" size="sm">
  <div class="p-4">
    <p class="font-semibold">Menu</p>
    <NavigationTree items={navItems} />
  </div>
</ModalBlock>
