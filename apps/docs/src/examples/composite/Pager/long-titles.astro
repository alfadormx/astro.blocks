---
import PagerBlock from '@alfadormx/blocks/composite/Pager.astro';

const prev = { href: '/documentation/composite/NavigationTreeHorizontal' };
const next = { href: '/documentation/composite/PostCard' };
---

<PagerBlock
  prevButton={{
    ...prev,
    subtitle: 'A horizontal navigation bar with dropdown groups for the main site sections',
  }}
  nextButton={{
    ...next,
    subtitle: 'A blog post card with its cover, date, reading time, excerpt and every tag',
  }}
/>
