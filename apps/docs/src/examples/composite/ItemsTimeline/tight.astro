    },
    {
      icon: { name: 'heroicons:cog-6-tooth', class: 'text-accent' },
      title: 'Setup Profile',
      content: 'Customize your profile and preferences.',
    },
    {
      icon: { name: 'heroicons:rocket-launch', class: 'text-success' },
      title: 'Get Started',
      content: 'Start using all features immediately.',
    },
  ]}
/>
