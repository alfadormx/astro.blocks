---
import Item from '@alfadormx/blocks/composite/Item.astro';
---

<div class="flex flex-wrap items-start gap-6">
  <div class="max-w-xs">
    <Item icon={{ name: 'heroicons:swatch', class: 'text-primary' }} title="Title Only" />
  </div>
  <div class="max-w-xs">
    <Item
      icon={{ name: 'heroicons:eye', class: 'text-secondary' }}
      content="Content without a title."
    />
  </div>
  <div class="max-w-xs">
    <Item icon={{ name: 'heroicons:sparkles', class: 'text-accent' }} />
  </div>
</div>
