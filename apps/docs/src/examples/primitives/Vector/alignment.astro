---
import Vector from '@alfadormx/blocks/primitives/Vector.astro';

const demoSvg = 'https://www.svgrepo.com/show/513167/basketball.svg';
---

<div class="space-y-4">
  <div class="text-primary">
    <Vector
      src={demoSvg}
      layout="fixed"
      width={100}
      height={100}
      align="left"
      ariaLabel="Left aligned"
    />
  </div>
  <div class="text-secondary">
    <Vector
      src={demoSvg}
      layout="fixed"
      width={100}
      height={100}
      align="center"
      ariaLabel="Center aligned"
    />
  </div>
  <div class="text-accent">
    <Vector
      src={demoSvg}
      layout="fixed"
      width={100}
      height={100}
      align="right"
      ariaLabel="Right aligned"
    />
  </div>
</div>
