---
import Vector from '@alfadormx/blocks/primitives/Vector.astro';

const demoSvg = 'https://www.svgrepo.com/show/513167/basketball.svg';
---

<div class="flex gap-6">
  <div class="w-32 text-primary">
    <Vector src={demoSvg} class="opacity-50" ariaLabel="Semi-transparent" />
  </div>
  <div class="w-32 text-secondary">
    <Vector src={demoSvg} class="rotate-45" ariaLabel="Rotated 45 degrees" />
  </div>
  <div class="w-32 text-accent">
    <Vector
      src={demoSvg}
      class="scale-110 hover:scale-125 transition-transform"
      ariaLabel="Scalable"
    />
  </div>
</div>
