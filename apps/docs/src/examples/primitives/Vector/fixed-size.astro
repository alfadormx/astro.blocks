---
import Vector from '@alfadormx/blocks/primitives/Vector.astro';

const demoSvg = 'https://www.svgrepo.com/show/513167/basketball.svg';
---

<div class="flex gap-6 items-center">
  <div class="text-primary">
    <Vector src={demoSvg} layout="fixed" width={128} height={128} ariaLabel="Large compass" />
  </div>
  <div class="text-secondary">
    <Vector src={demoSvg} layout="fixed" width={64} height={64} ariaLabel="Medium compass" />
  </div>
  <div class="text-accent">
    <Vector src={demoSvg} layout="fixed" width={32} height={32} ariaLabel="Small compass" />
  </div>
</div>
