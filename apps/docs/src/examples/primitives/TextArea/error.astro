---
import TextArea from '@alfadormx/blocks/primitives/TextArea.astro';
---

<div class="flex flex-col gap-4 max-w-md">
  <TextArea
    label="Engraving text"
    value="Hello 👋"
    maxLength={40}
    showCounter
    rows={2}
    help="Letters, digits and basic punctuation."
    error="Emoji cannot be engraved."
  />
</div>
