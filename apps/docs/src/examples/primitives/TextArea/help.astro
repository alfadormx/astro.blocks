---
import TextArea from '@alfadormx/blocks/primitives/TextArea.astro';
---

<div class="flex flex-col gap-4 max-w-md">
  <TextArea
    label="Delivery notes"
    placeholder="Gate code, floor, preferred time"
    help="Visible to the courier only."
  />
  <TextArea label="Comment" hideLabel placeholder="Comment (label hidden)" />
</div>
