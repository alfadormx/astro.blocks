---
import LanguageToggle from '@alfadormx/blocks/primitives/LanguageToggle.astro';
---

<div class="flex flex-col gap-6">
  <div>
    <p class="text-sm text-muted mb-2">Large pills with accent colors</p>
    <LanguageToggle
      preservePath={false}
      defaultButtonConfig={{ size: 'lg', variant: 'solid', shape: 'pill' }}
      activeButtonConfig={{ intent: 'accent' }}
      inactiveButtonConfig={{ intent: 'secondary' }}
      gap="normal"
    />
  </div>
  <div>
    <p class="text-sm text-muted mb-2">Small outline vertical stack</p>
    <LanguageToggle
      preservePath={false}
      defaultButtonConfig={{ size: 'sm', variant: 'outline' }}
      activeButtonConfig={{ intent: 'primary' }}
      inactiveButtonConfig={{ intent: 'neutral' }}
      orientation="vertical"
      gap="tight"
    />
  </div>
  <div>
    <p class="text-sm text-muted mb-2">Link style with codes only</p>
    <LanguageToggle
      preservePath={false}
      defaultButtonConfig={{ variant: 'link', size: 'lg' }}
      labelFormat="code"
      gap="loose"
    />
  </div>
</div>
