---
import Select from '@alfadormx/blocks/primitives/Select.astro';

const countries = [
  { value: 'nl', label: 'Netherlands' },
  { value: 'be', label: 'Belgium' },
  { value: 'de', label: 'Germany' },
  { value: 'fr', label: 'France' },
];
---

<div class="flex flex-col gap-4 max-w-md">
  <Select label="Delivery country" options={countries} help="We ship to these countries only." />
  <Select label="Language" hideLabel options={countries} />
</div>
