---
import Headline from '@alfadormx/blocks/primitives/Headline.astro';
---

<Headline
  tagline="PREMIUM"
  title="Customized Design"
  subtitle="Override default styles with your own classes for complete control."
  taglineClass="text-xs font-bold uppercase tracking-widest text-primary"
  titleClass="text-5xl md:text-6xl font-extrabold text-transparent bg-clip-text bg-linear-to-r from-primary to-accent"
  subtitleClass="text-xl mt-6 max-w-2xl"
  align="center"
/>
