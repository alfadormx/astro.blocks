---
import Headline from '@alfadormx/blocks/primitives/Headline.astro';
---

<div data-theme="dark" class="rounded-lg bg-base p-8">
  <Headline
    tagline="INNOVATION"
    title="Built for the Future"
    subtitle="Next-generation tools for next-generation developers."
    taglineClass="text-sm font-semibold uppercase tracking-wider text-peach"
    titleClass="text-4xl md:text-5xl font-bold text-text mt-2"
    subtitleClass="text-lg text-subtext1 mt-4 max-w-3xl"
    align="center"
  />
</div>
