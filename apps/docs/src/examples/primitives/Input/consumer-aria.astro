---
import Input from '@alfadormx/blocks/primitives/Input.astro';
---

<div class="flex flex-col gap-4 max-w-md">
  <Input id="doc-input-aria-valid" label="Valid" aria-invalid="false" />
  <Input id="doc-input-aria-error" label="With error" aria-invalid="false" error="Required." />
  <Input
    id="doc-input-aria-dup"
    label="Duplicate reference"
    help="Shown once."
    aria-describedby="doc-input-aria-dup-help doc-input-aria-note"
  />
  <p id="doc-input-aria-note">External note.</p>
</div>
