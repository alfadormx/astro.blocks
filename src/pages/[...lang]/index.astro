---
import type { GetStaticPaths } from 'astro';
import { I18N, SITE } from 'site-config';
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/blocks/composite/Header.astro';
import Footer from '~/components/blocks/composite/Footer.astro';
import CallToAction from '~/components/blocks/composite/CallToAction.astro';
import ItemsContent from '~/components/blocks/composite/ItemsContent.astro';
import { homeCopy } from '~/data/home';

type Language = (typeof I18N.languages)[number];

export const getStaticPaths = (() =>
  I18N.languages
    .filter((lang: Language) => homeCopy[lang.code])
    .map((lang: Language) => ({
      params: { lang: lang.basePath === '/' ? undefined : lang.basePath.replace(/^\//, '') },
      props: { langCode: lang.code, basePath: lang.basePath },
    }))) satisfies GetStaticPaths;

type Props = { langCode: string; basePath: string };

const { langCode, basePath } = Astro.props;
const copy = homeCopy[langCode];

const metadata = {
  title: { default: copy.pageTitle },
  canonical: `${SITE.site}${basePath === '/' ? '' : basePath}`,
};
---

<Layout langCode={langCode} metadata={metadata}>
  <Header
    themeToggle={{}}
    rightButtons={[
      {
        label: copy.headerDocsLabel,
        href: '/documentation',
        intent: 'primary',
        variant: 'solid',
        size: 'sm',
        shape: 'pill',
      },
    ]}
  />

  <CallToAction
    headline={{
      tagline: copy.hero.tagline,
      title: copy.hero.title,
      htmlTag: 'h1',
      subtitle: copy.hero.subtitle,
      align: 'center',
    }}
    actions={[
      {
        label: copy.hero.browseDocsLabel,
        href: '/documentation',
        intent: 'primary',
        variant: 'solid',
        size: 'lg',
        shape: 'pill',
        icon: { name: 'heroicons:arrow-right' },
        iconPosition: 'right',
      },
      {
        label: copy.hero.viewSourceLabel,
        href: 'https://github.com/alfadormx/astro.blocks',
        intent: 'secondary',
        variant: 'outline',
        size: 'lg',
        shape: 'pill',
        icon: { name: 'heroicons:code-bracket' },
        target: '_blank',
      },
    ]}
  />

  <ItemsContent
    headline={{
      tagline: copy.inside.tagline,
      title: copy.inside.title,
      subtitle: copy.inside.subtitle,
      align: 'center',
    }}
    itemsGrid={{
      columns: 3,
      gap: 'tight',
      items: [
        {
          icon: { name: 'heroicons:squares-2x2' },
          title: copy.inside.primitives.title,
          content: copy.inside.primitives.content,
          orientation: 'vertical',
        },
        {
          icon: { name: 'heroicons:rectangle-stack' },
          title: copy.inside.composites.title,
          content: copy.inside.composites.content,
          orientation: 'vertical',
        },
        {
          icon: { name: 'heroicons:view-columns' },
          title: copy.inside.layout.title,
          content: copy.inside.layout.content,
          orientation: 'vertical',
        },
      ],
    }}
  />

  <CallToAction
    headline={{
      tagline: copy.getStarted.tagline,
      title: copy.getStarted.title,
      subtitle: copy.getStarted.subtitle,
      align: 'center',
    }}
    actions={[
      {
        label: copy.getStarted.openDocsLabel,
        href: '/documentation',
        intent: 'primary',
        variant: 'solid',
        size: 'lg',
        shape: 'pill',
        icon: { name: 'heroicons:book-open' },
      },
    ]}
  />

  <Footer languageToggle={{}} disclaimer={copy.footerDisclaimer} />
</Layout>
