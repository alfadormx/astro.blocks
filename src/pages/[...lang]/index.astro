---
import { I18N, SITE } from 'site-config';
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/blocks/composite/Header.astro';
import Footer from '~/components/blocks/composite/Footer.astro';
import NavigationTree from '~/components/blocks/composite/NavigationTree.astro';
import CallToAction from '~/components/blocks/composite/CallToAction.astro';
import Hero from '~/components/blocks/composite/Hero.astro';
import ItemsContent from '~/components/blocks/composite/ItemsContent.astro';
import ModalBlock from '~/components/blocks/layout/Modal.astro';
import type { ButtonProps } from '~/types/button.types';
import type { HeadlineProps } from '~/types/headline.types';
import type { ItemProps } from '~/types/item.types';
import type { NavigationTreeItem } from '~/types/navigationtree.types';
import { collectionIndex } from '../../../vendor/integration/collections/pages';
import { localizedPaths, useCopy } from '../../../vendor/integration/copy/pages';

type Language = (typeof I18N.languages)[number];

export const getStaticPaths = () => localizedPaths();

type Props = { langCode: string; basePath: string };

const { basePath } = Astro.props;
const { langCode, copy } = useCopy(Astro, 'home');
const prefix = basePath === '/' ? '' : basePath;
const SOURCE_URL = 'https://github.com/alfadormx/astro.blocks';

const language = I18N.languages.find((lang: Language) => lang.code === langCode);
if (!language) {
  throw new Error(`No i18n language configured for "${langCode}"`);
}
const listFormat = new Intl.ListFormat(language.locale, { type: 'conjunction' });

const docs = await collectionIndex('documentation', I18N.default);
const titlesIn = (section: string) =>
  docs.filter((e) => e.data.section === section).map((e) => e.data.title);

/** Soft glows in the palette's own hues, laid over the section's surface. */
const GLOW =
  'bg-[radial-gradient(ellipse_at_10%_110%,color-mix(in_oklch,var(--color-accent)_30%,transparent),transparent_55%),radial-gradient(ellipse_at_90%_110%,color-mix(in_oklch,var(--color-primary)_30%,transparent),transparent_55%),radial-gradient(ellipse_at_50%_120%,color-mix(in_oklch,var(--color-secondary)_25%,transparent),transparent_60%)]';

/** Large, light, tightly tracked section title over a muted lead. */
const SECTION_HEADLINE: HeadlineProps = {
  align: 'center',
  class: 'mt-0 mb-12 space-y-4',
  titleClass:
    'font-normal tracking-tight text-[length:clamp(2.25rem,1.6rem+2.6vw,3.75rem)] leading-[1.05] mb-0',
  subtitleClass: 'mt-5 text-lg text-muted max-w-2xl mx-auto',
};

const PILL: ButtonProps = { shape: 'pill', size: 'lg' };
const ARROW: Pick<ButtonProps, 'icon' | 'iconPosition'> = {
  icon: { name: 'heroicons:arrow-right' },
  iconPosition: 'right',
};

const CARD =
  'h-full rounded-2xl border border-border bg-background p-4 gap-5 items-start text-left';

const nav: NavigationTreeItem[] = [
  { label: copy.nav.layers, href: '#layers' },
  { label: copy.nav.demos, href: '#demos' },
  { label: copy.nav.guides, href: '#guides' },
  { label: copy.nav.github, href: SOURCE_URL, target: '_blank' },
];

const layers = [
  { section: 'primitives', copyKey: 'primitives' },
  { section: 'composite', copyKey: 'composites' },
  { section: 'layout', copyKey: 'layout' },
] as const;

const counts = Object.fromEntries(
  layers.map(({ section, copyKey }) => [copyKey, titlesIn(section).length])
) as Record<(typeof layers)[number]['copyKey'], number>;

const layerItems: ItemProps[] = layers.map(({ section, copyKey }) => ({
  title: copy.inside[copyKey].title,
  content: `**${copy.inside[copyKey].lead}:** ${listFormat.format(titlesIn(section))}.`,
  actions: [
    {
      label: copy.inside.count.replace('{count}', String(counts[copyKey])),
      href: '/documentation',
      ...ARROW,
    },
  ],
}));

const demoItems: ItemProps[] = [
  { key: 'saas', image: '~/assets/images/demos/saas/content-a.jpg' },
  { key: 'portfolio', image: '~/assets/images/demos/portfolio/hero.jpg' },
  { key: 'local', image: '~/assets/images/demos/local/hero.jpg' },
  { key: 'jewellery', image: '~/assets/images/demos/jewellery/card.jpg' },
].map(({ key, image }) => {
  const item = copy.demos[key as 'saas' | 'portfolio' | 'local' | 'jewellery'];
  return {
    title: item.title,
    content: item.content,
    image: { src: image, alt: '', width: 640, height: 400 },
    actions: [{ label: item.link, href: `${prefix}/demos/preview/${key}`, ...ARROW }],
  };
});

const stats: ItemProps[] = [
  { title: String(counts.primitives), content: copy.stats.primitives },
  { title: String(counts.composites), content: copy.stats.composites },
  { title: String(counts.layout), content: copy.stats.layout },
  { title: String(demoItems.length), content: copy.stats.demos },
];

const guideItems: ItemProps[] = docs
  .filter((e) => e.data.section === 'guides')
  .map((e) => ({
    title: e.data.title,
    content: e.data.description,
    actions: [{ label: copy.guides.read, href: e.href, ...ARROW }],
  }));

const metadata = {
  title: { default: copy.pageTitle },
  canonical: `${SITE.site}${prefix}`,
};
---

<Layout langCode={langCode} metadata={metadata}>
  <Header
    isSticky
    container={{ background: { class: 'bg-background/80 backdrop-blur' } }}
    logo={{ labelClass: 'font-title text-xl font-medium tracking-tight' }}
    leftNavigationTreeHorizontal={{
      items: nav,
      class: 'hidden lg:flex',
      defaultItemConfig: { class: 'text-sm font-normal text-muted hover:text-normal' },
    }}
    themeToggle={{ variant: 'ghost', intent: 'neutral' }}
    rightButtons={[
      {
        label: copy.headerDocsLabel,
        href: '/documentation',
        intent: 'primary',
        variant: 'solid',
        size: 'sm',
        shape: 'pill',
        ...ARROW,
      },
      {
        'data-modal-trigger': 'home-menu',
        'aria-label': copy.nav.menuLabel,
        icon: { name: 'heroicons:bars-3' },
        class: 'lg:hidden',
      },
    ]}
  />
  <ModalBlock id="home-menu" position="right" size="sm" class="p-6 pt-16">
    <NavigationTree items={nav} />
  </ModalBlock>

  <Hero
    container={{
      class: GLOW,
      minHeight: 'min-h-[max(36rem,85svh)]',
      content: { class: 'flex flex-col justify-center' },
    }}
    headline={{
      title: copy.hero.title,
      subtitle: copy.hero.subtitle,
      align: 'center',
      titleClass:
        'font-normal tracking-tighter text-[length:clamp(2.75rem,1.6rem+4.6vw,5.25rem)] leading-[1.02] max-w-4xl mx-auto mb-0',
      subtitleClass: 'mt-6 text-lg md:text-xl text-muted max-w-2xl mx-auto',
    }}
    defaultActionConfig={PILL}
    actions={[
      {
        label: copy.hero.browseDocsLabel,
        href: '/documentation',
        intent: 'primary',
        variant: 'solid',
        ...ARROW,
      },
      {
        label: copy.hero.viewSourceLabel,
        href: SOURCE_URL,
        intent: 'neutral',
        variant: 'outline',
        icon: { name: 'heroicons:code-bracket' },
        target: '_blank',
      },
    ]}
  />

  <ItemsContent
    container={{ class: 'bg-surface' }}
    headline={{ ...SECTION_HEADLINE, title: copy.stats.title, subtitle: copy.stats.subtitle }}
    itemsGrid={{
      columns: 4,
      gap: 'normal',
      items: stats,
      defaultItemConfig: {
        orientation: 'vertical',
        titleClass:
          'font-title font-light tracking-tighter text-[length:clamp(3rem,2.2rem+3vw,4.5rem)] leading-none mb-2',
        textClass: 'text-sm text-muted mb-0',
      },
    }}
  />

  <ItemsContent
    headline={{
      ...SECTION_HEADLINE,
      title: copy.demos.title,
      subtitle: copy.demos.subtitle,
      anchorId: 'demos',
    }}
    itemsGrid={{
      columns: 4,
      gap: 'tight',
      items: demoItems,
      defaultItemConfig: {
        orientation: 'vertical',
        class: CARD,
        contentClass: 'items-start text-left flex-1 px-1 pb-1',
        mediaClass: 'w-full aspect-16/10 object-cover rounded-xl',
        titleClass: 'font-title text-lg font-medium mb-1',
        textClass: 'text-sm text-muted mb-0',
        actionsClass: 'mt-auto md:mt-auto pt-4',
        defaultActionConfig: { variant: 'link', intent: 'primary', size: 'sm', class: 'px-0' },
      },
    }}
  />

  <ItemsContent
    container={{ class: 'bg-surface' }}
    headline={{
      ...SECTION_HEADLINE,
      title: copy.inside.title,
      subtitle: copy.inside.subtitle,
      anchorId: 'layers',
    }}
    itemsGrid={{
      columns: 1,
      gap: 'none',
      items: layerItems,
      class: 'border-b border-border',
      defaultItemConfig: {
        orientation: 'horizontal',
        class: 'border-t border-border py-6',
        contentClass:
          'w-full gap-2 md:grid md:grid-cols-[12rem_1fr_auto] md:items-baseline md:gap-10',
        titleClass: 'font-title text-2xl font-normal tracking-tight',
        textClass: 'text-sm text-muted mb-0',
        actionsClass: 'mt-0 md:justify-end',
        defaultActionConfig: {
          variant: 'link',
          intent: 'neutral',
          size: 'sm',
          class: 'px-0 whitespace-nowrap',
        },
      },
    }}
  />

  <ItemsContent
    headline={{
      ...SECTION_HEADLINE,
      title: copy.guides.title,
      subtitle: copy.guides.subtitle,
      anchorId: 'guides',
    }}
    itemsGrid={{
      columns: 2,
      gap: 'tight',
      items: guideItems,
      defaultItemConfig: {
        orientation: 'vertical',
        class: `${CARD} p-8 bg-surface`,
        contentClass: 'items-start text-left',
        titleClass: 'font-title text-2xl font-normal tracking-tight mb-2',
        textClass: 'text-muted mb-0',
        actionsClass: 'pt-6',
        defaultActionConfig: { variant: 'link', intent: 'primary', size: 'sm', class: 'px-0' },
      },
    }}
  />

  <CallToAction
    container={{
      content: {
        boxWidth: 'w-full max-w-6xl',
        class: `rounded-3xl border border-border bg-surface shadow-none py-16 md:py-24 ${GLOW}`,
      },
    }}
    headline={{
      title: copy.getStarted.title,
      subtitle: copy.getStarted.subtitle,
      align: 'center',
      titleClass:
        'font-normal tracking-tight text-[length:clamp(2.25rem,1.6rem+2.6vw,3.75rem)] leading-[1.05] mb-0',
      subtitleClass: 'mt-5 text-lg text-muted',
    }}
    actions={[
      {
        label: copy.getStarted.openDocsLabel,
        href: '/documentation',
        intent: 'primary',
        variant: 'solid',
        ...PILL,
        ...ARROW,
      },
    ]}
  />

  <Footer
    container={{ class: 'border-t border-border', spacing: { padding: 'px-4 md:px-6 lg:px-8' } }}
    logo={{ labelClass: 'font-title text-xl font-medium tracking-tight' }}
    disclaimer={copy.footerDisclaimer}
    disclaimerClass="text-sm text-muted"
    socialButtons={[
      { 'aria-label': copy.nav.github, icon: { name: 'tabler:brand-github' }, href: SOURCE_URL },
    ]}
    languageToggle={{}}
  />
</Layout>
