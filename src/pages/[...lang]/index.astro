---
import { I18N, SITE } from 'site-config';
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/blocks/composite/Header.astro';
import Footer from '~/components/blocks/composite/Footer.astro';
import CallToAction from '~/components/blocks/composite/CallToAction.astro';
import Hero from '~/components/blocks/composite/Hero.astro';
import ItemsContent from '~/components/blocks/composite/ItemsContent.astro';
import { documentationNavigation } from '~/data/documentationNavigation';
import { getGroupChildLabels } from '~/utils/navigationGroups';
import { localizedPaths, useCopy } from '../../../vendor/integration/copy/pages';

type Language = (typeof I18N.languages)[number];

export const getStaticPaths = () => localizedPaths();

type Props = { langCode: string; basePath: string };

const { basePath } = Astro.props;
const { langCode, copy } = useCopy(Astro, 'home');

const language = I18N.languages.find((lang: Language) => lang.code === langCode);
if (!language) {
  throw new Error(`No i18n language configured for "${langCode}"`);
}
const listFormat = new Intl.ListFormat(language.locale, { type: 'conjunction' });

const layers = [
  { group: 'Primitives', icon: 'heroicons:squares-2x2', copyKey: 'primitives' },
  { group: 'Composite', icon: 'heroicons:rectangle-stack', copyKey: 'composites' },
  { group: 'Layout', icon: 'heroicons:view-columns', copyKey: 'layout' },
] as const;

const layerItems = layers.map(({ group, icon, copyKey }) => ({
  icon: { name: icon },
  title: copy.inside[copyKey].title,
  content: `**${copy.inside[copyKey].lead}:** ${listFormat.format(
    getGroupChildLabels(documentationNavigation, group)
  )}.`,
  orientation: 'vertical' as const,
}));

const metadata = {
  title: { default: copy.pageTitle },
  canonical: `${SITE.site}${basePath === '/' ? '' : basePath}`,
};
---

<Layout langCode={langCode} metadata={metadata}>
  <Header
    themeToggle={{}}
    rightButtons={[
      {
        label: copy.headerDocsLabel,
        href: '/documentation',
        intent: 'primary',
        variant: 'solid',
        size: 'sm',
        shape: 'pill',
      },
    ]}
  />

  <Hero
    headline={{
      tagline: copy.hero.tagline,
      title: copy.hero.title,
      subtitle: copy.hero.subtitle,
    }}
    actions={[
      {
        label: copy.hero.browseDocsLabel,
        href: '/documentation',
        intent: 'primary',
        variant: 'solid',
        size: 'lg',
        shape: 'pill',
        icon: { name: 'heroicons:arrow-right' },
        iconPosition: 'right',
      },
      {
        label: copy.hero.viewSourceLabel,
        href: 'https://github.com/alfadormx/astro.blocks',
        intent: 'secondary',
        variant: 'outline',
        size: 'lg',
        shape: 'pill',
        icon: { name: 'heroicons:code-bracket' },
        target: '_blank',
      },
    ]}
  />

  <ItemsContent
    headline={{
      tagline: copy.inside.tagline,
      title: copy.inside.title,
      subtitle: copy.inside.subtitle,
      align: 'center',
    }}
    itemsGrid={{
      columns: 3,
      gap: 'tight',
      items: layerItems,
    }}
  />

  <CallToAction
    headline={{
      tagline: copy.getStarted.tagline,
      title: copy.getStarted.title,
      subtitle: copy.getStarted.subtitle,
      align: 'center',
    }}
    actions={[
      {
        label: copy.getStarted.openDocsLabel,
        href: '/documentation',
        intent: 'primary',
        variant: 'solid',
        size: 'lg',
        shape: 'pill',
        icon: { name: 'heroicons:book-open' },
      },
    ]}
  />

  <Footer languageToggle={{}} disclaimer={copy.footerDisclaimer} />
</Layout>
