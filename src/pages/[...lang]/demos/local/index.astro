---
import LocalLayout from './_layouts/Layout.astro';
import Hero from '~/components/blocks/composite/Hero.astro';
import ItemsContent from '~/components/blocks/composite/ItemsContent.astro';
import ItemsGrid from '~/components/blocks/composite/ItemsGrid.astro';
import Item from '~/components/blocks/composite/Item.astro';
import Content from '~/components/blocks/composite/Content.astro';
import CollectionList from '~/components/blocks/composite/CollectionList.astro';
import Testimonials from '~/components/blocks/composite/Testimonials.astro';
import CallToAction from '~/components/blocks/composite/CallToAction.astro';
import ContactForm from '~/components/blocks/composite/ContactForm.astro';
import Container from '~/components/blocks/layout/Container.astro';
import TwoColumnContainer from '~/components/blocks/layout/TwoColumnContainer.astro';
import Accordion from '~/components/blocks/primitives/Accordion.astro';
import Button from '~/components/blocks/primitives/Button.astro';
import Headline from '~/components/blocks/primitives/Headline.astro';
import Image from '~/components/blocks/primitives/Image.astro';
import MapBlock from '~/components/blocks/primitives/Map.astro';
import Vector from '~/components/blocks/primitives/Vector.astro';
import type { ButtonProps } from '~/types/button.types';
import type { ImageProps } from '~/types/image.types';
import type { ItemProps } from '~/types/item.types';
import type { Testimonial } from '~/types/testimonials.types';
import { renderRichText } from '~/utils/richText';
import { collectionUrl, getFeatured } from '#blocks/collections';
import { localizedPaths, useCopy } from '#blocks/copy';
import {
  CARD,
  CONTACT_ADDRESS,
  EVENT_CARD,
  GEO,
  ON_DARK,
  PHONE,
  PILL,
  RIDGE,
  SECTION_HEADLINE,
  TAGLINE,
  directionsUrl,
  localBusinessJsonLd,
  localHome,
} from './_site';

export const getStaticPaths = () => localizedPaths();

type Props = { langCode: string; basePath: string };

const { langCode, copy } = useCopy(Astro, 'local');
const { home: c, business } = copy;
const homeUrl = localHome(langCode);

const metadata = {
  title: { default: c.pageTitle },
  description: c.description,
  structuredData: localBusinessJsonLd(business, new URL(homeUrl, Astro.site ?? Astro.url).href),
};

const SERVICE_ICONS: Record<keyof typeof c.services.items, string> = {
  bread: 'lucide:wheat',
  pastries: 'lucide:croissant',
  coffee: 'lucide:coffee',
  breakfast: 'lucide:egg-fried',
};

const services: ItemProps[] = Object.entries(c.services.items).map(([key, item]) => ({
  icon: { name: SERVICE_ICONS[key as keyof typeof SERVICE_ICONS] },
  title: item.title,
  content: item.content,
}));

const GALLERY = {
  bread: 'service-bread',
  pastries: 'service-pastries',
  tasting: 'event-tasting',
  coffee: 'service-coffee',
  breakfast: 'service-breakfast',
} as const;

const gallery: ImageProps[] = Object.entries(c.gallery.images).map(([key, alt], i) => ({
  src: `~/assets/images/demos/local/${GALLERY[key as keyof typeof GALLERY]}.jpg`,
  alt,
  layout: 'responsive',
  aspectRatio: 4 / 3,
  widths: i === 0 ? [600, 1200] : [400, 800],
  sizes: i === 0 ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 768px) 25vw, 50vw',
  class: 'w-full rounded-2xl object-cover',
}));

const [lead, ...rest] = gallery;

const upcoming = await getFeatured('events', 3, langCode);

const testimonials: Testimonial[] = Object.values(c.reviews.items).map((review) => ({
  quote: review.quote,
  author: { name: review.name },
  rating: review.rating as Testimonial['rating'],
  source: { label: c.reviews.sourceLabel, href: 'https://example.com/reviews' },
}));

const hours: ItemProps[] = Object.values(c.visit.days).map(({ day, hours: time }) => ({
  title: day,
  content: time,
}));

const chip: Partial<ButtonProps> = {
  variant: 'outline',
  intent: 'neutral',
  shape: 'pill',
  size: 'xs',
  class: `border border-background/30 bg-transparent ${ON_DARK} hover:bg-background/10 dark:border-normal/30`,
};
---

<LocalLayout langCode={langCode} metadata={metadata}>
  <Hero
    container={{
      background: {
        image: '~/assets/images/demos/local/hero.jpg',
        overlayClass: 'bg-linear-to-r from-tertiary via-tertiary/85 to-tertiary/40',
      },
      class: 'bg-tertiary',
      minHeight: 'min-h-[88vh]',
      spacing: { padding: 'pb-24 md:pb-32' },
    }}
    headline={{
      tagline: c.hero.tagline,
      title: c.hero.title,
      subtitle: c.hero.subtitle,
      align: 'left',
      class: 'max-w-2xl mb-8 space-y-4',
      taglineClass: `${TAGLINE} text-accent before:hidden`,
      titleClass: `text-5xl md:text-7xl font-bold leading-[1.05] tracking-tight ${ON_DARK}`,
      subtitleClass: `text-lg ${ON_DARK} opacity-90`,
    }}
    actionsClass="flex-row flex-wrap items-center justify-start gap-3"
    actions={[
      { ...PILL, label: c.hero.primary, href: `${homeUrl}#services`, size: 'lg' },
      {
        label: c.hero.secondary,
        href: `${homeUrl}#visit`,
        variant: 'outline',
        intent: 'neutral',
        shape: 'pill',
        size: 'lg',
        class: `border-2 border-background/40 bg-transparent ${ON_DARK} hover:bg-background/10 dark:border-normal/40`,
      },
      {
        ...chip,
        label: c.hero.chips.rating,
        href: `${homeUrl}#reviews`,
        icon: { name: 'heroicons:star-solid' },
      },
      { ...chip, label: c.hero.chips.family, href: `${homeUrl}#about` },
      { ...chip, label: c.hero.chips.open, href: `${homeUrl}#visit` },
    ]}
  />
  <Vector
    src={RIDGE}
    layout="fill"
    class="relative z-10 -mt-8 h-8 w-full text-background md:-mt-12 md:h-12"
  />

  <ItemsContent
    headline={{
      ...SECTION_HEADLINE,
      tagline: c.services.tagline,
      title: c.services.title,
      subtitle: c.services.subtitle,
      anchorId: 'services',
    }}
    itemsGrid={{
      columns: 4,
      gap: 'normal',
      items: services,
      defaultItemConfig: {
        orientation: 'vertical',
        class: `${CARD} p-6 items-start text-left gap-5`,
        contentClass: 'items-start text-left',
        mediaClass: 'size-12',
        icon: {
          class:
            'self-start rounded-xl p-3 bg-linear-to-br from-primary to-primary-hover text-background shadow-md shadow-primary/30',
        },
        titleClass: 'font-title text-xl font-bold mb-2',
        textClass: 'text-sm text-muted leading-relaxed mb-0',
      },
    }}
  />

  <Content
    container={{ class: 'bg-surface' }}
    headline={{ class: 'hidden' }}
    imagePosition="left"
    image={{
      src: '~/assets/images/demos/local/about.jpg',
      alt: c.about.imageAlt,
      class: 'rounded-2xl shadow-2xl shadow-tertiary/20',
    }}
    twoColumnContainer={{ gap: 'loose', content: { class: 'items-center' } }}
  >
    <Headline
      {...SECTION_HEADLINE}
      tagline={c.about.tagline}
      title={c.about.title}
      anchorId="about"
      class="mt-0 mb-6 space-y-3"
    />
    <div class="space-y-4 text-normal leading-relaxed">
      <Fragment set:html={renderRichText(c.about.body)} />
    </div>
  </Content>

  <Container>
    <Headline
      {...SECTION_HEADLINE}
      tagline={c.gallery.tagline}
      title={c.gallery.title}
      anchorId="gallery"
    />
    <Container
      htmlTag="div"
      content={{ air: 'none', widthType: 'full' }}
      layout={{ type: 'grid', class: 'grid-cols-2 md:grid-cols-4 gap-3 md:gap-4' }}
    >
      <Container
        htmlTag="div"
        class="col-span-2 md:row-span-2"
        content={{ air: 'none', widthType: 'full' }}
      >
        <Image {...lead} />
      </Container>
      {rest.map((image) => (
        <Image {...image} />
      ))}
    </Container>
  </Container>

  <Container class="bg-surface">
    <div class="flex flex-wrap items-end justify-between gap-6 mb-10">
      <Headline
        {...SECTION_HEADLINE}
        tagline={c.reviews.tagline}
        title={c.reviews.title}
        anchorId="reviews"
        class="my-0 space-y-3"
      />
      <Item
        title={c.reviews.score}
        content={c.reviews.scoreLabel}
        orientation="horizontal"
        class="items-end text-right"
        contentClass="items-end text-right"
        titleClass="font-title text-6xl font-bold text-primary leading-none mb-1"
        textClass="text-sm text-muted mb-0"
      />
    </div>
    <Testimonials
      testimonials={testimonials}
      columns={3}
      container={{ content: { air: 'none' } }}
      defaultTestimonialConfig={{
        class: `${CARD} p-6 gap-4`,
        quoteClass: 'italic text-[0.95rem] leading-relaxed text-normal',
        ratingLabel: c.reviews.ratingLabel,
      }}
    />
    <Button
      label={c.reviews.allReviews}
      href="https://example.com/reviews"
      variant="link"
      intent="primary"
      icon={{ name: 'heroicons:arrow-right' }}
      iconPosition="right"
      align="left"
      class="mt-8 px-0 underline"
    />
  </Container>

  <Container>
    <Headline
      {...SECTION_HEADLINE}
      tagline={c.upcoming.tagline}
      title={c.upcoming.title}
      subtitle={c.upcoming.subtitle}
      anchorId="events"
    />
    <CollectionList
      entries={upcoming}
      langCode={langCode}
      columns={3}
      gap="normal"
      defaultEventCardConfig={EVENT_CARD}
    />
    <Button
      label={c.upcoming.all}
      href={collectionUrl('events', langCode)}
      variant="link"
      intent="primary"
      icon={{ name: 'heroicons:arrow-right' }}
      iconPosition="right"
      align="left"
      class="mt-8 px-0 underline"
    />
  </Container>

  <CallToAction
    container={{
      class: 'bg-tertiary',
      background: {
        class: 'bg-radial-[at_50%_130%] from-primary/45 via-tertiary/0 to-transparent',
      },
      spacing: { padding: 'py-14 md:py-16 lg:py-16' },
      content: {
        boxWidth: 'max-w-[var(--container-max-width)]',
        class:
          'bg-transparent shadow-none rounded-none flex flex-col md:flex-row md:items-center md:justify-between gap-6',
      },
    }}
    headline={{
      title: c.events.title,
      subtitle: c.events.subtitle,
      align: 'left',
      class: 'my-0 space-y-2',
      titleClass: `text-4xl md:text-[2.6rem] font-bold leading-tight mb-0 ${ON_DARK}`,
      subtitleClass: `text-base max-w-2xl ${ON_DARK} opacity-85`,
    }}
    actionsClass="mb-0 shrink-0"
    actions={[{ ...PILL, label: c.events.action, href: `${homeUrl}#contact` }]}
  />

  <Container>
    <Headline {...SECTION_HEADLINE} tagline={c.faq.tagline} title={c.faq.title} />
    <Accordion
      items={Object.values(c.faq.items).map((item) => ({
        title: item.question,
        content: item.answer,
      }))}
      icon={{ name: 'heroicons:plus' }}
      class="max-w-2xl space-y-3"
      itemClass={CARD}
      summaryClass="px-5 py-4"
      titleClass="font-medium"
      contentClass="px-5 pb-5 text-muted leading-relaxed"
      iconClass="text-primary"
    />
  </Container>

  <Container class="bg-surface">
    <Headline
      {...SECTION_HEADLINE}
      tagline={c.visit.tagline}
      title={c.visit.title}
      anchorId="visit"
    />
    <TwoColumnContainer
      gap="normal"
      leftColumn={{ class: `${CARD} p-6` }}
      rightColumn={{ class: `${CARD} p-6 flex flex-col gap-5` }}
    >
      <div slot="left">
        <Headline
          title={c.visit.hoursTitle}
          htmlTag="h3"
          class="mt-0 mb-4"
          titleClass="text-xl mb-0"
        />
        <ItemsGrid
          columns={1}
          gap="none"
          items={hours}
          defaultItemConfig={{
            orientation: 'horizontal',
            class: 'border-b border-border py-2.5 last:border-0',
            contentClass: 'w-full flex flex-row items-center justify-between gap-4',
            titleClass: 'text-sm font-semibold mb-0',
            textClass: 'text-sm text-muted mb-0',
          }}
        />
      </div>
      <Fragment slot="right">
        <Headline title={c.visit.findTitle} htmlTag="h3" class="my-0" titleClass="text-xl mb-0" />
        <Item
          content={`${business.street}  \n${business.postalCode} ${business.locality}\n\n[${business.phoneLabel}](tel:${PHONE})`}
          orientation="horizontal"
          textClass="leading-relaxed mb-0"
          actions={[
            { ...PILL, label: c.visit.directions, href: directionsUrl(), target: '_blank' },
            {
              label: c.visit.call,
              href: `tel:${PHONE}`,
              variant: 'outline',
              intent: 'primary',
              shape: 'pill',
            },
          ]}
          actionsClass="mt-5 gap-3"
        />
        <MapBlock
          lat={GEO.lat}
          lon={GEO.lon}
          zoom={16}
          height="240px"
          title={c.visit.mapTitle}
          markerTitle={business.name}
        />
      </Fragment>
    </TwoColumnContainer>
  </Container>

  <ContactForm
    headline={{
      ...SECTION_HEADLINE,
      tagline: c.contact.tagline,
      title: c.contact.title,
      subtitle: c.contact.subtitle,
      anchorId: 'contact',
    }}
    action={{ type: 'mailto', address: CONTACT_ADDRESS }}
    fields={[
      {
        control: 'input',
        name: 'name',
        label: c.contact.fields.name,
        required: true,
        autocomplete: 'name',
      },
      {
        control: 'input',
        name: 'email',
        type: 'email',
        label: c.contact.fields.email,
        required: true,
        autocomplete: 'email',
      },
      {
        control: 'input',
        name: 'phone',
        type: 'tel',
        label: c.contact.fields.phone,
        autocomplete: 'tel',
      },
      {
        control: 'textarea',
        name: 'message',
        label: c.contact.fields.message,
        required: true,
        rows: 5,
      },
    ]}
    formClass="max-w-2xl"
    submitButton={{ ...PILL, label: c.contact.submit, class: `${PILL.class} self-start px-8` }}
    mailtoMessage={c.contact.mailtoMessage}
  />
</LocalLayout>
