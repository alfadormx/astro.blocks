---
import '../_theme.css';
import BaseLayout from '~/layouts/Layout.astro';
import Header from '~/components/blocks/composite/Header.astro';
import Footer from '~/components/blocks/composite/Footer.astro';
import NavigationTree from '~/components/blocks/composite/NavigationTree.astro';
import ModalBlock from '~/components/blocks/layout/Modal.astro';
import type { MetaData } from '~/types/metadata.types';
import { useCopy } from '#blocks/copy';
import { CONTACT_ADDRESS, DARK_LINKS, ON_DARK, PHONE, localHome, localNav } from '../_site';

interface Props {
  langCode: string;
  metadata?: Partial<MetaData>;
}

const { langCode, metadata } = Astro.props;
const { copy } = useCopy(Astro, 'local');
const { business } = copy;
const nav = localNav(langCode, Astro.url.pathname, copy.nav);
const logo = {
  href: localHome(langCode),
  label: business.name,
  labelClass: 'font-title text-xl font-bold',
  class: `order-first ${ON_DARK}`,
};
const contact = [
  `${business.street}  \n${business.postalCode} ${business.locality}`,
  `[${business.phoneLabel}](tel:${PHONE})  \n[${CONTACT_ADDRESS}](mailto:${CONTACT_ADDRESS})`,
].join('\n\n');
---

<BaseLayout langCode={langCode} metadata={metadata} demo="local">
  <Header
    isSticky
    container={{ background: { class: 'bg-tertiary/90 backdrop-blur' } }}
    logo={logo}
    rightNavigationTreeHorizontal={{
      items: nav,
      class: 'hidden lg:flex',
      defaultItemConfig: {
        class: `text-sm font-medium ${ON_DARK} hover:bg-background/10 dark:hover:bg-normal/10`,
      },
    }}
    themeToggle={{ class: ON_DARK }}
    rightButtons={[
      {
        'data-modal-trigger': 'local-menu',
        'aria-label': copy.nav.menuLabel,
        icon: { name: 'heroicons:bars-3' },
        class: `lg:hidden ${ON_DARK}`,
      },
    ]}
  />
  <ModalBlock id="local-menu" position="right" size="sm" class="p-6 pt-16">
    <NavigationTree items={nav} />
  </ModalBlock>
  <slot />
  <Footer
    container={{ class: `bg-tertiary ${ON_DARK} ${DARK_LINKS}` }}
    logo={logo}
    disclaimer={contact}
    disclaimerClass={`text-sm leading-relaxed opacity-80 space-y-3 ${ON_DARK}`}
    secondaryButtons={[
      { label: copy.footer.instagram, href: '#' },
      { label: copy.footer.facebook, href: '#' },
    ]}
    defaultSecondaryButtonConfig={{ class: `p-0 underline ${ON_DARK}` }}
    languageToggle={{ defaultButtonConfig: { class: ON_DARK } }}
    languageToggleAlign="left"
    footnote={`© ${business.name}. ${copy.footer.footnote}`}
    footnoteClass={`text-sm opacity-80 ${ON_DARK}`}
  />
</BaseLayout>
