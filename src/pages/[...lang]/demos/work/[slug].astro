---
import Layout from '~/layouts/Layout.astro';
import DemoHeader from '../_DemoHeader.astro';
import Container from '~/components/blocks/layout/Container.astro';
import Footer from '~/components/blocks/composite/Footer.astro';
import CaseStudyLayout from '~/components/blocks/composite/CaseStudyLayout.astro';
import {
  collectionEntries,
  renderEntry,
} from '../../../../../vendor/integration/collections/pages';

export const getStaticPaths = () => collectionEntries('cases');
const { Content, langCode, layout, metadata } = await renderEntry(Astro, 'cases');
---

<Layout langCode={langCode} metadata={metadata}>
  <DemoHeader langCode={langCode} />
  <Container>
    <CaseStudyLayout {...layout}>
      <Content />
    </CaseStudyLayout>
  </Container>
  <Footer languageToggle={{}} />
</Layout>
