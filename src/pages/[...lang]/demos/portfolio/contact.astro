---
import PortfolioLayout from './_layouts/Layout.astro';
import ContactForm from '~/components/blocks/composite/ContactForm.astro';
import { localizedPaths, useCopy } from '../../../../../vendor/integration/copy/pages';
import { CONTACT_ADDRESS } from './_site';

export const getStaticPaths = () => localizedPaths();

type Props = { langCode: string; basePath: string };

const { langCode, copy } = useCopy(Astro, 'portfolio');
const fields = copy.contact.fields;
---

<PortfolioLayout langCode={langCode} metadata={{ title: { default: copy.contact.pageTitle } }}>
  <ContactForm
    headline={{ title: copy.contact.title, subtitle: copy.contact.subtitle, htmlTag: 'h1' }}
    action={{ type: 'mailto', address: CONTACT_ADDRESS }}
    fields={[
      { control: 'input', name: 'name', label: fields.name, required: true, autocomplete: 'name' },
      {
        control: 'input',
        name: 'email',
        type: 'email',
        label: fields.email,
        required: true,
        autocomplete: 'email',
      },
      { control: 'input', name: 'company', label: fields.company, autocomplete: 'organization' },
      { control: 'textarea', name: 'message', label: fields.message, required: true, rows: 6 },
    ]}
    submitButton={{ label: copy.contact.submit }}
    mailtoMessage={copy.contact.mailtoMessage}
  />
</PortfolioLayout>
