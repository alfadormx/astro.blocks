---
import PortfolioLayout from './_layouts/Layout.astro';
import ContactForm from '~/components/blocks/composite/ContactForm.astro';
import ItemsGrid from '~/components/blocks/composite/ItemsGrid.astro';
import { localizedPaths, useCopy } from '../../../../../vendor/integration/copy/pages';
import { CONTACT_ADDRESS, MONO_LABEL, contactDetails } from './_site';

export const getStaticPaths = () => localizedPaths();

type Props = { langCode: string; basePath: string };

const { langCode, copy } = useCopy(Astro, 'portfolio');
const fields = copy.contact.fields;
---

<PortfolioLayout langCode={langCode} metadata={{ title: { default: copy.contact.pageTitle } }}>
  <ContactForm
    headline={{
      title: copy.contact.title,
      subtitle: copy.contact.subtitle,
      htmlTag: 'h1',
      class: 'mt-16 md:mt-24 mb-12 md:mb-16 space-y-6',
      titleClass: 'text-5xl md:text-7xl font-medium uppercase tracking-tighter leading-none mb-0',
      subtitleClass: 'text-xl md:text-3xl text-normal tracking-tight leading-snug max-w-4xl',
    }}
    asidePosition="left"
    twoColumnContainer={{ ratio: '2:3', gap: 'loose' }}
    action={{ type: 'mailto', address: CONTACT_ADDRESS }}
    fields={[
      { control: 'input', name: 'name', label: fields.name, required: true, autocomplete: 'name' },
      {
        control: 'input',
        name: 'email',
        type: 'email',
        label: fields.email,
        required: true,
        autocomplete: 'email',
      },
      { control: 'input', name: 'company', label: fields.company, autocomplete: 'organization' },
      { control: 'textarea', name: 'message', label: fields.message, required: true, rows: 6 },
    ]}
    defaultFieldConfig={{ shape: 'square' }}
    formClass="gap-8"
    submitButton={{
      label: copy.contact.submit,
      variant: 'link',
      intent: 'neutral',
      icon: { name: 'heroicons:arrow-right' },
      iconPosition: 'right',
      class: 'self-start px-0 text-lg no-underline hover:underline',
    }}
    mailtoMessage={copy.contact.mailtoMessage}
  >
    <ItemsGrid
      slot="aside"
      columns={1}
      gap="normal"
      items={contactDetails(copy.contact, copy.footer.address)}
      defaultItemConfig={{
        orientation: 'horizontal',
        class: 'items-start text-left',
        contentClass: 'items-start text-left',
        titleClass: `${MONO_LABEL} mb-1`,
        textClass: 'leading-snug mb-0',
      }}
    />
  </ContactForm>
</PortfolioLayout>
