---
import '../_theme.css';
import BaseLayout from '~/layouts/Layout.astro';
import Header from '~/components/blocks/composite/Header.astro';
import Footer from '~/components/blocks/composite/Footer.astro';
import NavigationTree from '~/components/blocks/composite/NavigationTree.astro';
import ModalBlock from '~/components/blocks/layout/Modal.astro';
import type { MetaData } from '~/types/metadata.types';
import { useCopy } from '../../../../../../vendor/integration/copy/pages';
import { portfolioHome, portfolioNav } from '../_site';

interface Props {
  langCode: string;
  metadata?: Partial<MetaData>;
}

const { langCode, metadata } = Astro.props;
const { copy } = useCopy(Astro, 'portfolio');
const nav = portfolioNav(langCode, Astro.url.pathname, copy.nav);
const logo = { href: portfolioHome(langCode), label: copy.studio };
---

<BaseLayout langCode={langCode} metadata={metadata} demo="portfolio">
  <Header
    isSticky
    container={{ background: { class: 'bg-background/80 backdrop-blur' } }}
    logo={logo}
    leftButtons={[
      {
        'data-modal-trigger': 'portfolio-menu',
        'aria-label': copy.nav.menuLabel,
        icon: { name: 'heroicons:bars-3' },
        class: 'lg:hidden',
      },
    ]}
    leftNavigationTreeHorizontal={{ items: nav, class: 'hidden lg:flex' }}
    themeToggle={{}}
  />
  <ModalBlock id="portfolio-menu" position="left" size="sm" class="p-6 pt-16">
    <NavigationTree items={nav} />
  </ModalBlock>
  <slot />
  <Footer logo={logo} languageToggle={{}} footnote={copy.footer.footnote} />
</BaseLayout>
