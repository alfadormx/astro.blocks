---
import PortfolioLayout from './_layouts/Layout.astro';
import Content from '~/components/blocks/composite/Content.astro';
import Team from '~/components/blocks/composite/Team.astro';
import type { TeamMember } from '~/types/team.types';
import { renderRichText } from '~/utils/richText';
import { localizedPaths, useCopy } from '#blocks/copy';

export const getStaticPaths = () => localizedPaths();

type Props = { langCode: string; basePath: string };

const { langCode, copy } = useCopy(Astro, 'portfolio');

const members: TeamMember[] = Object.entries(copy.about.team.members).map(([key, member]) => ({
  title: member.name,
  content: member.role,
  image: { src: `~/assets/images/demos/portfolio/team-${key}.jpg`, alt: member.photoAlt },
}));
---

<PortfolioLayout langCode={langCode} metadata={{ title: { default: copy.about.pageTitle } }}>
  <Content
    headline={{ title: copy.about.title, subtitle: copy.about.subtitle, htmlTag: 'h1' }}
    image={{ src: '~/assets/images/demos/portfolio/about.jpg', alt: copy.about.imageAlt }}
    twoColumnContainer={{ content: { class: 'items-center' } }}
  >
    <Fragment set:html={renderRichText(copy.about.body)} />
  </Content>
  <Team
    headline={{ title: copy.about.team.title }}
    members={members}
    columns={4}
    imageShape="square"
  />
</PortfolioLayout>
