---
import SaasLayout from './_layouts/Layout.astro';
import Hero from '~/components/blocks/composite/Hero.astro';
import LogoCloud from '~/components/blocks/composite/LogoCloud.astro';
import Tabs from '~/components/blocks/composite/Tabs.astro';
import ItemsContent from '~/components/blocks/composite/ItemsContent.astro';
import Pricing from '~/components/blocks/composite/Pricing.astro';
import Testimonials from '~/components/blocks/composite/Testimonials.astro';
import CallToAction from '~/components/blocks/composite/CallToAction.astro';
import CollectionList from '~/components/blocks/composite/CollectionList.astro';
import Button from '~/components/blocks/primitives/Button.astro';
import Container from '~/components/blocks/layout/Container.astro';
import TwoColumnContainer from '~/components/blocks/layout/TwoColumnContainer.astro';
import Accordion from '~/components/blocks/primitives/Accordion.astro';
import Headline from '~/components/blocks/primitives/Headline.astro';
import Image from '~/components/blocks/primitives/Image.astro';
import type { ItemProps } from '~/types/item.types';
import type { PricingTier } from '~/types/pricing.types';
import { collectionUrl, getFeatured } from '../../../../../vendor/integration/collections/pages';
import { localizedPaths, useCopy } from '../../../../../vendor/integration/copy/pages';
import {
  DUSK_BACKGROUND,
  ON_DUSK,
  POST_CARD,
  SECTION_HEADLINE,
  STEP_ICONS,
  saasHome,
  saasLogos,
} from './_site';

export const getStaticPaths = () => localizedPaths();

type Props = { langCode: string; basePath: string };

const { langCode, copy } = useCopy(Astro, 'saas');
const home = saasHome(langCode);
const metadata = { title: { default: copy.pageTitle } };
const currency = langCode === 'en' ? 'USD' : 'EUR';

const IMAGES = {
  charts: '~/assets/images/demos/saas/content-a.jpg',
  team: '~/assets/images/demos/saas/content-b.jpg',
  stars: '~/assets/images/demos/saas/cta.jpg',
  portrait: '~/assets/images/demos/portfolio/team-ana.jpg',
};

const getStarted = {
  href: `${home}#pricing`,
  variant: 'solid' as const,
  intent: 'neutral' as const,
  size: 'lg' as const,
  icon: { name: 'heroicons:arrow-right' },
  iconPosition: 'right' as const,
};

const steps = Object.entries(copy.workflow.steps).map(([key, step]) => ({
  label: step.title,
  subtitle: step.content,
  icon: { name: STEP_ICONS[key as keyof typeof STEP_ICONS] },
}));

const stats: ItemProps[] = Object.values(copy.stats).map((stat) => ({
  title: stat.value,
  content: stat.label,
}));

const featureItems: ItemProps[] = Object.values(copy.features.items).map((item) => ({
  title: item.title,
  content: item.content,
}));

const tiers: PricingTier[] = Object.entries(copy.pricing.tiers).map(([key, tier]) => ({
  name: tier.name,
  description: tier.description,
  price: { monthly: tier.monthly, yearly: tier.yearly },
  currency,
  period: { monthly: copy.pricing.perMonth, yearly: copy.pricing.perYear },
  features: Object.values(tier.features),
  action: { label: tier.action, href: `${home}#pricing` },
  highlighted: key === 'team',
}));

const storyImages = [IMAGES.charts, IMAGES.team, IMAGES.stars];
const stories: ItemProps[] = Object.values(copy.stories.items).map((story, i) => ({
  image: { src: storyImages[i], alt: story.imageAlt, width: 640, height: 280, layout: 'cover' },
  title: story.value,
  content: story.label,
}));

const posts = await getFeatured('posts', 3, langCode);

const privacyPoints: ItemProps[] = Object.values(copy.privacy.points).map((point) => ({
  icon: { name: 'heroicons:shield-check' },
  title: point,
}));
---

<SaasLayout langCode={langCode} metadata={metadata}>
  <Hero
    headline={{
      title: copy.hero.title,
      subtitle: copy.hero.subtitle,
      align: 'left',
      class: 'max-w-4xl',
      titleClass: `text-5xl md:text-7xl font-light tracking-tighter leading-[1.02] ${ON_DUSK}`,
      subtitleClass: `text-lg md:text-xl max-w-2xl ${ON_DUSK} opacity-90`,
    }}
    container={{
      class: 'bg-tertiary',
      background: { class: DUSK_BACKGROUND },
      spacing: { padding: 'pt-24 pb-64 md:pt-32 md:pb-96 lg:pt-32 lg:pb-96' },
    }}
    actionsClass="justify-start"
    actions={[{ ...getStarted, label: copy.hero.primary }]}
  />
  <Container content={{ class: '-mt-44 md:-mt-72 relative' }} spacing={{ padding: 'pb-8' }}>
    <Image
      src={IMAGES.charts}
      alt={copy.hero.imageAlt}
      width={1200}
      height={600}
      class="w-full aspect-2/1 object-cover rounded-3xl border border-border shadow-xl"
    />
  </Container>

  <LogoCloud
    logos={saasLogos(copy.logos.names)}
    layout="marquee"
    grayscale
    contentCarousel={{ ariaLabel: copy.logos.carouselLabel, prevButton: false, nextButton: false }}
    container={{ content: { air: 'tight' } }}
  />

  <Container>
    <Headline
      {...SECTION_HEADLINE}
      title={copy.workflow.title}
      subtitle={copy.workflow.subtitle}
      anchorId="features"
    />
    <Tabs
      orientation="vertical"
      items={steps}
      defaultItemConfig={{
        variant: 'ghost',
        intent: 'neutral',
        orientation: 'horizontal',
        class: 'items-start justify-start text-left',
        subtitleClass: 'hidden',
      }}
      activeItemConfig={{ class: 'bg-surface', subtitleClass: 'block text-sm text-emphasis mt-1' }}
      tabList={{ class: 'max-md:col-span-2 md:mr-14 md:w-80 lg:w-[28rem]' }}
      panelClass="max-md:hidden rounded-3xl bg-surface p-6 md:p-10"
    >
      {Object.keys(copy.workflow.steps).map((_, i) => (
        <Image
          slot={`panel-${i}`}
          src={i % 2 ? IMAGES.team : IMAGES.charts}
          alt={i % 2 ? copy.workflow.imageAltB : copy.workflow.imageAltA}
          width={800}
          height={600}
          class="w-full aspect-4/3 object-cover rounded-2xl"
        />
      ))}
    </Tabs>
  </Container>

  <Container
    background={{ class: 'bg-linear-to-b from-secondary/20 to-accent/40' }}
    content={{
      boxWidth: 'max-w-4xl',
      class: 'bg-background rounded-3xl p-6 md:p-10 shadow-sm',
    }}
  >
    <Headline
      {...SECTION_HEADLINE}
      title={copy.teams.title}
      subtitle={copy.teams.subtitle}
      class="mt-0 mb-8"
    />
    <Container
      spacing={{ padding: 'p-0' }}
      content={{ widthType: 'full', class: 'prose max-w-none' }}
      items={[{ content: copy.teams.table }]}
    />
  </Container>

  <ItemsContent
    itemsGrid={{
      columns: 3,
      gap: 'normal',
      items: stats,
      class: 'border-b border-border pb-16',
      defaultItemConfig: {
        orientation: 'horizontal',
        titleClass: 'text-6xl md:text-7xl font-light tracking-tighter mb-2',
        textClass: 'text-emphasis mb-0',
      },
    }}
  />

  <Testimonials
    testimonials={[
      {
        quote: copy.quote.text,
        author: {
          name: copy.quote.name,
          role: copy.quote.role,
          avatar: { src: IMAGES.portrait, alt: copy.quote.imageAlt, width: 96, height: 96 },
        },
      },
    ]}
    columns={1}
    defaultTestimonialConfig={{
      class: 'bg-surface rounded-3xl p-8 md:p-12 border-0',
      quoteClass: 'text-2xl md:text-3xl leading-snug tracking-tight text-normal',
    }}
  />

  <ItemsContent
    headline={{ ...SECTION_HEADLINE, title: copy.features.title, subtitle: copy.features.subtitle }}
    itemsGrid={{
      columns: 3,
      gap: 'none',
      items: featureItems,
      class: 'border-t border-l border-border rounded-3xl overflow-hidden',
      defaultItemConfig: {
        orientation: 'horizontal',
        class: 'border-r border-b border-border p-8',
        titleClass: 'text-lg font-medium mb-1',
        textClass: 'text-emphasis mb-0',
      },
    }}
  />

  <Pricing
    headline={{
      ...SECTION_HEADLINE,
      title: copy.pricing.title,
      subtitle: copy.pricing.subtitle,
      anchorId: 'pricing',
      align: 'left',
    }}
    tiers={tiers}
    toggleGroup={{
      label: copy.pricing.toggleLabel,
      options: [{ label: copy.pricing.monthly, selected: true }, { label: copy.pricing.yearly }],
    }}
    billingAnnouncement={{
      monthly: copy.pricing.announceMonthly,
      yearly: copy.pricing.announceYearly,
    }}
    defaultTierConfig={{ class: 'rounded-3xl', action: { shape: 'pill' } }}
    highlightedTierConfig={{ class: 'bg-surface border-2 border-primary' }}
  />

  <ItemsContent
    headline={{
      ...SECTION_HEADLINE,
      title: copy.stories.title,
      subtitle: copy.stories.subtitle,
      anchorId: 'testimonials',
    }}
    itemsGrid={{
      columns: 3,
      gap: 'tight',
      items: stories,
      defaultItemConfig: {
        orientation: 'vertical',
        class: 'items-start text-left gap-4',
        contentClass: 'items-start text-left',
        mediaClass: 'w-full aspect-[16/7] object-cover rounded-3xl',
        titleClass: 'text-3xl font-light tracking-tight mb-1',
        textClass: 'text-emphasis mb-0',
      },
    }}
  />

  <Container>
    <Headline {...SECTION_HEADLINE} title={copy.posts.title} subtitle={copy.posts.subtitle} />
    <CollectionList
      entries={posts}
      langCode={langCode}
      columns={3}
      gap="normal"
      defaultPostCardConfig={POST_CARD}
    />
    <Button
      label={copy.posts.action}
      href={collectionUrl('posts', langCode)}
      variant="outline"
      intent="neutral"
      shape="pill"
      icon={{ name: 'heroicons:arrow-right' }}
      iconPosition="right"
      align="left"
      class="mt-10"
    />
  </Container>

  <Container>
    <TwoColumnContainer ratio="2:3" gap="loose">
      <Headline
        slot="left"
        {...SECTION_HEADLINE}
        title={copy.faq.title}
        anchorId="faq"
        class="mt-0"
      />
      <Accordion
        slot="right"
        items={Object.values(copy.faq.items).map((item) => ({
          title: item.question,
          content: item.answer,
        }))}
      />
    </TwoColumnContainer>
  </Container>

  <ItemsContent
    container={{ class: 'bg-surface' }}
    headline={{
      ...SECTION_HEADLINE,
      title: copy.privacy.title,
      subtitle: copy.privacy.subtitle,
      subtitleClass: 'text-lg md:text-xl text-emphasis max-w-2xl',
    }}
    itemsGrid={{
      columns: 2,
      gap: 'tight',
      items: privacyPoints,
      class: 'max-w-xl mx-0',
      defaultItemConfig: {
        orientation: 'horizontal',
        class: 'items-center gap-3',
        mediaClass: 'size-5',
        icon: { class: 'text-secondary' },
        titleClass: 'text-lg font-normal mb-0',
      },
    }}
  />

  <CallToAction
    headline={{
      title: copy.cta.title,
      align: 'center',
      titleClass: `text-5xl md:text-6xl font-light tracking-tighter leading-[1.05] ${ON_DUSK}`,
    }}
    container={{
      class: 'bg-tertiary',
      background: { class: DUSK_BACKGROUND },
      spacing: { padding: 'py-28 md:py-28 lg:py-28' },
      content: { class: 'bg-transparent shadow-none' },
    }}
    actions={[{ ...getStarted, label: copy.cta.primary }]}
  />
</SaasLayout>
