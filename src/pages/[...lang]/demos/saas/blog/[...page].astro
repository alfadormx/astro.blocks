---
import SaasLayout from '../_layouts/Layout.astro';
import Container from '~/components/blocks/layout/Container.astro';
import CollectionList from '~/components/blocks/composite/CollectionList.astro';
import Headline from '~/components/blocks/primitives/Headline.astro';
import {
  collectionPages,
  renderList,
} from '../../../../../../vendor/integration/collections/pages';
import { useCopy } from '../../../../../../vendor/integration/copy/pages';
import { POST_CARD, SECTION_HEADLINE } from '../_site';

export const getStaticPaths = () => collectionPages('posts');
const { langCode, entries, page } = await renderList(Astro);
const { copy } = useCopy(Astro, 'saas');
---

<SaasLayout langCode={langCode} metadata={{ title: { default: copy.blog.title } }}>
  <Container>
    <Headline
      {...SECTION_HEADLINE}
      title={copy.blog.title}
      subtitle={copy.blog.subtitle}
      htmlTag="h1"
    />
    <CollectionList
      entries={entries}
      page={page}
      langCode={langCode}
      columns={3}
      gap="normal"
      defaultPostCardConfig={POST_CARD}
    />
  </Container>
</SaasLayout>
