---
import '../_theme.css';
import BaseLayout from '~/layouts/Layout.astro';
import Header from '~/components/blocks/composite/Header.astro';
import Footer from '~/components/blocks/composite/Footer.astro';
import NavigationTree from '~/components/blocks/composite/NavigationTree.astro';
import ModalBlock from '~/components/blocks/layout/Modal.astro';
import type { MetaData } from '~/types/metadata.types';
import { useCopy } from '../../../../../../vendor/integration/copy/pages';
import { LABEL, jewelleryHome, jewelleryNav } from '../_site';

interface Props {
  langCode: string;
  metadata?: Partial<MetaData>;
}

const { langCode, metadata } = Astro.props;
const { copy } = useCopy(Astro, 'jewellery');
const nav = jewelleryNav(langCode, Astro.url.pathname, copy.nav);
const logo = {
  href: jewelleryHome(langCode),
  label: copy.brand,
  labelClass: 'font-title text-2xl md:text-3xl font-medium tracking-wide',
};
---

<BaseLayout langCode={langCode} metadata={metadata} demo="jewellery">
  <Header
    isSticky
    container={{
      background: { class: 'bg-background/95 backdrop-blur' },
      class: 'border-b border-border',
    }}
    logo={logo}
    defaultNavigationTreeHorizontalConfig={{
      class: 'hidden lg:flex',
      defaultItemConfig: { class: `${LABEL} font-medium` },
    }}
    leftNavigationTreeHorizontal={{ items: nav.slice(0, 2) }}
    rightNavigationTreeHorizontal={{ items: nav.slice(2) }}
    themeToggle={{ variant: 'ghost', intent: 'neutral' }}
    rightButtons={[
      {
        'data-modal-trigger': 'jewellery-menu',
        'aria-label': copy.nav.menuLabel,
        icon: { name: 'heroicons:bars-3' },
        class: 'lg:hidden',
      },
    ]}
  />
  <ModalBlock id="jewellery-menu" position="right" size="sm" class="p-6 pt-16">
    <NavigationTree items={nav} />
  </ModalBlock>
  <slot />
  <Footer
    container={{ class: 'border-t border-border', spacing: { padding: 'px-4 md:px-6 lg:px-8' } }}
    logo={logo}
    disclaimer={copy.footer.disclaimer}
    disclaimerClass="text-sm text-muted max-w-md"
    socialButtons={[
      { 'aria-label': copy.footer.instagram, icon: { name: 'tabler:brand-instagram' }, href: '#' },
      { 'aria-label': copy.footer.pinterest, icon: { name: 'tabler:brand-pinterest' }, href: '#' },
    ]}
    languageToggle={{}}
    footnote={`© ${copy.brand}. ${copy.footer.footnote}`}
    footnoteClass="text-sm text-muted"
  />
</BaseLayout>
