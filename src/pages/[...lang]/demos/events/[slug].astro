---
import Layout from '~/layouts/Layout.astro';
import DemoHeader from '../_DemoHeader.astro';
import Container from '~/components/blocks/layout/Container.astro';
import Footer from '~/components/blocks/composite/Footer.astro';
import EventLayout from '~/components/blocks/composite/EventLayout.astro';
import {
  collectionEntries,
  renderEntry,
} from '../../../../../vendor/integration/collections/pages';

export const getStaticPaths = () => collectionEntries('events');
const { Content, langCode, layout, metadata } = await renderEntry(Astro, 'events');
---

<Layout langCode={langCode} metadata={metadata}>
  <DemoHeader langCode={langCode} />
  <Container>
    <EventLayout {...layout}>
      <Content />
    </EventLayout>
  </Container>
  <Footer languageToggle={{}} />
</Layout>
