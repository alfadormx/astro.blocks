---
import Layout from '../_layouts/Layout.astro';
import CodeBlockBlock from '~/components/blocks/primitives/CodeBlock.astro';
import ApiReferenceTable from '~/components/meta/ApiReferenceTable.astro';

const metadata = {
  title: {
    default: 'CodeBlock',
  },
};

// Must match `BASIC` in tests/browser/codeblock.spec.ts.
const basicSample =
  'export function greet(name: string): string {\n  return `Hello, ${name}!`;\n}\n';

const titleSample = '---\nconst title = "Home";\n---\n\n<h1>{title}</h1>\n';

const longLineSample =
  "export const longLine = ['alpha', 'bravo', 'charlie', 'delta', 'echo', 'foxtrot', 'golf', 'hotel', 'india', 'juliett', 'kilo', 'lima', 'mike', 'november', 'oscar', 'papa', 'quebec', 'romeo', 'sierra', 'tango'];\n";

const tokensSample =
  "// Keywords, strings, numbers, types, calls, a regex and a < comparison.\ninterface Point {\n  x: number;\n  y: number;\n}\n\nconst limit = 42;\nconst pattern = /^[a-z]+$/i;\n\nexport async function check(point: Point, label = 'origin'): Promise<boolean> {\n  const ok = point.x < limit && pattern.test(label);\n  console.log(`checked ${label}`, ok);\n  return ok;\n}\n";
---

<Layout
  metadata={metadata}
  headline={{
    tagline: 'Primitives',
    title: 'CodeBlock',
    subtitle: 'Highlighted code with a copy button, themed for light and dark.',
  }}
>
  <h3>1. Basic</h3>
  <p>
    Pass the source as <code>code</code> and a Shiki language id as <code>lang</code>. The copy
    button copies the rendered text, so Windows line endings (<code>\r\n</code>) are copied as
    <code>\n</code>.
  </p>
  <div data-doc-section="basic">
    <CodeBlockBlock lang="ts" code={basicSample} />
  </div>

  <h3>2. Title</h3>
  <p>
    A <code>title</code> renders as a filename caption, with the copy button beside it.
  </p>
  <div data-doc-section="title">
    <CodeBlockBlock lang="astro" title="src/pages/index.astro" code={titleSample} />
  </div>

  <h3>3. No copy button</h3>
  <p>
    Set <code>copyButton</code> to <code>false</code> to hide the button.
  </p>
  <div data-doc-section="no-copy">
    <CodeBlockBlock lang="sh" code="pnpm add astro" copyButton={false} />
  </div>

  <h3>4. Long lines</h3>
  <p>
    Long lines scroll inside the block, never the page. The code area is keyboard-focusable, so the
    arrow keys scroll it.
  </p>
  <div data-doc-section="long-lines">
    <CodeBlockBlock lang="ts" code={longLineSample} />
  </div>

  <h3>5. Token colours</h3>
  <p>
    The block uses GitHub's light and dark themes and follows the site theme toggle. MDX fenced code
    blocks use the same themes.
  </p>
  <div data-doc-section="tokens">
    <CodeBlockBlock lang="ts" code={tokensSample} />
  </div>

  <h3>6. Escaping</h3>
  <p>The source renders as text, so markup is shown, not interpreted.</p>
  <div data-doc-section="escape">
    <CodeBlockBlock lang="html" code="<p>a < b</p>" />
  </div>

  <h3>7. Several files</h3>
  <p>
    For several files side by side, compose <code>Tabs</code> with one <code>CodeBlock</code> per
    panel.
  </p>

  <ApiReferenceTable component="CodeBlock" category="primitives" />
</Layout>
