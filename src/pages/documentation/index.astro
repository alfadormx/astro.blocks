---
import Layout from './_layouts/Layout.astro';
import ItemsGrid from '~/components/blocks/composite/ItemsGrid.astro';
import { I18N } from 'site-config';
import { collectionIndex } from '../../../vendor/integration/collections/pages';
import { sections } from './_sections';

const metadata = {
  title: {
    default: 'Components',
  },
};

const entries = await collectionIndex('documentation', I18N.default);
const groups = sections
  .map((section) => ({ section, entries: entries.filter((e) => e.data.section === section.key) }))
  .filter((g) => g.entries.length);
---

<Layout
  metadata={metadata}
  headline={{
    tagline: 'Documentation',
    title: 'Components',
    subtitle: 'Every block in the library, grouped by type.',
  }}
>
  <p>
    Browse the full component library below. Each card links to that component's documentation page,
    with live examples and a generated API reference. New to the library? Start with
    <a href="/documentation/guides/Composing">Composing blocks</a>, which explains how every block
    exposes and configures its children.
  </p>

  {groups.map(({ section, entries }) => (
    <Fragment>
      <h2>{section.label}</h2>
      <p>{section.description}</p>
      <ItemsGrid
        columns={3}
        gap="tight"
        defaultItemConfig={{
          orientation: 'vertical',
          icon: { name: 'heroicons:cube', class: 'text-accent' },
        }}
        items={entries.map((e) => ({
          title: e.data.title,
          content: e.data.description,
          actions: [
            {
              label: 'View',
              href: e.href,
              variant: 'ghost' as const,
              intent: 'primary' as const,
            },
          ],
        }))}
      />
    </Fragment>
  ))}

  <h2>See it in a site</h2>
  <p>Demo sites built only from these blocks, themed with token overrides.</p>
  <ItemsGrid
    columns={3}
    gap="tight"
    defaultItemConfig={{
      orientation: 'vertical',
      icon: { name: 'heroicons:rocket-launch', class: 'text-accent' },
    }}
    items={[
      {
        title: 'SaaS landing',
        content:
          'Hero, logos, features, pricing, testimonials, FAQ and a blog, with anchor navigation.',
        actions: [{ label: 'Open', href: '/demos/saas', variant: 'ghost', intent: 'primary' }],
      },
      {
        title: 'Portfolio',
        content:
          'Hero, case study galleries, team, testimonials and a contact form across several pages.',
        actions: [{ label: 'Open', href: '/demos/portfolio', variant: 'ghost', intent: 'primary' }],
      },
      {
        title: 'Local business',
        content:
          'Hero, services, reviews, opening hours, a lazy map beside a contact form, and events.',
        actions: [{ label: 'Open', href: '/demos/local', variant: 'ghost', intent: 'primary' }],
      },
    ]}
  />
</Layout>
