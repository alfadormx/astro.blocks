---
import Layout from '../_layouts/Layout.astro';
import CallToActionBlock from '~/components/blocks/composite/CallToAction.astro';
import ApiReferenceTable from '~/components/meta/ApiReferenceTable.astro';

const metadata = {
  title: {
    default: 'Call To Action',
  },
};
---

<Layout
  metadata={metadata}
  headline={{
    tagline: 'Composite',
    title: 'Call To Action',
    subtitle: 'Showcase of the CallToAction composite block with various configurations',
  }}
>
  <h3>1. Default configuration</h3>
  <CallToActionBlock
    headline={{
      tagline: 'Call to Action',
      title: 'Astro + Tailwind CSS',
      subtitle:
        "Be very surprised by these huge fake numbers you are seeing on this page. Don't waste more time!",
      align: 'center',
    }}
    actions={[
      {
        label: 'Get template',
        icon: { name: 'heroicons:arrow-down-tray' },
        intent: 'primary',
        size: 'lg',
        variant: 'solid',
        shape: 'pill',
      },
      {
        label: 'Subscribe Now',
        icon: { name: 'heroicons:arrow-top-right-on-square' },
        intent: 'secondary',
        size: 'lg',
        variant: 'solid',
        shape: 'pill',
        iconPosition: 'right',
      },
    ]}
  />
  <h3>2. Shared action defaults</h3>
  <p>
    <code>defaultActionConfig</code> is merged under every action, so each entry only lists what differs.
    <code>actionsClass</code> styles the wrapper around the buttons.
  </p>
  <CallToActionBlock
    headline={{
      tagline: 'Call to Action',
      title: 'Shared button styling',
      subtitle: 'Both buttons take size, shape, and variant from one place.',
    }}
    defaultActionConfig={{ size: 'lg', shape: 'pill', variant: 'solid' }}
    actionsClass="md:justify-start"
    actions={[
      { label: 'Get template', intent: 'primary' },
      { label: 'Subscribe Now', intent: 'secondary' },
    ]}
  />
  <ApiReferenceTable component="CallToAction" category="composite" />
</Layout>
