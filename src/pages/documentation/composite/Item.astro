---
import Layout from '../_layouts/Layout.astro';
import ItemBlock from '~/components/blocks/composite/Item.astro';
import ApiReferenceTable from '~/components/meta/ApiReferenceTable.astro';

const metadata = {
  title: {
    default: 'Item',
  },
};
---

<Layout
  metadata={metadata}
  headline={{
    tagline: 'Composite',
    title: 'Item',
    subtitle:
      'Single icon/title/content/actions block — the building block behind ItemsGrid, ItemsTimeline, and ItemsTimelineHorizontal',
  }}
>
  <p>
    Item renders an optional icon or image, an optional title, optional content, and action buttons,
    in either a vertical (stacked, centered) or horizontal (icon-left, text-right) layout. It
    renders only what it is given. It also supports optional connector lines, used to build timeline
    UIs.
  </p>

  <!-- Example 1: Basic Vertical Item -->
  <h3>1. Basic Vertical Item</h3>
  <p>Default layout: icon, title, and content stacked and centered.</p>
  <div class="max-w-sm border border-border rounded-lg p-6">
    <ItemBlock
      icon={{ name: 'heroicons:sparkles', class: 'text-accent' }}
      title="Vertical Layout"
      content="Icon, title, and content are stacked and centered. This is the default layout."
      actions={[{ label: 'Learn More', intent: 'accent', size: 'sm' }]}
    />
  </div>

  <!-- Example 2: Horizontal Layout -->
  <h3>2. Horizontal Layout</h3>
  <p>Icon on the left, title and content left-aligned on the right.</p>
  <div class="max-w-md border border-border rounded-lg p-6">
    <ItemBlock
      icon={{ name: 'heroicons:bolt', class: 'text-success' }}
      title="Horizontal Layout"
      content="The icon sits to the left, with the title and content left-aligned beside it."
      actions={[{ label: 'Learn More', intent: 'success', size: 'sm' }]}
      layout="horizontal"
    />
  </div>

  <!-- Example 3: Connector Lines -->
  <h3>3. Connector Lines</h3>
  <p>
    Connector lines link items together to build timeline UIs. Use <code
      class="px-1 py-0.5 bg-muted rounded">showConnector</code
    > on a horizontal item for a vertical connecting line (as used by ItemsTimeline), or <code
      class="px-1 py-0.5 bg-muted rounded">showConnectorLeft</code
    >/<code class="px-1 py-0.5 bg-muted rounded">showConnectorRight</code> on a vertical item for a horizontal
    connecting line (as used by ItemsTimelineHorizontal).
  </p>
  <div class="space-y-8">
    <div>
      <h4>Vertical connector (horizontal layout)</h4>
      <div class="max-w-md border border-border rounded-lg p-6">
        <ItemBlock
          icon={{ name: 'heroicons:arrow-down-tray', class: 'text-primary' }}
          title="Step 1: Download"
          content="Get started by downloading the template."
          layout="horizontal"
          showConnector
        />
        <ItemBlock
          icon={{ name: 'heroicons:pencil-square', class: 'text-secondary' }}
          title="Step 2: Customize"
          content="Add your own content and styles."
          layout="horizontal"
          showConnector
        />
        <ItemBlock
          icon={{ name: 'heroicons:check-circle', class: 'text-success' }}
          title="Step 3: Done"
          content="Ship it!"
          layout="horizontal"
        />
      </div>
    </div>
    <div>
      <h4>Horizontal connector (vertical layout)</h4>
      <div class="border border-border rounded-lg p-6 flex flex-row items-start">
        <ItemBlock
          icon={{ name: 'heroicons:user-plus', class: 'text-primary' }}
          title="Sign Up"
          content="Create your account."
        />
        <ItemBlock
          icon={{ name: 'heroicons:envelope', class: 'text-secondary' }}
          title="Verify"
          content="Confirm your email."
          showConnectorLeft
          showConnectorRight
        />
        <ItemBlock
          icon={{ name: 'heroicons:rocket-launch', class: 'text-success' }}
          title="Launch"
          content="You're all set."
          showConnectorLeft
        />
      </div>
    </div>
  </div>

  <!-- Example 4: Optional Text -->
  <h3>4. Optional Text</h3>
  <p>
    <code class="px-1 py-0.5 bg-muted rounded">title</code> and
    <code class="px-1 py-0.5 bg-muted rounded">content</code> are both optional. Item renders only what
    it is given — an omitted or empty value produces no element and no reserved space.
  </p>
  <div class="flex flex-wrap items-start gap-6">
    <div class="max-w-xs border border-border rounded-lg p-6">
      <ItemBlock icon={{ name: 'heroicons:swatch', class: 'text-primary' }} title="Title Only" />
    </div>
    <div class="max-w-xs border border-border rounded-lg p-6">
      <ItemBlock
        icon={{ name: 'heroicons:eye', class: 'text-secondary' }}
        content="Content without a title."
      />
    </div>
    <div class="max-w-xs border border-border rounded-lg p-6">
      <ItemBlock icon={{ name: 'heroicons:sparkles', class: 'text-accent' }} />
    </div>
  </div>

  <!-- Example 5: Image Instead of Icon -->
  <h3>5. Image Instead of Icon</h3>
  <p>
    <code class="px-1 py-0.5 bg-muted rounded">image</code> carries the Image primitive's configuration
    and renders in the same media slot as <code class="px-1 py-0.5 bg-muted rounded">icon</code>.
    The two are mutually exclusive — when both are supplied the image wins.
    <code class="px-1 py-0.5 bg-muted rounded">image.alt</code> is required at runtime; the Image primitive
    throws without it. Supply <code class="px-1 py-0.5 bg-muted rounded">width</code>/<code
      class="px-1 py-0.5 bg-muted rounded">height</code
    > or an <code class="px-1 py-0.5 bg-muted rounded">aspectRatio</code>, or the optimizer logs an
    error. The default box is <code class="px-1 py-0.5 bg-muted rounded"
      >size-8 md:size-10 lg:size-12</code
    >, which fixes both axes — pass <code class="px-1 py-0.5 bg-muted rounded">image.class</code> to override
    it or to add <code class="px-1 py-0.5 bg-muted rounded">object-*</code> handling for a non-square
    source.
  </p>
  <div class="flex flex-wrap items-start gap-6">
    <div class="max-w-xs border border-border rounded-lg p-6">
      <ItemBlock
        image={{
          src: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4',
          alt: 'Mountain landscape',
          width: 96,
          height: 96,
        }}
        title="Image, Title and Content"
        content="The image replaces the icon in the media slot."
      />
    </div>
    <div class="max-w-xs border border-border rounded-lg p-6">
      <ItemBlock
        image={{
          src: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4',
          alt: 'Mountain landscape',
          width: 96,
          height: 96,
        }}
      />
    </div>
    <div class="max-w-md border border-border rounded-lg p-6">
      <ItemBlock
        image={{
          src: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4',
          alt: 'Mountain landscape',
          width: 96,
          height: 96,
        }}
        title="Horizontal"
        content="An image works in the horizontal layout too."
        layout="horizontal"
      />
    </div>
  </div>

  <!-- Example 6: Image With Connectors -->
  <h3>6. Image With Connectors</h3>
  <p>
    Images work under every connector variant, so ItemsTimeline and ItemsTimelineHorizontal can
    render image-led steps.
  </p>
  <div class="space-y-8">
    <div>
      <h4>Vertical connector (horizontal layout)</h4>
      <div class="max-w-md border border-border rounded-lg p-6">
        <ItemBlock
          image={{
            src: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4',
            alt: 'Mountain landscape',
            width: 96,
            height: 96,
          }}
          title="Step 1"
          content="An image under showConnector."
          layout="horizontal"
          showConnector
        />
        <ItemBlock
          image={{
            src: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4',
            alt: 'Mountain landscape',
            width: 96,
            height: 96,
          }}
          title="Step 2"
          content="The last step has no connector."
          layout="horizontal"
        />
      </div>
    </div>
    <div>
      <h4>Horizontal connector (vertical layout)</h4>
      <div class="border border-border rounded-lg p-6 flex flex-row items-start">
        <ItemBlock
          image={{
            src: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4',
            alt: 'Mountain landscape',
            width: 96,
            height: 96,
          }}
          title="First"
        />
        <ItemBlock
          image={{
            src: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4',
            alt: 'Mountain landscape',
            width: 96,
            height: 96,
          }}
          title="Middle"
          showConnectorLeft
          showConnectorRight
        />
        <ItemBlock
          image={{
            src: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4',
            alt: 'Mountain landscape',
            width: 96,
            height: 96,
          }}
          title="Last"
          showConnectorLeft
        />
      </div>
    </div>
  </div>

  <ApiReferenceTable component="Item" category="composite" />
</Layout>
