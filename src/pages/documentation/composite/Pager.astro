---
import Layout from '../_layouts/Layout.astro';
import PagerBlock from '~/components/blocks/composite/Pager.astro';
import ApiReferenceTable from '~/components/meta/ApiReferenceTable.astro';

const metadata = { title: { default: 'Pager' } };

const prev = { href: '/documentation/composite/NavigationTreeHorizontal' };
const next = { href: '/documentation/composite/PostCard' };
---

<Layout
  metadata={metadata}
  headline={{
    tagline: 'Composite',
    title: 'Pager',
    subtitle: 'A labelled previous / next navigation with the page title on each link.',
  }}
>
  <h3>1. Previous and next</h3>
  <p>
    <code>prevButton</code> and <code>nextButton</code> are Buttons; each renders when set. Its
    <code>subtitle</code> is the page title, shown under a small "Previous" or "Next".
  </p>
  <div data-doc-section="both">
    <PagerBlock
      prevButton={{ ...prev, subtitle: 'NavigationTreeHorizontal' }}
      nextButton={{ ...next, subtitle: 'PostCard' }}
    />
  </div>

  <h3>2. Next only</h3>
  <p>
    A lone next link sits at the inline end: right in left-to-right text, left in right-to-left.
  </p>
  <div data-doc-section="lone-next">
    <PagerBlock nextButton={{ ...next, subtitle: 'PostCard' }} />
  </div>

  <h3>3. Previous only</h3>
  <p>A lone previous link sits at the inline start.</p>
  <div data-doc-section="lone-prev">
    <PagerBlock prevButton={{ ...prev, subtitle: 'NavigationTreeHorizontal' }} />
  </div>

  <h3>4. Long titles</h3>
  <p>The row wraps, and a long title wraps inside its link.</p>
  <div data-doc-section="long-titles">
    <PagerBlock
      prevButton={{
        ...prev,
        subtitle: 'A horizontal navigation bar with dropdown groups for the main site sections',
      }}
      nextButton={{
        ...next,
        subtitle: 'A blog post card with its cover, date, reading time, excerpt and every tag',
      }}
    />
  </div>

  <h3>5. Custom labels</h3>
  <p>
    <code>ariaLabel</code> names the landmark; each link's <code>label</code> replaces the built-in
    text. <code>defaultButtonConfig</code> is merged under both links.
  </p>
  <div data-doc-section="custom-labels">
    <PagerBlock
      ariaLabel="Documentation pages"
      prevButton={{ ...prev, label: 'Back', subtitle: 'NavigationTreeHorizontal' }}
      nextButton={{ ...next, label: 'Continue', subtitle: 'PostCard' }}
      defaultButtonConfig={{ intent: 'primary' }}
    />
  </div>

  <h3>6. Slot</h3>
  <p>
    The default slot renders between the links. Here the row is centred, and
    <code>class: 'ms-0'</code> on <code>nextButton</code> cancels its inline-end default.
  </p>
  <div data-doc-section="slot">
    <PagerBlock
      class="justify-center"
      prevButton={{ ...prev }}
      nextButton={{ ...next, class: 'ms-0' }}
    >
      <p class="m-0 text-sm text-emphasis">Page 2 of 3</p>
    </PagerBlock>
  </div>

  <ApiReferenceTable component="Pager" category="composite" />
</Layout>
