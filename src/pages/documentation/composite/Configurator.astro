---
import Layout from '../_layouts/Layout.astro';
import ConfiguratorBlock from '~/components/blocks/composite/Configurator.astro';
import ApiReferenceTable from '~/components/meta/ApiReferenceTable.astro';
import type { ConfiguratorProps } from '~/types/configurator.types';

const metadata = {
  title: {
    default: 'Configurator',
  },
};

const modelViewer: ConfiguratorProps['modelViewer'] = {
  src: '/models/ring.glb',
  label: 'A configurable ring',
  class: 'rounded-lg bg-surface',
  height: '320px',
  cameraPresets: { band: { position: [0, -0.9, 2.4], target: [0, -0.6, 0], fov: 35 } },
};

const metalOptions = [
  {
    code: 'yellow',
    label: 'Yellow gold',
    selected: true,
    mutations: [{ type: 'material', material: 'Band', color: '#e6b422', roughness: 0.3 }],
  },
  {
    code: 'white',
    label: 'White gold',
    mutations: [{ type: 'material', material: 'Band', color: '#e5e4e2', roughness: 0.2 }],
  },
  {
    code: 'rose',
    label: 'Rose gold',
    mutations: [{ type: 'material', part: 'Band', use: 'RoseGold' }],
  },
] satisfies Extract<ConfiguratorProps['categories'][number], { panel: 'toggle' }>['options'];

const togglePanels: ConfiguratorProps['categories'] = [
  {
    name: 'configurator-doc-metal',
    panel: 'toggle',
    triggerButton: { label: 'Metal' },
    heading: 'Choose your metal',
    options: metalOptions,
  },
  {
    name: 'configurator-doc-engraving',
    panel: 'text',
    triggerButton: { label: 'Engraving' },
    heading: 'Add an engraving',
    camera: 'band',
    textArea: { maxLength: 20, placeholder: 'Up to 20 characters' },
  },
];

const stoneOptions = [
  {
    code: 'small',
    title: '0.25 ct',
    mutations: [{ type: 'visible', parts: ['Stone_Small'] }],
  },
  {
    code: 'medium',
    title: '0.5 ct',
    selected: true,
    mutations: [{ type: 'visible', parts: ['Stone_Medium'] }],
  },
  {
    code: 'large',
    title: '1 ct',
    mutations: [{ type: 'visible', parts: ['Stone_Large'] }],
  },
] satisfies Extract<ConfiguratorProps['categories'][number], { panel: 'grid' }>['options'];

const gridPanels: ConfiguratorProps['categories'] = [
  {
    name: 'configurator-doc-stone',
    panel: 'grid',
    mode: 'single',
    triggerButton: { label: 'Stone' },
    heading: 'Choose a stone size',
    options: stoneOptions,
  },
  {
    name: 'configurator-doc-extras',
    panel: 'grid',
    mode: 'multiple',
    max: 2,
    triggerButton: { label: 'Extras' },
    heading: 'Add up to two extras',
    options: [
      { code: 'giftbox', title: 'Gift box' },
      { code: 'certificate', title: 'Certificate' },
      { code: 'polish', title: 'Lifetime polish' },
    ],
  },
];

const layeredPanels: ConfiguratorProps['categories'] = [
  {
    name: 'configurator-doc-layered-metal',
    panel: 'toggle',
    triggerButton: { label: 'Metal' },
    heading: 'Radio rows from defaultToggleGroupConfig',
    options: metalOptions,
  },
  {
    name: 'configurator-doc-layered-style',
    panel: 'toggle',
    triggerButton: { label: 'Style' },
    heading: 'Outline cells from this category’s config',
    options: [
      {
        code: 'classic',
        label: 'Classic',
        selected: true,
        mutations: [{ type: 'model', src: '/models/ring.glb' }],
      },
      { code: 'bold', label: 'Bold', mutations: [{ type: 'model', src: '/models/ring-alt.glb' }] },
    ],
    toggleGroup: { appearance: 'cell', variant: 'outline' },
  },
];

const intentPanels = (prefix: string): ConfiguratorProps['categories'] => [
  {
    name: `${prefix}-metal`,
    panel: 'toggle',
    triggerButton: { label: 'Metal' },
    heading: 'Choose your metal',
    options: metalOptions,
  },
  {
    name: `${prefix}-stone`,
    panel: 'grid',
    mode: 'single',
    triggerButton: { label: 'Stone' },
    heading: 'Choose a stone size',
    options: stoneOptions,
  },
  {
    name: `${prefix}-engraving`,
    panel: 'text',
    triggerButton: { label: 'Engraving' },
    heading: 'Add an engraving',
    textArea: { maxLength: 20 },
  },
];

const panelClassPanels: ConfiguratorProps['categories'] = [
  {
    name: 'configurator-doc-panel-class-metal',
    panel: 'toggle',
    triggerButton: { label: 'Metal' },
    heading: 'Choose your metal',
    options: metalOptions,
  },
  {
    name: 'configurator-doc-panel-class-engraving',
    panel: 'text',
    triggerButton: { label: 'Engraving' },
    heading: 'Add an engraving',
    textArea: { maxLength: 20 },
  },
];

const framedPanels: ConfiguratorProps['categories'] = [
  {
    name: 'configurator-doc-framed-metal',
    panel: 'toggle',
    triggerButton: { label: 'Metal' },
    heading: 'Choose your metal',
    options: metalOptions,
  },
  {
    name: 'configurator-doc-framed-stone',
    panel: 'grid',
    mode: 'single',
    triggerButton: { label: 'Stone' },
    heading: 'Choose a stone size',
    options: [
      { code: 'small', title: '0.25 ct', mutations: [{ type: 'visible', parts: ['Stone_Small'] }] },
      {
        code: 'medium',
        title: '0.5 ct',
        selected: true,
        mutations: [{ type: 'visible', parts: ['Stone_Medium'] }],
      },
      { code: 'large', title: '1 ct', mutations: [{ type: 'visible', parts: ['Stone_Large'] }] },
    ],
  },
];

const headlinePanels: ConfiguratorProps['categories'] = [
  {
    name: 'configurator-doc-headline-metal',
    panel: 'toggle',
    triggerButton: { label: 'Metal' },
    heading: 'Choose your metal',
    options: metalOptions,
  },
];

const headingPanels: ConfiguratorProps['categories'] = [
  {
    name: 'configurator-doc-heading-metal',
    panel: 'toggle',
    heading: 'Choose your metal',
    options: metalOptions,
  },
  {
    name: 'configurator-doc-heading-engraving',
    panel: 'text',
    triggerButton: { label: 'Engraving' },
    heading: 'Engrave your ring',
    fieldLabel: 'Engraving',
    textArea: { maxLength: 20, placeholder: 'Up to 20 characters' },
  },
];

const describedPanels: ConfiguratorProps['categories'] = [
  {
    name: 'configurator-doc-described-engraving',
    panel: 'text',
    heading: 'Add an engraving',
    textArea: {
      help: 'Engraved in capitals.',
      maxLength: 20,
      showCounter: true,
      'aria-describedby': 'configurator-doc-engraving-note',
    },
  },
];

const urlStateExample = `<Configurator
  categories={categories}
  modelViewer={modelViewer}
  urlState={{ product: 'RING01' }}
/>
<!-- ?code=RING01-bold-large-rose-vvs1-giftbox-Mia -->`;
---

<Layout
  metadata={metadata}
  headline={{
    tagline: 'Composite',
    title: 'Configurator',
    subtitle: 'A product configurator assembled from ModelViewer, Tabs and selection blocks',
  }}
>
  <p>
    Configurator puts a ModelViewer and a live summary in the left column and a tabbed choice panel
    in the right one. Each category becomes one tab and one selection group: a
    <code>toggle</code> category renders a ToggleGroup, a <code>grid</code> category an ItemsGrid in selection
    mode, and a <code>text</code> category a TextArea. Options carry the scene
    <code>mutations</code> they apply, so the viewer's <code>selections</code> map is built for you. See
    the <a href="/demos/jewellery-configurator">jewellery configurator demo</a> for the full experience.
  </p>

  <h3>Category types</h3>
  <p>
    <code>ConfiguratorToggleCategory</code> (<code>panel: 'toggle'</code>) takes ToggleGroup
    <code>options</code>. <code>ConfiguratorGridCategory</code> (<code>panel: 'grid'</code>) takes
    ItemsGrid items as <code>options</code>, each with a required <code>code</code>, and a
    <code>mode</code> of <code>'single'</code> or <code>'multiple'</code>; <code>min</code> and
    <code>max</code> exist only for <code>'multiple'</code>. <code>ConfiguratorTextCategory</code>
    (<code>panel: 'text'</code>) takes <code>value</code> and an optional <code>fieldLabel</code>;
    without it the heading names the field and no label is shown. <code>maxLength</code>,
    <code>placeholder</code> and every other TextArea prop or native <code>&lt;textarea&gt;</code>
    attribute go in <code>textArea</code>. Every category has a <code>name</code> (its selection group),
    a <code>heading</code> that names the panel, an optional <code>triggerButton</code> Button config
    for its tab (its <code>label</code> defaults to the heading), and an optional <code>camera</code
    > key of <code>modelViewer.cameraPresets</code>. A category's panel config goes in <code
      >toggleGroup</code
    >, <code>itemsGrid</code> or <code>textArea</code>, matching its <code>panel</code>. The rule: a
    category holds what Configurator reads or assembles (<code>name</code>, <code>panel</code>, <code
      >heading</code
    >, <code>camera</code>,
    <code>triggerButton</code>, <code>options</code>, <code>value</code>, <code>mode</code> /
    <code>min</code> / <code>max</code>, <code>fieldLabel</code>); everything passed to the child
    untouched goes in <code>toggleGroup</code>, <code>itemsGrid</code> or <code>textArea</code>. A
    configurator holds at most 12 categories.
  </p>

  <h3>1. Toggle and text panels</h3>
  <p>
    The metal toggle recolours the band. Typing an engraving moves the camera to the
    <code>band</code> preset, because the text category sets <code>camera</code>.
  </p>
  <div data-doc-section="toggle-text" class="border border-dashed border-gray/80 p-8">
    <ConfiguratorBlock categories={togglePanels} modelViewer={modelViewer} />
  </div>

  <h3>2. Grid panels</h3>
  <p>
    A <code>'single'</code> grid switches which stone is visible. A <code>'multiple'</code> grid with
    <code>max: 2</code> disables the remaining option once two are selected.
  </p>
  <div data-doc-section="grid" class="border border-dashed border-gray/80 p-8">
    <ConfiguratorBlock categories={gridPanels} modelViewer={modelViewer} />
  </div>

  <h3>3. Defaults layering</h3>
  <p>
    Each panel's config is merged in three layers: the configurator's internal defaults, then the
    block-level <code>defaultToggleGroupConfig</code>, <code>defaultItemsGridConfig</code> or
    <code>defaultTextAreaConfig</code>, then the category's own <code>toggleGroup</code>,
    <code>itemsGrid</code> or <code>textArea</code>. The block-level defaults take any child prop
    except per-instance keys (<code>id</code>, <code>name</code>, <code>anchorId</code>), the fields
    Configurator fills from the category (toggle: <code>group</code>, <code>label</code>,
    <code>labelledBy</code>, <code>options</code>; grid: <code>items</code>, <code>selection</code>;
    text: <code>group</code>, <code>label</code>, <code>hideLabel</code>, <code>value</code>) and,
    in <code>defaultTextAreaConfig</code>, <code>error</code>. For example, <code>intent</code>
    (example 4) or <code>maxLength</code> and <code>placeholder</code> in
    <code>defaultTextAreaConfig</code>. A field set on a <code>triggerButton</code> applies in every state,
    so style the active tab through <code>tabs.activeItemConfig</code>. Triggers merge through Tabs:
    <code>tabs.defaultItemConfig</code> under every trigger, <code>tabs.activeItemConfig</code> over the
    active one, and each category's <code>triggerButton</code> last. Here
    <code>defaultToggleGroupConfig</code> asks for radio rows, the style category overrides it with outline
    cells, and <code>tabs.defaultItemConfig</code> makes every tab small and ghost; the active tab keeps
    the outlined style from the internal <code>tabs.activeItemConfig</code>.
  </p>
  <div data-doc-section="layering" class="border border-dashed border-gray/80 p-8">
    <ConfiguratorBlock
      categories={layeredPanels}
      modelViewer={modelViewer}
      defaultToggleGroupConfig={{ appearance: 'radio' }}
      tabs={{ defaultItemConfig: { size: 'sm', variant: 'ghost', intent: 'neutral' } }}
    />
  </div>

  <h3>4. One intent across panels</h3>
  <p>
    <code>intent</code> colours the selected state and focus ring of every panel kind. Setting it in
    <code>defaultToggleGroupConfig</code>, <code>defaultItemsGridConfig</code> and
    <code>defaultTextAreaConfig</code> gives toggle, grid and text panels the same colour. Tabs aren't
    panels: colour the active tab with <code>tabs.activeItemConfig</code>.
  </p>
  <div data-doc-section="intent" class="border border-dashed border-gray/80 p-8">
    <ConfiguratorBlock
      categories={intentPanels('configurator-doc-intent')}
      modelViewer={modelViewer}
      defaultToggleGroupConfig={{ intent: 'accent' }}
      defaultItemsGridConfig={{ intent: 'accent' }}
      defaultTextAreaConfig={{ intent: 'accent' }}
      tabs={{ activeItemConfig: { intent: 'accent' } }}
    />
  </div>

  <h3>4b. Neutral intent</h3>
  <p><code>neutral</code> selects with the emphasis colour in every panel kind.</p>
  <div data-doc-section="intent-neutral" class="border border-dashed border-gray/80 p-8">
    <ConfiguratorBlock
      categories={intentPanels('configurator-doc-intent-neutral')}
      modelViewer={modelViewer}
      defaultToggleGroupConfig={{ intent: 'neutral', variant: 'solid' }}
      defaultItemsGridConfig={{ intent: 'neutral' }}
      defaultTextAreaConfig={{ intent: 'neutral' }}
      tabs={{ activeItemConfig: { intent: 'neutral' } }}
    />
  </div>

  <h3>5. Summary</h3>
  <p>
    The line under the viewer is derived from the current selections. By default it lists the label
    of every selected option: toggle options by <code>label</code>, grid options by <code
      >title</code
    >
    (falling back to <code>code</code>). Categories appear in tab order and options in declaration
    order, whatever order they were picked in. Text is shown in quotes, empty categories are
    skipped, and the parts are joined with <code>·</code>. <code>summary.categories</code> and
    <code>summary.separator</code> change which categories are listed, their order and the joiner (example
    7). The summary is an <code>aria-live="polite"</code> region, so screen readers announce changes.
  </p>

  <h3>6. URL state</h3>
  <p>
    Set <code>urlState</code> to keep the selections in the page URL as a combination code, so a configuration
    can be shared or bookmarked and the back button steps through changes. The code lists the categories
    in tab order, with an optional leading <code>product</code> segment; the query parameter defaults
    to <code>code</code> and can be changed with <code>param</code>. Only the first configurator
    with <code>urlState</code> on a page binds to the URL, so this page leaves it off.
  </p>
  <p>
    <strong>Append categories only.</strong> Once codes are shared, never remove or reorder categories,
    or old codes will decode into the wrong groups. Option codes and <code>product</code> must match
    <code>[A-Za-z0-9]+</code>.
  </p>
  <pre
    class="bg-surface p-4 rounded overflow-x-auto text-sm border border-border"><code>{urlStateExample}</code></pre>

  <h3>7. Title, summary and actions</h3>
  <p>
    <code>headline.title</code> names the product under the viewer, and <code>actions</code> renders Buttons
    under the summary line. <code>summary.categories</code> picks which categories the summary lists and
    in which order, <code>summary.separator</code> joins them, and <code>summaryClass</code>
    styles the line. URL state and the viewer still use every category. Here the summary lists only the
    stone, so the metal is left out of it.
  </p>
  <div data-doc-section="framed" class="border border-dashed border-gray/80 p-8">
    <ConfiguratorBlock
      categories={framedPanels}
      modelViewer={modelViewer}
      headline={{ title: 'Solitaire' }}
      summary={{ categories: ['configurator-doc-framed-stone'], separator: ' ' }}
      summaryClass="mt-1 text-sm uppercase tracking-widest text-muted"
      actions={[{ label: 'Save my design', variant: 'outline', intent: 'neutral' }]}
    />
  </div>

  <h3>8. Headline and shared action config</h3>
  <p>
    <code>headline</code> renders a full Headline under the viewer.
    <code>defaultActionConfig</code> is merged under every action, and <code>actionsClass</code>
    styles the wrapper around them. Style the left column through <code
      >twoColumnContainer.leftColumn.class</code
    >
    and the panels through <code>tabs.panelClass</code>.
  </p>
  <div data-doc-section="headline-actions" class="border border-dashed border-gray/80 p-8">
    <ConfiguratorBlock
      categories={headlinePanels}
      modelViewer={modelViewer}
      headline={{ tagline: 'Ring', title: 'Solitaire', subtitle: 'Hand-set in Antwerp' }}
      defaultActionConfig={{ variant: 'outline', intent: 'neutral' }}
      actionsClass="flex"
      actions={[{ label: 'Save my design' }, { label: 'Share' }]}
    />
  </div>

  <h3>9. Heading and field label</h3>
  <p>
    <code>headingClass</code> adds classes to every panel heading, after its defaults. A text category
    with <code>fieldLabel</code> shows that label above its field, while the heading stays the panel's
    name. A category without <code>triggerButton</code> uses its heading as the tab label, as the metal
    tab here does; set <code>{"triggerButton: { label: 'Metal' }"}</code> for a short tab.
  </p>
  <div data-doc-section="headings" class="border border-dashed border-gray/80 p-8">
    <ConfiguratorBlock
      categories={headingPanels}
      modelViewer={modelViewer}
      headingClass="text-xs uppercase tracking-[0.2em]"
    />
  </div>

  <h3>10. Extra field description</h3>
  <p>
    A native <code>aria-describedby</code> in <code>textArea</code> is added after the field's own help
    and counter.
  </p>
  <div data-doc-section="described" class="border border-dashed border-gray/80 p-8">
    <p id="configurator-doc-engraving-note">Engraving takes two working days.</p>
    <ConfiguratorBlock categories={describedPanels} modelViewer={modelViewer} />
  </div>

  <h3>11. Panel layout</h3>
  <p>
    <code>tabs.panelClass</code> lays out each panel's heading and control, which are its direct children.
  </p>
  <div data-doc-section="panel-class" class="border border-dashed border-gray/80 p-8">
    <ConfiguratorBlock
      categories={panelClassPanels}
      modelViewer={modelViewer}
      headingClass="mb-0"
      tabs={{ panelClass: 'flex flex-col gap-4' }}
    />
  </div>

  <ApiReferenceTable component="Configurator" category="composite" />
</Layout>
