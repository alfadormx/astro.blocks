---
import Layout from '../_layouts/Layout.astro';
import ItemsGridBlock from '~/components/blocks/composite/ItemsGrid.astro';
import ApiReferenceTable from '~/components/meta/ApiReferenceTable.astro';

const metadata = {
  title: {
    default: 'Items Grid and Item',
  },
};
---

<Layout
  metadata={metadata}
  headline={{
    tagline: 'Composite',
    title: 'Items Grid and Item',
    subtitle: 'Showcase of the ItemsGrid composite block with various Item configurations',
  }}
>
  <p>
    ItemsGrid sizes its columns from the width of the element that contains it, not from the
    viewport. A grid asks for at most <code>columns</code> columns and steps down when its container is
    too narrow to fit them: two columns from <code>32rem</code>, three from
    <code>48rem</code>, four from <code>64rem</code>. The same grid therefore renders three columns
    in a full-width section and one in a sidebar, with no change at the call site.
  </p>

  <h3>1. Basic grid (no defaultItemConfig)</h3>
  <div data-doc-section="basic">
    <ItemsGridBlock
      columns={3}
      items={[
        {
          icon: { name: 'heroicons:sun' },
          title: 'No customization',
          content: 'Icon configuration is default.',
        },
        {
          icon: {
            name: 'heroicons:sparkles',
            class: 'bg-accent text-background p-2 rounded-full',
          },
          title: 'Icon customization',
          content: 'Icon as been given a background, padding and rounded corners.',
        },
        {
          icon: { name: 'heroicons:bolt', class: 'text-success' },
          title: 'Vertical Layout with action',
          content: 'You shall see a button below.',
          actions: [{ label: 'Learn More', intent: 'success' }],
        },
        {
          icon: { name: 'heroicons:sun' },
          title: 'No customization',
          content: 'Icon configuration is default.',
          layout: 'horizontal',
        },
        {
          icon: {
            name: 'heroicons:sparkles',
            class: 'bg-accent text-background p-2 rounded-full',
          },
          title: 'Icon customization',
          content: 'Icon as been given a background, padding and rounded corners.',
          layout: 'horizontal',
        },
        {
          icon: { name: 'heroicons:bolt', class: 'text-success' },
          title: 'Horizontal Layout with action',
          content: 'You shall see a button below.',
          actions: [{ label: 'Learn More', intent: 'success' }],
          layout: 'horizontal',
        },
      ]}
    />
  </div>

  <h3>2. Grid with default layout and action</h3>
  <ItemsGridBlock
    columns={2}
    defaultItemConfig={{
      layout: 'horizontal',
      actions: [{ label: 'Default Action', intent: 'accent' }],
    }}
    items={[
      {
        icon: { name: 'heroicons:star' },
        title: 'Default layout & action',
        content: 'This item uses the default horizontal layout and action.',
      },
      {
        icon: { name: 'heroicons:fire', class: 'text-error' },
        title: 'Override action',
        content: 'This item overrides the default action.',
        actions: [{ label: 'Custom Action', intent: 'error' }],
      },
      {
        icon: { name: 'heroicons:moon' },
        title: 'Default layout & action',
        content: 'This item uses the default horizontal layout and action.',
      },
    ]}
  />

  <h3>3. The same grid in a narrow container</h3>
  <p>
    Both grids below are <code>columns={3}</code> with identical items. The second one sits in a
    <code>max-w-sm</code> wrapper, so it stacks to a single column at any viewport width.
  </p>
  <ItemsGridBlock
    columns={3}
    items={[
      {
        icon: { name: 'heroicons:sun' },
        title: 'Wide container',
        content: 'Three columns once the container passes 48rem.',
      },
      {
        icon: { name: 'heroicons:sparkles' },
        title: 'Wide container',
        content: 'Three columns once the container passes 48rem.',
      },
      {
        icon: { name: 'heroicons:bolt' },
        title: 'Wide container',
        content: 'Three columns once the container passes 48rem.',
      },
    ]}
  />
  <div class="max-w-sm">
    <ItemsGridBlock
      columns={3}
      items={[
        {
          icon: { name: 'heroicons:sun' },
          title: 'Narrow container',
          content: 'Same columns, but the container is under 32rem.',
        },
        {
          icon: { name: 'heroicons:sparkles' },
          title: 'Narrow container',
          content: 'Same columns, but the container is under 32rem.',
        },
        {
          icon: { name: 'heroicons:bolt' },
          title: 'Narrow container',
          content: 'Same columns, but the container is under 32rem.',
        },
      ]}
    />
  </div>

  <h3>4. Single selection</h3>
  <p>
    With <code>{"selection={{ mode: 'single', group, label }}"}</code> every item becomes an option. Each
    item needs a <code>code</code>, the value published to the group; <code>selected: true</code>
    marks the option chosen on load. Options cannot carry <code>actions</code>.
  </p>
  <ItemsGridBlock
    columns={3}
    selection={{ mode: 'single', group: 'itemsgrid-doc-single', label: 'Size' }}
    items={[
      { code: 'size-s', icon: { name: 'heroicons:cube' }, title: 'Small', content: '30 × 30 cm' },
      {
        code: 'size-m',
        icon: { name: 'heroicons:cube' },
        title: 'Medium',
        content: '45 × 45 cm',
        selected: true,
      },
      { code: 'size-l', icon: { name: 'heroicons:cube' }, title: 'Large', content: '60 × 60 cm' },
    ]}
  />

  <h3>5. Multiple selection with min/max</h3>
  <p>
    <code>mode: 'multiple'</code> turns each option into a checkbox. <code>max</code> disables the remaining
    options once reached; <code>min</code> refuses a deselect that would drop below it. An initial state
    below <code>min</code> is allowed — nothing is selected implicitly.
  </p>
  <ItemsGridBlock
    columns={4}
    selection={{
      mode: 'multiple',
      group: 'itemsgrid-doc-multiple',
      label: 'Extras',
      min: 1,
      max: 2,
    }}
    items={[
      { code: 'wifi', icon: { name: 'heroicons:wifi' }, title: 'Wi-Fi', selected: true },
      { code: 'parking', icon: { name: 'heroicons:truck' }, title: 'Parking' },
      { code: 'breakfast', icon: { name: 'heroicons:cake' }, title: 'Breakfast' },
      { code: 'pool', icon: { name: 'heroicons:sun' }, title: 'Pool' },
    ]}
  />

  <h3 id="itemsgrid-custom-heading">6. Custom selectedItemConfig</h3>
  <p>
    <code>selectedItemConfig</code> is merged into every option's selected variant after
    <code>defaultItemConfig</code> and before the item itself, like <code>activeTabConfig</code> in Tabs.
    This grid is named by the heading above via <code>labelledBy</code>.
  </p>
  <ItemsGridBlock
    columns={3}
    selection={{
      mode: 'single',
      group: 'itemsgrid-doc-custom',
      labelledBy: 'itemsgrid-custom-heading',
    }}
    defaultItemConfig={{ spacing: { padding: 'p-4' }, border: { radius: 'rounded-lg' } }}
    selectedItemConfig={{
      background: { class: 'bg-accent/10' },
      border: { color: 'border-accent' },
    }}
    items={[
      { code: 'oak', icon: { name: 'heroicons:swatch' }, title: 'Oak', selected: true },
      { code: 'walnut', icon: { name: 'heroicons:swatch' }, title: 'Walnut' },
      { code: 'ash', icon: { name: 'heroicons:swatch' }, title: 'Ash' },
    ]}
  />

  <h3>7. Listening to selection:change</h3>
  <p>
    The grid publishes to the selection runtime; anything on the page can read it with
    <code>subscribe(group, listener)</code> or a <code>selection:change</code> listener on
    <code>document</code>. Other publishers to the same group update the grid too — the button below
    sits outside the grid, in its own element declaring the same group.
  </p>
  <ItemsGridBlock
    columns={3}
    selection={{ mode: 'single', group: 'itemsgrid-doc-events', label: 'Delivery' }}
    items={[
      { code: 'standard', icon: { name: 'heroicons:truck' }, title: 'Standard' },
      { code: 'express', icon: { name: 'heroicons:bolt' }, title: 'Express' },
      { code: 'pickup', icon: { name: 'heroicons:building-storefront' }, title: 'Pickup' },
    ]}
  />
  <div
    data-selection-group="itemsgrid-doc-events"
    data-selection-mode="single"
    class="mt-4 flex items-center gap-4"
  >
    <button
      type="button"
      data-selection-external="pickup"
      class="px-3 py-1 border border-border rounded"
    >
      Select Pickup externally
    </button>
    <output data-selection-log class="font-mono text-sm">No change yet</output>
  </div>

  <h3>Selection props</h3>
  <p>
    <code>selection</code> is an <code>ItemsGridSelection</code>: <code>{"{ mode: 'none' }"}</code>
    (default, a static grid with no roles or script), <code
      >{"{ mode: 'single', group, label?, labelledBy? }"}</code
    >, or <code>{"{ mode: 'multiple', group, label?, labelledBy?, min?, max? }"}</code>. One of
    <code>label</code> / <code>labelledBy</code> is required; <code>labelledBy</code> wins. Items are
    <code>ItemsGridItem</code>s — Item props plus <code>code</code> (required when selection is enabled,
    unique within the grid) and <code>selected</code> (initial state). Invalid configurations throw at
    build time.
  </p>

  <ApiReferenceTable component="ItemsGrid" category="composite" />
</Layout>

<script>
  import { publish, subscribe } from '~/utils/selection';

  const GROUP = 'itemsgrid-doc-events';

  function initLog(): void {
    const log = document.querySelector<HTMLOutputElement>('[data-selection-log]');
    const button = document.querySelector<HTMLButtonElement>('[data-selection-external]');
    if (!log || !button) return;
    subscribe(GROUP, (detail) => (log.textContent = JSON.stringify(detail)));
    // onclick, not addEventListener: re-running initLog replaces the handler instead of stacking it.
    button.onclick = () => publish(button, [{ code: button.dataset.selectionExternal! }]);
  }

  document.addEventListener('astro:after-swap', initLog);
  initLog();
</script>
