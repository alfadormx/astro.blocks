---
import type {
  ConfiguratorItemsGrid,
  ConfiguratorProps,
  ConfiguratorTextArea,
  ConfiguratorToggleGroup,
  SummaryFormat,
} from '~/types/configurator.types';
import type { ItemsGridSelection } from '~/types/itemsgrid.types';
import type { TabsProps } from '~/types/tabs.types';
import type { TwoColumnContainerProps } from '~/types/container.types';
import type { HeadlineProps } from '~/types/headline.types';
import type { ButtonProps } from '~/types/button.types';
import TwoColumnContainer from '~/components/blocks/layout/TwoColumnContainer.astro';
import Tabs from '~/components/blocks/composite/Tabs.astro';
import ConfiguratorPanel from '~/components/blocks/composite/ConfiguratorPanel.astro';
import ModelViewer from '~/components/blocks/primitives/ModelViewer.astro';
import Button from '~/components/blocks/primitives/Button.astro';
import Headline from '~/components/blocks/primitives/Headline.astro';
import { mergeConfigs } from '~/utils/mergeConfigs';
import { cn } from '~/utils/styles';
import {
  buildCombinationSpec,
  buildSummaryModel,
  buildViewerSelections,
  configuratorId,
  formatSummary,
  initialSelections,
  stripMutations,
  validateConfigurator,
} from '~/utils/configurator';

type Props = ConfiguratorProps;

const {
  categories,
  modelViewer,
  defaultItemsGridConfig,
  defaultToggleGroupConfig,
  defaultTextAreaConfig,
  tabs,
  twoColumnContainer,
  urlState,
  headingClass = '',
  headline,
  actions = [],
  defaultActionConfig,
  actionsClass,
  summary,
  summaryClass,
  class: className = '',
} = Astro.props;

validateConfigurator({ categories, modelViewer, urlState, summary });

const id = configuratorId();

const internalTwoColumnContainer: TwoColumnContainerProps = {
  htmlTag: 'div',
  content: { air: 'none', widthType: 'full' },
  responsive: true,
};
const internalTabs: Omit<TabsProps, 'items'> = {
  tabList: { layout: 'grid', spacing: { margin: 'mb-6' } },
  defaultItemConfig: { width: 'full' },
  activeItemConfig: { variant: 'outline', intent: 'primary' },
  container: { htmlTag: 'div', content: { air: 'none', widthType: 'full' } },
};
const internalToggle: ConfiguratorToggleGroup = { appearance: 'cell' };
const internalGrid: ConfiguratorItemsGrid = { columns: 3, gap: 'tight' };
const internalText: ConfiguratorTextArea = { rows: 2 };
const internalHeadline: HeadlineProps = {
  class: 'mt-6 mb-0',
  titleClass: 'text-2xl font-semibold',
};

const mergedTwoColumnContainer = mergeConfigs<TwoColumnContainerProps>(
  {},
  internalTwoColumnContainer,
  twoColumnContainer
);
const mergedTabs = mergeConfigs<Omit<TabsProps, 'items'>>({}, internalTabs, tabs);
const mergedHeadline = mergeConfigs<HeadlineProps>({}, internalHeadline, headline);
const triggers = categories.map((category) =>
  mergeConfigs<Omit<ButtonProps, 'id' | 'name'>>(
    {},
    { label: category.heading },
    category.triggerButton
  )
);

// `options` / `items` stay out of the merge layers: mergeConfigs merges arrays index-wise.
const panels = categories.map((category, i) => {
  const headingId = `${id}-heading-${i}`;
  const base = { heading: category.heading, headingId, headingClass };
  if (category.panel === 'toggle') {
    return {
      ...base,
      kind: 'toggle' as const,
      props: {
        ...mergeConfigs<ConfiguratorToggleGroup>(
          {},
          internalToggle,
          defaultToggleGroupConfig,
          category.toggleGroup
        ),
        group: category.name,
        labelledBy: headingId,
        options: category.options.map(stripMutations),
      },
    };
  }
  if (category.panel === 'grid') {
    const { intent, ...gridConfig } = mergeConfigs<ConfiguratorItemsGrid>(
      {},
      internalGrid,
      defaultItemsGridConfig,
      category.itemsGrid
    );
    const selection: ItemsGridSelection =
      category.mode === 'multiple'
        ? {
            mode: 'multiple',
            group: category.name,
            labelledBy: headingId,
            min: category.min,
            max: category.max,
            intent,
          }
        : { mode: 'single', group: category.name, labelledBy: headingId, intent };
    return {
      ...base,
      kind: 'grid' as const,
      props: { ...gridConfig, items: category.options.map(stripMutations), selection },
    };
  }
  return {
    ...base,
    kind: 'text' as const,
    props: {
      ...mergeConfigs<ConfiguratorTextArea>(
        {},
        internalText,
        defaultTextAreaConfig,
        category.textArea
      ),
      group: category.name,
      label: category.fieldLabel || category.heading,
      hideLabel: !category.fieldLabel,
      value: category.value,
    },
  };
});

const selections = buildViewerSelections(categories);
const summaryModel = buildSummaryModel(categories);
const summaryFormat: SummaryFormat = {
  categories: summary?.categories,
  separator: summary?.separator,
};
const summaryText = formatSummary(summaryModel, initialSelections(categories), summaryFormat);
const spec = urlState ? buildCombinationSpec(categories, urlState.product) : undefined;
---

<div
  class={cn(className)}
  data-configurator
  data-configurator-url-state={spec ? JSON.stringify(spec) : undefined}
  data-configurator-url-param={urlState?.param}
>
  <TwoColumnContainer {...mergedTwoColumnContainer}>
    <div slot="left">
      <ModelViewer {...modelViewer} selections={selections} />
      {mergedHeadline.title && <Headline {...mergedHeadline} />}
      <p
        class={cn('mt-4 text-lg', summaryClass)}
        aria-live="polite"
        data-configurator-summary
        data-configurator-labels={JSON.stringify(summaryModel)}
        data-configurator-summary-format={JSON.stringify(summaryFormat)}
      >
        {summaryText}
      </p>
      {
        actions.length > 0 && (
          <div class={cn('mt-6 inline-flex flex-wrap gap-3', actionsClass)}>
            {actions.map((action) => (
              <Button {...mergeConfigs<ButtonProps>({}, defaultActionConfig, action)} />
            ))}
          </div>
        )
      }
    </div>
    <div slot="right">
      <Tabs {...mergedTabs} items={triggers}>
        {
          /* One static slot per possible tab: the compiler cannot give a slot inside .map() a name
            that depends on the callback's arguments. Tabs renders only the first items.length. */
        }
        <Fragment slot="panel-0">{panels[0] && <ConfiguratorPanel {...panels[0]} />}</Fragment>
        <Fragment slot="panel-1">{panels[1] && <ConfiguratorPanel {...panels[1]} />}</Fragment>
        <Fragment slot="panel-2">{panels[2] && <ConfiguratorPanel {...panels[2]} />}</Fragment>
        <Fragment slot="panel-3">{panels[3] && <ConfiguratorPanel {...panels[3]} />}</Fragment>
        <Fragment slot="panel-4">{panels[4] && <ConfiguratorPanel {...panels[4]} />}</Fragment>
        <Fragment slot="panel-5">{panels[5] && <ConfiguratorPanel {...panels[5]} />}</Fragment>
        <Fragment slot="panel-6">{panels[6] && <ConfiguratorPanel {...panels[6]} />}</Fragment>
        <Fragment slot="panel-7">{panels[7] && <ConfiguratorPanel {...panels[7]} />}</Fragment>
        <Fragment slot="panel-8">{panels[8] && <ConfiguratorPanel {...panels[8]} />}</Fragment>
        <Fragment slot="panel-9">{panels[9] && <ConfiguratorPanel {...panels[9]} />}</Fragment>
        <Fragment slot="panel-10">{panels[10] && <ConfiguratorPanel {...panels[10]} />}</Fragment>
        <Fragment slot="panel-11">{panels[11] && <ConfiguratorPanel {...panels[11]} />}</Fragment>
      </Tabs>
    </div>
  </TwoColumnContainer>
</div>

<script>
  import { getSelection, subscribe } from '~/utils/selection';
  import { connectUrlState } from '~/utils/urlState';
  import { formatSummary } from '~/utils/configurator';
  import type { CombinationSpec } from '~/types/combinationcode.types';
  import type { SummaryCategory, SummaryFormat } from '~/types/configurator.types';
  import type { Selection } from '~/types/selection.types';

  const ROOT_SELECTOR = '[data-configurator]';

  let disconnectUrlState: (() => void) | undefined;

  // No render on connect: the server rendered the summary from the same markup defaults the
  // blocks publish, and blocks may publish before or after this script runs.
  function connectSummary(root: HTMLElement): void {
    const output = root.querySelector<HTMLElement>('[data-configurator-summary]');
    if (!output) return;
    const model: SummaryCategory[] = JSON.parse(output.dataset.configuratorLabels!);
    const format: SummaryFormat = JSON.parse(output.dataset.configuratorSummaryFormat ?? '{}');
    const render = (): void => {
      const state: Record<string, readonly Selection[]> = {};
      for (const { name } of model) state[name] = getSelection(name);
      output.textContent = formatSummary(model, state, format);
    };
    for (const { name } of model) subscribe(name, render);
  }

  function connectUrl(): void {
    const roots = document.querySelectorAll<HTMLElement>('[data-configurator-url-state]');
    if (roots.length === 0) return;
    if (import.meta.env.DEV && roots.length > 1) {
      console.warn('[Configurator] only the first configurator with urlState is bound to the URL');
    }
    const spec: CombinationSpec = JSON.parse(roots[0].dataset.configuratorUrlState!);
    disconnectUrlState = connectUrlState({ spec, param: roots[0].dataset.configuratorUrlParam });
  }

  function init(): void {
    document.querySelectorAll<HTMLElement>(ROOT_SELECTOR).forEach((root) => {
      connectSummary(root);
      root.dataset.configuratorReady = '';
    });
    connectUrl();
  }

  // Registered before connectUrlState adds its own after-swap listener, so disposing here also
  // cancels that listener for this dispatch; the new page may have no configurator. The microtask
  // lets the block scripts' own after-swap listeners republish markup state first.
  document.addEventListener('astro:after-swap', () => {
    disconnectUrlState?.();
    disconnectUrlState = undefined;
    queueMicrotask(init);
  });
  init();
</script>
