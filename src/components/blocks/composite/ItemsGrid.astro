---
import type { ItemsGridItem, ItemsGridProps } from '~/types/itemsgrid.types';
import { cn } from '~/utils/styles';
import Item from '~/components/blocks/composite/Item.astro';
import SelectableItemsGrid from '~/components/blocks/composite/SelectableItemsGrid.astro';
import { mergeConfigs } from '~/utils/mergeConfigs';
import { gridColumnsClass, lastItemAlone } from '~/utils/itemsGrid';

type Props = ItemsGridProps;

const {
  items = [],
  columns = 3,
  responsive = true,
  fillLastRow = false,
  air = 'normal' as 'none' | 'tight' | 'normal' | 'loose',
  class: className = '',
  defaultItemConfig,
  selection = { mode: 'none' },
  selectedItemConfig,
} = Astro.props as Props;

const airSettings = {
  none: '',
  tight: 'gap-3 @3xl:gap-4 @5xl:gap-6',
  normal: 'gap-4 @3xl:gap-6 @5xl:gap-8',
  loose: 'gap-6 @3xl:gap-8 @5xl:gap-12',
} as const;

const baseGridClass = 'grid mx-auto';

const gridClass = cn(
  baseGridClass,
  gridColumnsClass(columns, responsive),
  airSettings[air as keyof typeof airSettings],
  className
);

const lastItemClass =
  fillLastRow && lastItemAlone(items.length, columns) ? 'col-span-full' : undefined;
---

<div class="@container">
  {
    selection.mode === 'none' ? (
      <div class={gridClass}>
        {items.map((item: ItemsGridItem, i: number) => {
          const mergedItem = mergeConfigs({}, defaultItemConfig || {}, item);
          return (
            <Item
              {...mergedItem}
              class={cn(mergedItem.class, i === items.length - 1 && lastItemClass)}
            />
          );
        })}
      </div>
    ) : (
      <SelectableItemsGrid
        items={items}
        defaultItemConfig={defaultItemConfig}
        selectedItemConfig={selectedItemConfig}
        selection={selection}
        gridClass={gridClass}
        lastItemClass={lastItemClass}
      />
    )
  }
</div>
