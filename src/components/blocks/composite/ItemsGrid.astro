---
import type { ItemsGridItem, ItemsGridProps } from '~/types/itemsgrid.types';
import { cn } from '~/utils/styles';
import Item from '~/components/blocks/composite/Item.astro';
import SelectableItemsGrid from '~/components/blocks/composite/SelectableItemsGrid.astro';
import { mergeConfigs } from '~/utils/mergeConfigs';

type Props = ItemsGridProps;

const {
  items = [],
  columns = 3,
  air = 'normal' as 'none' | 'tight' | 'normal' | 'loose',
  class: className = '',
  defaultItemConfig,
  selection = { mode: 'none' },
  selectedItemConfig,
} = Astro.props as Props;

const airSettings = {
  none: '',
  tight: 'gap-3 @3xl:gap-4 @5xl:gap-6',
  normal: 'gap-4 @3xl:gap-6 @5xl:gap-8',
  loose: 'gap-6 @3xl:gap-8 @5xl:gap-12',
} as const;

const baseGridClass = 'grid mx-auto';

const columnsClasses = {
  1: 'grid-cols-1',
  2: 'grid-cols-1 @lg:grid-cols-2',
  3: 'grid-cols-1 @lg:grid-cols-2 @3xl:grid-cols-3',
  4: 'grid-cols-1 @lg:grid-cols-2 @3xl:grid-cols-3 @5xl:grid-cols-4',
} as const;

const gridClass = cn(
  baseGridClass,
  columnsClasses[columns],
  airSettings[air as keyof typeof airSettings],
  className
);
---

<div class="@container">
  {
    selection.mode === 'none' ? (
      <div class={gridClass}>
        {items.map((item: ItemsGridItem) => {
          const mergedItem = mergeConfigs({}, defaultItemConfig || {}, item);
          return <Item {...mergedItem} />;
        })}
      </div>
    ) : (
      <SelectableItemsGrid
        items={items}
        defaultItemConfig={defaultItemConfig}
        selectedItemConfig={selectedItemConfig}
        selection={selection}
        gridClass={gridClass}
      />
    )
  }
</div>
