---
import type { ItemsGridItem, ItemsGridProps } from '~/types/itemsgrid.types';
import { cn } from '~/utils/styles';
import Item from '~/components/blocks/composite/Item.astro';
import SelectableItemsGrid from '~/components/blocks/composite/SelectableItemsGrid.astro';
import { mergeConfigs } from '~/utils/mergeConfigs';
import { gridColumnsClass, gridGapClass, lastItemAlone } from '~/utils/itemsGrid';

type Props = ItemsGridProps;

const {
  items = [],
  columns = 3,
  responsive = true,
  fillLastRow = false,
  gap = 'normal',
  class: className = '',
  defaultItemConfig,
  selection = { mode: 'none' },
  selectedItemConfig,
} = Astro.props as Props;

const baseGridClass = 'grid mx-auto';

const gridClass = cn(
  baseGridClass,
  gridColumnsClass(columns, responsive),
  gridGapClass(gap),
  className
);

const lastItemClass =
  fillLastRow && lastItemAlone(items.length, columns) ? 'col-span-full' : undefined;
---

<div class="@container">
  {selection.mode === 'none' ? (
    <div class={gridClass}>
      {items.map((item: ItemsGridItem, i: number) => {
        const mergedItem = mergeConfigs({}, defaultItemConfig || {}, item);
        return (
          <Item
            {...mergedItem}
            class={cn(i === items.length - 1 && lastItemClass, mergedItem.class)}
          />
        );
      })}
    </div>
  ) : (
    <SelectableItemsGrid
      items={items}
      defaultItemConfig={defaultItemConfig}
      selectedItemConfig={selectedItemConfig}
      selection={selection}
      gridClass={gridClass}
      lastItemClass={lastItemClass}
    />
  )}
</div>
