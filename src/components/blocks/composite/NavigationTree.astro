---
import type { ButtonProps } from '~/types/button.types';
import Button from '~/components/blocks/primitives/Button.astro';
import type { NavigationTreeItem, NavigationTreeProps } from '~/types/navigationtree.types';
import { mergeConfigs } from '~/utils/mergeConfigs';
import { cn } from '~/utils/styles';

type Props = NavigationTreeProps;

// Extract props
const {
  items,
  currentPath = Astro.url.pathname,
  level = 0,
  class: className = '',
  iconName = 'mdi:chevron-right',
  rotateIconOnExpand = true,
  defaultItemConfig,
  inactiveItemConfig,
  activeItemConfig,
  expansionStrategy = 'active-only',
  maxDepth = Infinity,
  toggleMode = 'button',
} = Astro.props;

const internalItemConfig: Partial<ButtonProps> = {
  variant: 'ghost',
  intent: 'neutral',
  width: 'full',
  iconPosition: 'left',
};

const internalActiveItemConfig: Partial<ButtonProps> = {
  variant: 'solid',
  intent: 'primary',
  width: 'full',
  iconPosition: 'left',
  class: 'font-semibold',
};

// Utility functions
const normalizePath = (path: string) => path.replace(/\/$/, '') || '/';
const normalizedCurrentPath = normalizePath(currentPath);

// Check if current item or any child is active
const isActiveOrHasActiveChild = (item: NavigationTreeItem): boolean => {
  if (item.href && normalizePath(item.href) === normalizedCurrentPath) {
    return true;
  }
  if (item.children) {
    return item.children.some((child) => isActiveOrHasActiveChild(child));
  }
  return false;
};

// Determine if children should be shown based on expansion strategy
const shouldShowChildren = (
  item: NavigationTreeItem,
  isActive: boolean,
  hasActiveChild: boolean
): boolean => {
  const hasChildren = item.children && item.children.length > 0;
  if (!hasChildren) return false;

  switch (expansionStrategy) {
    case 'always':
      return true;
    case 'active-only':
      return isActive || hasActiveChild;
    case 'first-level':
      return false;
    case 'depth':
      return level < maxDepth;
    case 'active-siblings':
      return isActive || hasActiveChild;
    case 'toggleable':
      // Will require JS implementation
      return isActive || hasActiveChild;
    default:
      return isActive || hasActiveChild;
  }
};

const buildItemConfig = (
  buttonProps: ButtonProps,
  isActive: boolean,
  hasChildren: boolean,
  isExpanded: boolean
): Partial<ButtonProps> => {
  return mergeConfigs<Partial<ButtonProps>>(
    {},
    { class: 'justify-start' },
    isActive ? internalActiveItemConfig : internalItemConfig,
    defaultItemConfig,
    isActive ? activeItemConfig : inactiveItemConfig,
    hasChildren
      ? {
          icon: {
            name: iconName,
            class: cn(
              'nav-tree-icon',
              toggleMode === 'icon' && 'cursor-pointer',
              toggleMode === 'icon' && isExpanded && rotateIconOnExpand && 'nav-tree-icon-expanded'
            ),
          },
        }
      : {},
    buttonProps
  );
};
---

<nav class={className} data-navigation-tree data-expansion-strategy={expansionStrategy}>
  <ul class="list-none m-0 p-0 space-y-1">
    {items.map((item) => {
      const { children, ...buttonProps } = item;
      const isActive = item.href ? normalizePath(item.href) === normalizedCurrentPath : false;
      const hasActiveChild = children
        ? children.some((child) => isActiveOrHasActiveChild(child))
        : false;
      const hasChildren = children && children.length > 0;
      const isExpanded = shouldShowChildren(item, isActive, hasActiveChild);

      const itemConfig = buildItemConfig(buttonProps, isActive, !!hasChildren, isExpanded);
      const isDisclosure = hasChildren && toggleMode === 'button';
      const subtree = hasChildren && (
        <Astro.self
          items={children!}
          currentPath={currentPath}
          level={level + 1}
          iconName={iconName}
          rotateIconOnExpand={rotateIconOnExpand}
          toggleMode={toggleMode}
          defaultItemConfig={defaultItemConfig}
          inactiveItemConfig={inactiveItemConfig}
          activeItemConfig={activeItemConfig}
          expansionStrategy={expansionStrategy}
          maxDepth={maxDepth}
        />
      );

      return isDisclosure ? (
        <li data-nav-item data-has-children="true">
          <details
            open={isExpanded}
            data-nav-details
            data-rotate-icon={rotateIconOnExpand ? '' : undefined}
          >
            <Button {...itemConfig} as="summary" data-nav-toggle />
            <div class="pl-4" data-nav-children>
              {subtree}
            </div>
          </details>
        </li>
      ) : (
        <li
          data-nav-item
          data-has-children={hasChildren}
          data-expanded={hasChildren ? isExpanded : undefined}
        >
          <Button {...itemConfig} data-nav-icon-toggle={hasChildren ? '' : undefined} />
          {hasChildren && (
            <div class="pl-4" data-nav-children style={isExpanded ? '' : 'display: none;'}>
              {subtree}
            </div>
          )}
        </li>
      );
    })}
  </ul>
</nav>

<script>
  interface WindowWithNavTreeToggle extends Window {
    __navTreeToggleInitialized?: boolean;
  }

  function initNavigationTree() {
    const win = window as WindowWithNavTreeToggle;
    if (win.__navTreeToggleInitialized) return;
    win.__navTreeToggleInitialized = true;

    const navTrees = document.querySelectorAll('[data-navigation-tree]');
    if (!navTrees.length) return;

    navTrees.forEach((navTree) => {
      navTree.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        // Button mode toggles natively through <details>; only icon mode needs a handler.
        const iconToggle = target.closest('svg') && target.closest('[data-nav-icon-toggle]');
        if (!iconToggle) return;

        e.preventDefault();
        e.stopPropagation();

        const listItem = iconToggle.closest('[data-nav-item]');
        if (!listItem) return;

        const newExpandedState = listItem.getAttribute('data-expanded') !== 'true';
        listItem.setAttribute('data-expanded', String(newExpandedState));

        const childrenContainer = listItem.querySelector<HTMLElement>(
          ':scope > [data-nav-children]'
        );
        if (childrenContainer)
          childrenContainer.style.display = newExpandedState ? 'block' : 'none';

        iconToggle
          .querySelector('.nav-tree-icon')
          ?.classList.toggle('nav-tree-icon-expanded', newExpandedState);
      });
    });
  }

  initNavigationTree();

  document.addEventListener('astro:after-swap', () => {
    (window as WindowWithNavTreeToggle).__navTreeToggleInitialized = false;
    initNavigationTree();
  });
</script>
