---
import type { NavigationTreeHorizontalProps } from '~/types/navigationtreehorizontal.types';
import type { ButtonProps } from '~/types/button.types';
import type { NavigationTreeItem } from '~/types/navigationtree.types';
import { cn } from '~/utils/styles';
import Button from '~/components/blocks/primitives/Button.astro';
import { mergeConfigs } from '~/utils/mergeConfigs';

type Props = NavigationTreeHorizontalProps;

// Configuration: Dropdown position classes
const dropdownPositionClasses = {
  left: 'left-0',
  center: 'left-1/2 -translate-x-1/2',
  right: 'right-0',
} as const;

// Configuration: Default button config for nav items
const defaultItemButtonConfig: Partial<ButtonProps> = {
  variant: 'ghost',
  intent: 'neutral',
  iconPosition: 'right',
};

// Extract props
const {
  items = [],
  trigger = 'hover',
  dropdownPosition = 'left',
  class: className = '',
  itemClass = '',
  dropdownClass = '',
  defaultItemConfig,
  iconName = 'heroicons:chevron-down',
  ...attrs
} = Astro.props;

const defaultChildButtonConfig: Partial<ButtonProps> = {
  variant: 'ghost',
  intent: 'neutral',
  size: 'sm',
  width: 'full',
  class: 'justify-start px-4 py-2',
};

// Build classes
const defaultNavClass = 'flex flex-row items-center gap-1';
const navClass = cn(defaultNavClass, className);

const dropdownWrapperClass = cn(
  'absolute top-full pt-2 z-50',
  dropdownPositionClasses[dropdownPosition]
);
const dropdownPanelClass = cn(
  'min-w-50 bg-base border border-border rounded-sm shadow-lg pb-2',
  dropdownClass
);
---

<nav class={navClass} {...attrs} data-nav-trigger={trigger}>
  {
    items.map((item: NavigationTreeItem) => {
      const { children, ...buttonProps } = item;
      const hasChildren = children && children.length > 0;
      const mergedItemConfig = mergeConfigs(
        {},
        defaultItemButtonConfig,
        defaultItemConfig || {},
        hasChildren ? { icon: { name: iconName } } : {},
        buttonProps
      );

      // For items with children, remove href to prevent navigation
      if (hasChildren && trigger === 'click') {
        mergedItemConfig.href = undefined;
      }

      return (
        <div class={cn('relative group', itemClass)} data-nav-item>
          <Button {...mergedItemConfig} data-nav-parent={hasChildren || undefined} />

          {hasChildren && (
            <div class={dropdownWrapperClass} data-nav-dropdown>
              <div class={dropdownPanelClass}>
                {children!.map((child: NavigationTreeItem) => {
                  // eslint-disable-next-line @typescript-eslint/no-unused-vars
                  const { children: _, ...childProps } = child;
                  const mergedChildConfig = mergeConfigs(
                    {},
                    defaultChildButtonConfig,
                    defaultItemConfig,
                    childProps
                  );

                  return <Button {...mergedChildConfig} />;
                })}
              </div>
            </div>
          )}
        </div>
      );
    })
  }
</nav>

<script>
  interface WindowWithNavInit extends Window {
    __navHorizontalInitialized?: boolean;
  }

  function initNavigationTreeHorizontal() {
    const win = window as WindowWithNavInit;
    if (win.__navHorizontalInitialized) return;
    win.__navHorizontalInitialized = true;

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const parentButton = target.closest('[data-nav-parent]');

      if (parentButton) {
        if (
          parentButton.closest('[data-nav-trigger]')?.getAttribute('data-nav-trigger') !== 'click'
        ) {
          return;
        }
        const navItem = parentButton.closest('[data-nav-item]');
        if (navItem) {
          const dropdown = navItem.querySelector('[data-nav-dropdown]') as HTMLElement;
          if (dropdown) {
            const isOpen = dropdown.hasAttribute('data-open');

            document.querySelectorAll('[data-nav-dropdown]').forEach((d) => {
              if (d !== dropdown) {
                d.removeAttribute('data-open');
              }
            });

            dropdown.toggleAttribute('data-open', !isOpen);
          }
        }
      } else {
        const navItem = target.closest('[data-nav-item]');
        if (!navItem) {
          document.querySelectorAll('[data-nav-dropdown]').forEach((d) => {
            d.removeAttribute('data-open');
          });
        }
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('[data-nav-dropdown]').forEach((d) => {
          d.removeAttribute('data-open');
        });
      }
    });
  }

  initNavigationTreeHorizontal();

  document.addEventListener('astro:after-swap', () => {
    (window as WindowWithNavInit).__navHorizontalInitialized = false;
    initNavigationTreeHorizontal();
  });
</script>
