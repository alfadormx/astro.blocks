---
import type { NavigationTreeHorizontalProps } from '~/types/navigationtreehorizontal.types';
import type { ButtonProps } from '~/types/button.types';
import type { NavigationTreeItem } from '~/types/navigationtree.types';
import { cn } from '~/utils/styles';
import Button from '~/components/blocks/primitives/Button.astro';
import { isCurrentPath } from '~/utils/currentPath';
import { mergeConfigs } from '~/utils/mergeConfigs';

type Props = NavigationTreeHorizontalProps;

// Configuration: Dropdown position classes
const dropdownPositionClasses = {
  left: 'left-0',
  center: 'left-1/2 -translate-x-1/2',
  right: 'right-0',
} as const;

const internalItemConfig: Partial<ButtonProps> = { iconPosition: 'right' };
const internalChildConfig: Partial<ButtonProps> = {
  size: 'sm',
  width: 'full',
  class: 'justify-start px-4 py-2',
};
const internalActiveItemConfig: Partial<ButtonProps> = { variant: 'ghost', intent: 'primary' };
const internalInactiveItemConfig: Partial<ButtonProps> = { variant: 'ghost', intent: 'neutral' };
const internalCurrentPageConfig: Partial<ButtonProps> = { 'aria-current': 'page' };

// Extract props
const {
  items = [],
  currentPath = Astro.url.pathname,
  trigger = 'hover',
  dropdownPosition = 'left',
  class: className = '',
  itemClass = '',
  dropdownClass = '',
  defaultItemConfig,
  activeItemConfig,
  inactiveItemConfig,
  iconName = 'heroicons:chevron-down',
  // eslint-disable-next-line @typescript-eslint/no-unused-vars
  children: _children,
  ...attrs
} = Astro.props;

const stateLayers = (isActive: boolean, isLink: boolean) => [
  isActive ? internalActiveItemConfig : internalInactiveItemConfig,
  isActive && isLink ? internalCurrentPageConfig : undefined,
  defaultItemConfig,
  isActive ? activeItemConfig : inactiveItemConfig,
];

// Build classes
const defaultNavClass = 'flex flex-row items-center gap-1';
const navClass = cn(defaultNavClass, className);

const dropdownWrapperClass = cn(
  'absolute top-full pt-2 z-50',
  dropdownPositionClasses[dropdownPosition]
);
const dropdownPanelClass = cn(
  'min-w-50 bg-base border border-border rounded-sm shadow-lg pb-2',
  dropdownClass
);
---

<nav class={navClass} {...attrs} data-nav-trigger={trigger}>
  {items.map((item: NavigationTreeItem) => {
    const { children, ...buttonProps } = item;
    const hasChildren = children && children.length > 0;
    // A click-mode parent loses its href below, so it renders as a <button>.
    const isToggle = !!hasChildren && trigger === 'click';
    const isActive = isCurrentPath(item.href, currentPath);
    const mergedItemConfig = mergeConfigs<Partial<ButtonProps>>(
      {},
      internalItemConfig,
      ...stateLayers(isActive, !isToggle),
      hasChildren ? { icon: { name: iconName } } : {},
      buttonProps
    );

    if (isToggle) {
      mergedItemConfig.href = undefined;
    }

    return (
      <div class={cn('relative', itemClass)} data-nav-item>
        <Button {...mergedItemConfig} data-nav-parent={hasChildren || undefined} />

        {hasChildren && (
          <div class={dropdownWrapperClass} data-nav-dropdown>
            <div class={dropdownPanelClass}>
              {children!.map((child: NavigationTreeItem) => {
                // eslint-disable-next-line @typescript-eslint/no-unused-vars
                const { children: _, ...childProps } = child;
                const mergedChildConfig = mergeConfigs<Partial<ButtonProps>>(
                  {},
                  internalChildConfig,
                  ...stateLayers(isCurrentPath(child.href, currentPath), true),
                  childProps
                );

                return <Button {...mergedChildConfig} />;
              })}
            </div>
          </div>
        )}
      </div>
    );
  })}
</nav>

<script>
  interface WindowWithNavInit extends Window {
    __navHorizontalInitialized?: boolean;
  }

  function initNavigationTreeHorizontal() {
    const win = window as WindowWithNavInit;
    if (win.__navHorizontalInitialized) return;
    win.__navHorizontalInitialized = true;

    // Capture phase: NavigationTree stops propagation on its toggles, which would hide those clicks.
    document.addEventListener(
      'click',
      (e) => {
        const target = e.target as Element;
        const item = target.closest('[data-nav-item]');
        document.querySelectorAll('[data-nav-dropdown][data-open]').forEach((d) => {
          if (d.closest('[data-nav-item]') !== item) d.removeAttribute('data-open');
        });

        const parentButton = target.closest('[data-nav-parent]');
        const dropdown = parentButton && item?.querySelector('[data-nav-dropdown]');
        if (
          dropdown &&
          parentButton.closest('[data-nav-trigger]')?.getAttribute('data-nav-trigger') === 'click'
        ) {
          dropdown.toggleAttribute('data-open');
        }
      },
      true
    );

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      document.querySelectorAll('[data-nav-dropdown]').forEach((d) => {
        d.removeAttribute('data-open');
      });
      document.querySelectorAll('[data-nav-trigger="hover"] [data-nav-item]').forEach((item) => {
        if (item.matches(':hover') || item.contains(document.activeElement)) {
          item.setAttribute('data-dismissed', '');
        }
      });
    });

    // Re-arm only once pointer and focus have both left, so Escape isn't undone by either alone.
    document.addEventListener('focusout', (e) => {
      const item = (e.target as Element).closest('[data-nav-item][data-dismissed]');
      if (item && !item.contains(e.relatedTarget as Node | null) && !item.matches(':hover')) {
        item.removeAttribute('data-dismissed');
      }
    });

    document.addEventListener('pointerout', (e) => {
      const item = (e.target as Element).closest('[data-nav-item][data-dismissed]');
      if (
        item &&
        !item.contains(e.relatedTarget as Node | null) &&
        !item.contains(document.activeElement)
      ) {
        item.removeAttribute('data-dismissed');
      }
    });
  }

  // Every listener is on `document` and queries at event time, so it survives a ClientRouter swap;
  // re-initialising on astro:after-swap would only stack duplicates.
  initNavigationTreeHorizontal();
</script>
