---
import type { ItemsTimelineProps, TimelineItemProps } from '~/types/itemstimeline.types';
import type { ItemProps } from '~/types/item.types';
import { cn } from '~/utils/styles';
import Item from '~/components/blocks/composite/Item.astro';
import { mergeConfigs } from '~/utils/mergeConfigs';

type Props = ItemsTimelineProps;

const {
  items = [],
  connectorStyle = 'solid',
  air = 'normal',
  class: className = '',
  defaultItemConfig,
} = Astro.props;

const spacingSettings = {
  none: '',
  tight: 'pb-3 md:pb-4 lg:pb-6',
  normal: 'pb-4 md:pb-6 lg:pb-8',
  loose: 'pb-6 md:pb-8 lg:pb-12',
} as const;

const defaultTimelineClass = 'relative flex flex-col';

// Merged classes
const timelineClass = cn(defaultTimelineClass, className);

const internalItemConfig: Partial<ItemProps> = {
  layout: 'horizontal',
  connectorStyle,
  contentClass: spacingSettings[air],
};
---

<div class={timelineClass}>
  {
    items.map((item: TimelineItemProps, index: number) => {
      const mergedItem: ItemProps = mergeConfigs(
        {},
        internalItemConfig,
        defaultItemConfig || {},
        item
      );
      const isLast = index === items.length - 1;

      return <Item {...mergedItem} showConnector={!isLast} />;
    })
  }
</div>
