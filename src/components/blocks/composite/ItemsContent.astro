---
import Container from '~/components/blocks/layout/Container.astro';
import Headline from '~/components/blocks/primitives/Headline.astro';
import ItemsGrid from '~/components/blocks/composite/ItemsGrid.astro';
import type { ItemsContentProps } from '~/types/itemscontent.types';
import type { ItemsGridProps } from '~/types/itemsgrid.types';
import { mergeConfigs } from '~/utils/mergeConfigs';

type Props = ItemsContentProps;

const { container, headline, itemsGrid } = Astro.props;

const defaultContainer = {};

const defaultHeadline = {};

const internalItemsGrid: Partial<ItemsGridProps> = {
  columns: 2,
  defaultItemConfig: {
    orientation: 'horizontal',
  },
};

const mergedContainer = mergeConfigs({}, defaultContainer, container);
const mergedHeadline = mergeConfigs({}, defaultHeadline, headline);
// `items` stays out of the merge: mergeConfigs merges arrays index-wise.
const { items = [], ...itemsGridConfig } = itemsGrid ?? ({} as Partial<ItemsGridProps>);
const mergedItemsGrid: ItemsGridProps = {
  ...mergeConfigs<Partial<ItemsGridProps>>({}, internalItemsGrid, itemsGridConfig),
  items,
};
---

<Container {...mergedContainer}>
  <Headline {...mergedHeadline} />
  <ItemsGrid {...mergedItemsGrid} />
</Container>
