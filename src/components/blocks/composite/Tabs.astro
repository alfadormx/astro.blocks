---
import type { TabsProps } from '~/types/tabs.types';
import type { ButtonProps } from '~/types/button.types';
import type { ContainerProps } from '~/types/container.types';
import Button from '~/components/blocks/primitives/Button.astro';
import Container from '~/components/blocks/layout/Container.astro';
import { mergeConfigs } from '~/utils/mergeConfigs';
import { cn } from '~/utils/styles';

type Props = TabsProps;

const {
  items,
  defaultTabConfig,
  activeTabConfig,
  orientation = 'horizontal',
  container,
  tabList,
} = Astro.props;

const internalTabDefaults: Partial<ButtonProps> = {
  variant: 'ghost',
  intent: 'neutral',
  size: 'md',
};

const defaultContainer: Partial<ContainerProps> = {};
const mergedContainer = mergeConfigs({}, defaultContainer, container || {});

const tabsWrapperClass = cn(
  orientation === 'vertical' ? 'grid grid-cols-[auto_1fr]' : 'flex flex-col'
);

const isGrid = tabList?.layout === 'grid';

// Literal class strings only - Tailwind scans source text, so every variant must
// appear whole in this file. Base is 2 columns: a tab strip's cells are far smaller
// than ItemsGrid's cards, so its ladder (@lg/@3xl/@5xl) would collapse to one column
// in the narrow panels this layout exists for.
const gridColumnClasses = {
  2: 'grid-cols-2',
  3: 'grid-cols-2 @sm:grid-cols-3',
  4: 'grid-cols-2 @sm:grid-cols-3 @md:grid-cols-4',
} as const;

const layoutClass = isGrid
  ? cn('grid items-stretch gap-2', gridColumnClasses[tabList?.columns ?? 2])
  : tabList?.layout === 'row'
    ? 'flex flex-row'
    : tabList?.layout === 'column'
      ? 'flex flex-col'
      : orientation === 'vertical'
        ? 'flex flex-col'
        : 'flex flex-row';

// Grid mode only: the trigger spans are class-free in row/column mode, and Button is
// inline-flex, so without this the tiles sit ragged inside their tracks.
const tabTileClass = isGrid ? 'w-full h-full' : undefined;

const TabListWrapper = isGrid ? 'div' : Fragment;
const tabListWrapperProps = isGrid ? { class: '@container' } : {};

const tabListClass = cn(
  layoutClass,
  tabList?.background?.class,
  tabList?.spacing?.padding,
  tabList?.spacing?.margin,
  tabList?.spacing?.gap,
  tabList?.border?.width,
  tabList?.border?.color,
  tabList?.border?.radius,
  tabList?.class
);

const effectiveLayout = tabList?.layout ?? (orientation === 'vertical' ? 'column' : 'row');
const ariaOrientation = effectiveLayout === 'column' ? 'vertical' : 'horizontal';
---

<Container {...mergedContainer}>
  <div class={tabsWrapperClass} data-tabs-root>
    <TabListWrapper {...tabListWrapperProps}>
      <div role="tablist" aria-orientation={ariaOrientation} class={tabListClass}>
        {
          items.map((item, n) => {
            const inactiveMerge = mergeConfigs(
              {},
              internalTabDefaults,
              defaultTabConfig || {},
              item
            );
            const activeMerge = mergeConfigs(
              {},
              internalTabDefaults,
              defaultTabConfig || {},
              activeTabConfig || {},
              item
            );
            return (
              <span data-tab-index={String(n)} class={tabTileClass}>
                <span data-tab-button="inactive" class={tabTileClass}>
                  <Button {...inactiveMerge} />
                </span>
                <span data-tab-button="active" hidden class={tabTileClass}>
                  <Button {...activeMerge} />
                </span>
              </span>
            );
          })
        }
      </div>
    </TabListWrapper>
    <div>
      {
        items.map((_item, n) => (
          <div data-tab-panel={String(n)} hidden={n !== 0}>
            <slot name={`panel-${n}`} />
          </div>
        ))
      }
    </div>
  </div>
</Container>

<script>
  type TabsInstance = { activeIndex: number; idPrefix: string };

  const tabsMap = new WeakMap<HTMLElement, TabsInstance>();
  let tabsCounter = 0;

  function setActiveTab(root: HTMLElement, instance: TabsInstance, newIndex: number): void {
    instance.activeIndex = newIndex;

    const tabSpans = root.querySelectorAll<HTMLElement>('[data-tab-index]');
    const panels = root.querySelectorAll<HTMLElement>('[data-tab-panel]');

    tabSpans.forEach((span, i) => {
      const inactiveWrap = span.querySelector<HTMLElement>('[data-tab-button="inactive"]');
      const activeWrap = span.querySelector<HTMLElement>('[data-tab-button="active"]');
      const isActive = i === newIndex;

      if (inactiveWrap) inactiveWrap.hidden = isActive;
      if (activeWrap) activeWrap.hidden = !isActive;

      const inactiveBtn = inactiveWrap?.querySelector<HTMLElement>('[role="tab"]');
      const activeBtn = activeWrap?.querySelector<HTMLElement>('[role="tab"]');
      if (inactiveBtn) {
        inactiveBtn.setAttribute('aria-selected', 'false');
        inactiveBtn.setAttribute('tabindex', '-1');
      }
      if (activeBtn) {
        activeBtn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        activeBtn.setAttribute('tabindex', isActive ? '0' : '-1');
      }
    });

    panels.forEach((panel, i) => {
      const isActive = i === newIndex;
      panel.hidden = !isActive;
      panel.setAttribute('aria-hidden', isActive ? 'false' : 'true');
      panel.setAttribute(
        'aria-labelledby',
        `${instance.idPrefix}-tab-${i}-${isActive ? 'active' : 'inactive'}`
      );
    });
  }

  function activeButton(root: HTMLElement, index: number): HTMLElement | null {
    const span = root.querySelectorAll<HTMLElement>('[data-tab-index]')[index];
    return span?.querySelector<HTMLElement>('[data-tab-button="active"] [role="tab"]') ?? null;
  }

  function findEnabled(root: HTMLElement, start: number, step: 1 | -1, count: number): number {
    for (let k = 0; k < count; k++) {
      const i = (((start + step * k) % count) + count) % count;
      const btn = activeButton(root, i);
      if (btn && !btn.hasAttribute('disabled')) return i;
    }
    return -1;
  }

  function onKeyDown(root: HTMLElement, e: KeyboardEvent): void {
    const span = (e.target as HTMLElement).closest<HTMLElement>('[data-tab-index]');
    if (!span || span.closest('[data-tabs-root]') !== root) return;
    const inst = tabsMap.get(root);
    const current = parseInt(span.dataset.tabIndex!, 10);
    if (!inst || isNaN(current)) return;

    const vertical =
      root.querySelector('[role="tablist"]')?.getAttribute('aria-orientation') === 'vertical';
    const rtl = !vertical && (document.dir === 'rtl' || getComputedStyle(root).direction === 'rtl');
    const [prevKey, nextKey] = vertical
      ? ['ArrowUp', 'ArrowDown']
      : rtl
        ? ['ArrowRight', 'ArrowLeft']
        : ['ArrowLeft', 'ArrowRight'];
    const count = root.querySelectorAll('[data-tab-index]').length;

    let target: number;
    if (e.key === nextKey) target = findEnabled(root, current + 1, 1, count);
    else if (e.key === prevKey) target = findEnabled(root, current - 1, -1, count);
    else if (e.key === 'Home') target = findEnabled(root, 0, 1, count);
    else if (e.key === 'End') target = findEnabled(root, count - 1, -1, count);
    else return;
    if (target === -1) return;

    e.preventDefault();
    setActiveTab(root, inst, target);
    activeButton(root, target)?.focus();
  }

  function initTabs(): void {
    document.querySelectorAll<HTMLElement>('[data-tabs-root]').forEach((root) => {
      if (tabsMap.has(root)) return;

      const idPrefix = `tabs-${tabsCounter++}`;
      const instance: TabsInstance = { activeIndex: 0, idPrefix };
      tabsMap.set(root, instance);

      const tabSpans = root.querySelectorAll<HTMLElement>('[data-tab-index]');
      const panels = root.querySelectorAll<HTMLElement>('[data-tab-panel]');

      tabSpans.forEach((span, i) => {
        const tabId = `${idPrefix}-tab-${i}`;
        const panelId = `${idPrefix}-panel-${i}`;

        span.querySelectorAll<HTMLElement>('button, a').forEach((btn, btnIdx) => {
          btn.setAttribute('role', 'tab');
          btn.id = `${tabId}-${btnIdx === 0 ? 'inactive' : 'active'}`;
          btn.setAttribute('aria-controls', panelId);
          btn.setAttribute('aria-selected', 'false');
        });
      });

      panels.forEach((panel, i) => {
        panel.id = `${idPrefix}-panel-${i}`;
        panel.setAttribute('role', 'tabpanel');
      });

      setActiveTab(root, instance, 0);

      root.addEventListener('click', (e: Event) => {
        const span = (e.target as HTMLElement).closest<HTMLElement>('[data-tab-index]');
        if (!span) return;
        const idx = parseInt(span.dataset.tabIndex!, 10);
        const inst = tabsMap.get(root);
        if (!inst || isNaN(idx)) return;
        setActiveTab(root, inst, idx);
        activeButton(root, idx)?.focus();
      });

      root.addEventListener('keydown', (e) => onKeyDown(root, e));
    });
  }

  document.addEventListener('astro:after-swap', initTabs);
  initTabs();
</script>
