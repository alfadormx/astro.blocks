---
import type { ItemsGridProps } from '~/types/itemsgrid.types';
import type { TextAreaProps } from '~/types/textarea.types';
import type { ToggleGroupAppearance, ToggleGroupProps } from '~/types/togglegroup.types';
import ItemsGrid from '~/components/blocks/composite/ItemsGrid.astro';
import TextArea from '~/components/blocks/primitives/TextArea.astro';
import ToggleGroup from '~/components/blocks/primitives/ToggleGroup.astro';
import { cn } from '~/utils/styles';

type Props = { heading: string; headingId: string; headingClass?: string } & (
  | { kind: 'toggle'; props: ToggleGroupProps & ToggleGroupAppearance }
  | { kind: 'grid'; props: ItemsGridProps }
  | { kind: 'text'; props: TextAreaProps }
);

const panel = Astro.props;
---

<h3 id={panel.headingId} class={cn('mb-4 text-lg font-semibold', panel.headingClass)}>
  {panel.heading}
</h3>
{panel.kind === 'toggle' && <ToggleGroup {...panel.props} />}
{panel.kind === 'grid' && <ItemsGrid {...panel.props} />}
{panel.kind === 'text' && <TextArea {...panel.props} />}
