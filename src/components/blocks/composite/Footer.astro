---
import Container from '~/components/blocks/layout/Container.astro';
import Button from '~/components/blocks/primitives/Button.astro';
import Logo from '~/components/blocks/primitives/Logo.astro';
import LanguageToggle from '~/components/blocks/primitives/LanguageToggle.astro';
import type { ButtonProps } from '~/types/button.types';
import type { ContainerProps } from '~/types/container.types';
import type { FooterProps } from '~/types/footer.types';
import type { LanguageToggleProps } from '~/types/languagetoggle.types';
import { mergeConfigs } from '~/utils/mergeConfigs';
import { cn } from '~/utils/styles';

type Props = FooterProps;

const {
  container,
  disclaimer,
  disclaimerClass,
  logo,
  footnote,
  footnoteClass,
  socialButtons = [],
  defaultSocialButtonConfig,
  socialButtonsClass,
  secondaryButtons = [],
  defaultSecondaryButtonConfig,
  secondaryButtonsClass,
  languageToggle,
  languageToggleAlign = 'center',
} = Astro.props;

const defaultDisclaimerClass = 'text-xs text-subtle';
const defaultFootnoteClass = 'text-sm mr-4 text-subtle';

const baseContainerConfig: ContainerProps = {
  htmlTag: 'footer',
  content: { air: 'none' },
};

const internalSocialButtonConfig: Partial<ButtonProps> = {
  size: 'sm',
  variant: 'ghost',
  intent: 'neutral',
  shape: 'rounded',
  width: 'auto',
};

const internalSecondaryButtonConfig: Partial<ButtonProps> = {
  variant: 'link',
  intent: 'neutral',
  class: 'p-0',
  size: 'sm',
};

const mergedDisclaimerClass = cn(defaultDisclaimerClass, disclaimerClass);
const mergedFootnoteClass = cn(defaultFootnoteClass, footnoteClass);

const mergedContainerConfig = mergeConfigs({}, baseContainerConfig, container);

const mergedLanguageToggle = languageToggle
  ? mergeConfigs<LanguageToggleProps>(
      {},
      { defaultButtonConfig: { variant: 'link', class: 'p-0' } },
      languageToggle
    )
  : undefined;

// Language toggle alignment classes
const languageToggleAlignmentClass = {
  left: 'justify-start',
  center: 'justify-center',
  right: 'justify-end',
}[languageToggleAlign];
---

<Container {...mergedContainerConfig}>
  <div class="grid grid-cols-12 gap-4 gap-y-8 sm:gap-8 py-8 md:py-12">
    <div class="col-span-12 md:col-span-4">
      <div class="mb-2">
        <Logo {...logo} />
      </div>
      {
        secondaryButtons.length > 0 && (
          <div class={cn('flex flex-row gap-1', secondaryButtonsClass)}>
            {secondaryButtons.map((button, index) => {
              const mergedSecondaryButton = mergeConfigs(
                {},
                internalSecondaryButtonConfig,
                defaultSecondaryButtonConfig,
                button
              );
              return (
                <>
                  {index !== 0 ? ' · ' : ''}
                  <Button {...mergedSecondaryButton} />
                </>
              );
            })}
          </div>
        )
      }
    </div>
  </div>
  {
    disclaimer && (
      <div class={mergedDisclaimerClass}>
        <Fragment set:html={disclaimer} />
      </div>
    )
  }
  <div class="md:flex md:items-center md:justify-between pt-6 pb-0 md:pt-8 md:pb-2">
    {
      socialButtons.length > 0 && (
        <div class={cn('md:order-1 flex flex-row gap-1', socialButtonsClass)}>
          {socialButtons.map((button) => (
            <Button
              {...mergeConfigs({}, internalSocialButtonConfig, defaultSocialButtonConfig, button)}
            />
          ))}
        </div>
      )
    }

    <div class={mergedFootnoteClass}>
      <Fragment set:html={footnote} />
    </div>
  </div>

  {
    mergedLanguageToggle && (
      <div class={`flex ${languageToggleAlignmentClass} py-4`}>
        <LanguageToggle {...mergedLanguageToggle} />
      </div>
    )
  }
</Container>
