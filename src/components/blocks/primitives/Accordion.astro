---
import { Icon } from 'astro-icon/components';
import type { AccordionProps } from '~/types/accordion.types';
import { nextAccordionName, validateAccordion } from '~/utils/accordion';
import { focusRingClass } from '~/utils/intentStyles';
import { cn } from '~/utils/styles';

type Props = AccordionProps;

const {
  items,
  mode = 'multiple',
  name,
  defaultOpen = [],
  titleTag: TitleTag = 'span',
  icon = { name: 'heroicons:chevron-down' },
  class: className,
  itemClass,
  summaryClass,
  titleClass,
  contentClass,
  iconClass,
} = Astro.props;

const slotName = (index: number) => `item-${index}`;

validateAccordion({ items, mode, defaultOpen, hasSlot: (i) => Astro.slots.has(slotName(i)) });

const groupName = mode === 'single' ? (name ?? nextAccordionName()) : undefined;
const openIndices = new Set(defaultOpen);

const detailsClass = cn('border-b border-border', itemClass);
const summaryClasses = cn(
  'flex cursor-pointer list-none items-center justify-between gap-4 rounded-sm py-4',
  '[&::-webkit-details-marker]:hidden',
  'focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2',
  focusRingClass('neutral'),
  summaryClass
);
const titleClasses = cn('m-0 font-semibold text-normal', titleClass);
const iconClasses = cn(
  // A group-open variant would match any open ancestor, rotating nested closed items too.
  'size-5 shrink-0 text-muted transition-transform duration-200 [[open]>summary>&]:rotate-180 motion-reduce:transition-none',
  icon ? icon.class : undefined,
  iconClass
);
const contentClasses = cn('pb-4 text-muted', contentClass);
---

<div class={className} data-accordion>
  {items.map((item, index) => (
    <details
      id={item.id}
      name={groupName}
      open={openIndices.has(index)}
      class={detailsClass}
      data-accordion-item
    >
      <summary class={summaryClasses} data-accordion-summary>
        <TitleTag class={titleClasses}>{item.title}</TitleTag>
        {icon && (
          <Icon
            name={icon.name ?? 'heroicons:chevron-down'}
            class={iconClasses}
            aria-hidden="true"
          />
        )}
      </summary>
      {Astro.slots.has(slotName(index)) ? (
        <div class={contentClasses} data-accordion-content>
          <slot name={slotName(index)} />
        </div>
      ) : (
        <div class={contentClasses} data-accordion-content set:html={item.content} />
      )}
    </details>
  ))}
</div>
