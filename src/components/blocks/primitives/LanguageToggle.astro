---
import type { LanguageToggleProps } from '~/types/languagetoggle.types';
import type { ButtonProps } from '~/types/button.types';
import Button from './Button.astro';
import { I18N, SITE } from 'site-config';
import { currentLanguage } from '~/utils/currentLanguage';
import { mergeConfigs } from '~/utils/mergeConfigs';
import { cn } from '~/utils/styles';

type Language = (typeof I18N.languages)[number];

type Props = LanguageToggleProps;

const {
  orientation = 'horizontal',
  labelFormat = 'label',
  defaultButtonConfig,
  activeButtonConfig,
  inactiveButtonConfig,
  class: className,
  gap = 'normal',
  preservePath = true,
  // eslint-disable-next-line @typescript-eslint/no-unused-vars
  children: _children,
  ...rest
} = Astro.props;

const internalInactiveButtonConfig: Partial<ButtonProps> = {
  variant: 'solid',
  intent: 'neutral',
  size: 'md',
  shape: 'rounded',
  width: 'auto',
};

const internalActiveButtonConfig: Partial<ButtonProps> = {
  variant: 'solid',
  intent: 'primary',
  size: 'md',
  shape: 'rounded',
  width: 'auto',
};

// Merge configs: defaults < component defaults < user defaults < specific active/inactive config
const mergedInactiveButtonConfig = mergeConfigs(
  {},
  internalInactiveButtonConfig,
  defaultButtonConfig,
  inactiveButtonConfig
);

const mergedActiveButtonConfig = mergeConfigs(
  {},
  internalActiveButtonConfig,
  defaultButtonConfig,
  activeButtonConfig
);

const currentPath = Astro.url.pathname;
const currentLang = currentLanguage(currentPath, I18N);

const applyTrailingSlash = (path: string) => {
  if (SITE.trailingSlash) {
    return path.endsWith('/') || path.includes('.') ? path : `${path}/`;
  }
  return path.endsWith('/') && path.length > 1 ? path.slice(0, -1) : path;
};

const buildLanguageUrl = (langBasePath: string) => {
  if (!preservePath) return applyTrailingSlash(langBasePath);

  const pathWithoutLang =
    currentLang.basePath === '/'
      ? currentPath
      : currentPath.slice(currentLang.basePath.length) || '/';

  return applyTrailingSlash(
    langBasePath === '/'
      ? pathWithoutLang
      : `${langBasePath}${pathWithoutLang === '/' ? '' : pathWithoutLang}`
  );
};

const orientationClasses = orientation === 'vertical' ? 'flex-col' : 'flex-row';

const gapClasses = { none: 'gap-0', tight: 'gap-1', normal: 'gap-4', loose: 'gap-6' } as const;

const containerClasses = cn('flex', orientationClasses, gapClasses[gap], className);
---

<div class={containerClasses} {...rest} data-language-toggle>
  {I18N.languages.map((lang: Language) => {
    const isActive = currentLang.code === lang.code;
    const languageUrl = buildLanguageUrl(lang.basePath);
    const buttonConfig = isActive ? mergedActiveButtonConfig : mergedInactiveButtonConfig;

    return (
      <Button
        {...buttonConfig}
        href={languageUrl}
        label={labelFormat === 'code' ? lang.code.toUpperCase() : lang.label}
        aria-label={labelFormat === 'code' ? lang.label : undefined}
        lang={lang.code}
        aria-current={isActive ? 'page' : undefined}
      />
    );
  })}
</div>
