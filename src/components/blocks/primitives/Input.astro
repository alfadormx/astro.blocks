---
import Field from '~/components/blocks/primitives/Field.astro';
import type { InputAttributes } from '~/types/input.types';
import { ariaInvalid, describedBy, fieldControlClass, fieldDescriptionIds } from '~/utils/field';
import { inputId, validateInput } from '~/utils/input';

type Props = InputAttributes;

const {
  label,
  hideLabel = false,
  help,
  error,
  id: idProp,
  name,
  type = 'text',
  placeholder,
  value,
  required = false,
  disabled = false,
  readOnly = false,
  size = 'md',
  variant = 'outline',
  intent = 'primary',
  shape = 'rounded',
  class: className = '',
  labelClass = '',
  fieldClass = '',
  helpClass = '',
  errorClass = '',
  'aria-describedby': consumerDescribedBy,
  'aria-invalid': consumerInvalid,
  // eslint-disable-next-line @typescript-eslint/no-unused-vars
  children: _children,
  ...attrs
} = Astro.props;

validateInput({ label });

const id = idProp || inputId();
const { helpId, errorId } = fieldDescriptionIds(id);
---

<Field
  id={id}
  label={label}
  hideLabel={hideLabel}
  required={required}
  disabled={disabled}
  help={help}
  error={error}
  class={className}
  labelClass={labelClass}
  helpClass={helpClass}
  errorClass={errorClass}
  rootAttrs={{ 'data-input': '' }}
>
  <input
    id={id}
    type={type}
    name={name}
    value={value}
    placeholder={placeholder}
    required={required}
    disabled={disabled}
    readonly={readOnly}
    aria-invalid={ariaInvalid(error, consumerInvalid)}
    aria-describedby={describedBy({
      helpId: help ? helpId : undefined,
      errorId: error ? errorId : undefined,
      consumer: consumerDescribedBy,
    })}
    class={fieldControlClass({
      size,
      variant,
      shape,
      intent,
      error,
      readOnly,
      disabled,
      fieldClass,
    })}
    {...attrs}
  />
</Field>
