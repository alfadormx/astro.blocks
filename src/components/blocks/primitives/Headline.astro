---
import type { HeadlineProps } from '~/types/headline.types';
import { cn } from '~/utils/styles';

type Props = HeadlineProps;

const {
  tagline,
  title,
  subtitle,
  taglineClass = '',
  titleClass = '',
  subtitleClass = '',
  class: className = '',
  align = 'left',
  anchorId,
  htmlTag: TitleTag = 'h2',
} = Astro.props;

const defaultAlignmentClass = {
  left: 'text-left',
  center: 'text-center',
  right: 'text-right',
}[align];

const defaultClass = 'headline mt-8 mb-12 space-y-2';

const mergedClass = cn(defaultClass, defaultAlignmentClass, className);

const mergedTaglineClass = cn(
  'text-secondary text-sm font-semibold uppercase tracking-wider',
  taglineClass
);

// Reproduces the base-layer h1 look whatever the tag, so dropping to h2 changes no pixels.
// `length:` hint keeps twMerge from reading the clamp as a colour, so `text-2xl` etc. cancel it.
// `leading-*` must follow the size: twMerge drops a line-height that precedes a font-size.
// Bottom margin only without a subtitle; `space-y-2` sets the gap otherwise.
const mergedTitleClass = cn(
  'font-title mt-0 font-bold text-[length:clamp(2rem,1.5rem+2vw,3rem)] leading-[1.2]',
  !subtitle && 'mb-4',
  titleClass
);

const mergedSubtitleClass = cn(
  'text-muted subtitle max-w-3xl',
  align === 'center' && 'mx-auto',
  align === 'right' && 'ml-auto',
  subtitleClass
);
---

<div class={mergedClass}>
  {anchorId ? <a id={anchorId} /> : null}
  {tagline && <p class={mergedTaglineClass}>{tagline}</p>}
  {title && <TitleTag class={mergedTitleClass}>{title}</TitleTag>}
  {subtitle && <p class={mergedSubtitleClass}>{subtitle}</p>}
</div>
