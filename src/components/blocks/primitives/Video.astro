---
import type { VideoProps } from '~/types/video.types';
import { cn } from '~/utils/styles';
import Button from './Button.astro';
import type { ButtonProps } from '~/types/button.types';
import { mergeConfigs } from '~/utils/mergeConfigs';
import { validateVideoSource } from '~/utils/video';

type Props = VideoProps;

// Configuration: Aspect ratio classes
const aspectRatioClasses = {
  video: 'aspect-video', // 16:9
  square: 'aspect-square', // 1:1
  portrait: 'aspect-[9/16]', // 9:16
  cinema: 'aspect-[21/9]', // 21:9
} as const;

// Extract props
const {
  source,
  aspectRatio = 'video',
  isFloating = false,
  crossorigin = 'anonymous',
  autoplay,
  muted,
  hideControls,
  loop,
  pipButton,
  class: className = '',
  align,
} = Astro.props;

validateVideoSource(source);

const provider = source.provider;
const isMuted = muted ?? !!autoplay;
const mediaClass = 'block h-full w-full';
const embedSrc =
  source.provider === 'youtube'
    ? source.id
    : source.provider === 'vimeo'
      ? `https://vimeo.com/${source.id}`
      : undefined;
const Skin = hideControls ? Fragment : 'video-skin';
const skinProps = hideControls ? {} : { class: 'h-full w-full', style: '--media-border-radius: 0' };

// Build alignment class
const alignClass =
  align === 'center'
    ? 'flex justify-center'
    : align === 'right'
      ? 'flex justify-end'
      : align === 'left'
        ? 'flex justify-start'
        : '';

const defaultWrapperClass = 'w-full relative bg-elevated';
const defaultVideoGroupClass = 'w-full relative overflow-hidden bg-elevated';

const internalPipButton: Partial<ButtonProps> = {
  icon: { name: 'heroicons:arrow-up-left' },
  size: 'sm',
  hidden: true,
  class: 'absolute z-10 top-3 left-3 opacity-0 group-hover:opacity-100 transition-opacity',
};

const mergedPipButton = mergeConfigs({}, internalPipButton, pipButton);

const mergedWrapperClass = cn(defaultWrapperClass, aspectRatioClasses[aspectRatio], className);

const mergedVideoGroupClass = cn(
  defaultVideoGroupClass,
  aspectRatioClasses[aspectRatio],
  isFloating && 'group'
);
---

<div class={align ? alignClass : ''}>
  <div class={mergedWrapperClass}>
    <div
      data-video-group={isFloating ? '' : undefined}
      data-video-provider={provider}
      class={mergedVideoGroupClass}
    >
      {isFloating && <Button {...mergedPipButton} data-video-pip-close />}
      <video-player
        class="block h-full w-full"
        poster={!hideControls && source.provider === 'html5' ? source.poster : undefined}
      >
        <Skin {...skinProps}>
          {source.provider === 'html5' ? (
            <video
              class={cn(mediaClass, 'object-contain')}
              crossorigin={crossorigin}
              autoplay={autoplay}
              muted={isMuted}
              loop={loop}
              playsinline
              preload="metadata"
              poster={hideControls ? source.poster : undefined}
            >
              {source.sources.map((file) => (
                <source src={file.src} type={file.type} />
              ))}
            </video>
          ) : source.provider === 'youtube' ? (
            <youtube-video
              class={mediaClass}
              src={embedSrc}
              autoplay={autoplay || undefined}
              muted={isMuted || undefined}
              loop={loop || undefined}
              playsinline=""
            />
          ) : (
            <vimeo-video
              class={mediaClass}
              src={embedSrc}
              autoplay={autoplay || undefined}
              muted={isMuted || undefined}
              loop={loop || undefined}
              playsinline=""
            />
          )}
        </Skin>
      </video-player>
    </div>
  </div>
</div>

<script>
  import '@videojs/html/video/player';
  import '@videojs/html/video/skin';

  const providers = {
    youtube: () => import('@videojs/html/media/youtube-video'),
    vimeo: () => import('@videojs/html/media/vimeo-video'),
  } as const;

  for (const [name, load] of Object.entries(providers)) {
    if (document.querySelector(`[data-video-provider="${name}"]`)) {
      load().catch((err) => console.error('[Video]', err));
    }
  }

  function setupFloating(group: HTMLElement) {
    const closeBtn = group.querySelector<HTMLElement>('[data-video-pip-close]');
    const rect = group.getBoundingClientRect();
    const threshold = rect.top + window.scrollY + rect.height / 3;
    let userClosed = false;

    const setFloating = (floating: boolean) => {
      group.classList.toggle('floating-player', floating);
      closeBtn?.toggleAttribute('hidden', !floating);
    };

    const update = () => {
      const current = group.getBoundingClientRect();
      const fullyVisible =
        current.top >= 0 &&
        current.bottom <= window.innerHeight &&
        current.top < window.innerHeight / 2;
      if (fullyVisible) userClosed = false;
      setFloating(window.scrollY > threshold && !userClosed);
    };

    closeBtn?.addEventListener('click', () => {
      userClosed = true;
      setFloating(false);
    });
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll<HTMLElement>('[data-video-group]').forEach(setupFloating);
  });
</script>
