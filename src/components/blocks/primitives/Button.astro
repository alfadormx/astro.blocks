---
import type { ButtonProps } from '~/types/button.types';
import { cn } from '~/utils/styles';
import { intentClass, mediaSizeClass, shapeClass, sizeClass } from '~/utils/buttonStyles';
import { Icon } from 'astro-icon/components';
import Image from '~/components/blocks/primitives/Image.astro';

type Props = ButtonProps;

const {
  id,
  label,
  subtitle,
  layout,
  icon,
  image,
  iconPosition = 'left',
  iconSize,
  imageSize,
  align,
  href,
  target = '_self',
  size = 'md',
  variant = 'solid',
  intent = 'primary',
  shape = 'rounded',
  width = 'auto',
  disabled = false,
  class: className = '',
  labelClass = '',
  subtitleClass = '',
  iconClass = '',
  ...attrs
} = Astro.props;

// Media slot: icon and image are mutually exclusive, image wins
const hasImage = !!image?.src;
const hasIcon = !!icon?.name;

// Determine if this is a media-only button (icon or image, no text)
const isMediaOnly = (hasIcon || hasImage) && !label && !subtitle;

// Determine if this is a promotional button (has subtitle)
const hasSubtitle = !!subtitle;

// Resolve the content arrangement: explicit `layout` wins, otherwise a subtitle implies vertical
const resolvedLayout = layout ?? (subtitle ? 'vertical' : 'horizontal');
const isVertical = resolvedLayout === 'vertical';

// Base button classes
const baseClasses = cn(
  'inline-flex items-center justify-center font-medium transition-all duration-200',
  'focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2',
  'cursor-pointer',
  disabled && 'opacity-50 cursor-not-allowed pointer-events-none'
);

const sizeClasses = sizeClass(size, {
  mediaOnly: isMediaOnly,
  subtitle: hasSubtitle,
  vertical: isVertical,
});
const shapeClasses = shapeClass(shape, isMediaOnly);
const intentClasses = intentClass(variant, intent);

// Width classes
const widthClasses = width === 'full' ? 'w-full' : '';

// Alignment wrapper (optional)
const alignClass =
  align === 'center'
    ? 'flex justify-center'
    : align === 'right'
      ? 'flex justify-end'
      : align === 'left'
        ? 'flex justify-start'
        : '';

// Layout classes for content arrangement
const layoutClasses = cn(isVertical ? 'flex-col gap-1' : 'flex-row gap-2', isMediaOnly && 'p-0');

const iconSizeClass = iconSize || mediaSizeClass(size);
const imageSizeClass = imageSize || mediaSizeClass(size);

// Final button classes
const buttonClass = cn(
  baseClasses,
  sizeClasses,
  shapeClasses,
  intentClasses,
  widthClasses,
  layoutClasses,
  className
);

// Label classes
const finalLabelClass = cn(hasSubtitle && 'font-semibold', labelClass);

// Subtitle classes
const finalSubtitleClass = cn('text-xs opacity-90', subtitleClass);

// Icon wrapper classes
const finalIconClass = cn(icon?.class, iconClass);

// Render as link or button
const Tag = href ? 'a' : 'button';
const tagProps = href
  ? { id, href, target, rel: target === '_blank' ? 'noopener noreferrer' : undefined, ...attrs }
  : { id, type: 'button' as const, disabled, ...attrs };
---

<div class={align ? alignClass : 'contents'}>
  <Tag class={buttonClass} {...tagProps}>
    {
      iconPosition === 'left' &&
        (hasImage ? (
          <Image {...image} class={cn(imageSizeClass, image?.class)} />
        ) : (
          hasIcon && (
            <Icon
              name={icon!.name}
              class={cn(iconSizeClass, finalIconClass)}
              aria-label={icon!.ariaLabel}
            />
          )
        ))
    }

    {
      (label || subtitle) && (
        <span class={cn('flex flex-col', hasSubtitle && 'items-start')}>
          {label && <span class={finalLabelClass}>{label}</span>}
          {subtitle && <span class={finalSubtitleClass}>{subtitle}</span>}
        </span>
      )
    }

    {
      iconPosition === 'right' &&
        (hasImage ? (
          <Image {...image} class={cn(imageSizeClass, image?.class)} />
        ) : (
          hasIcon && (
            <Icon
              name={icon!.name}
              class={cn(iconSizeClass, finalIconClass)}
              aria-label={icon!.ariaLabel}
            />
          )
        ))
    }

    {Astro.slots.has('default') && <slot />}
  </Tag>
</div>
