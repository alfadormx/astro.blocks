---
import { SITE } from 'site-config';
import type { LogoProps } from '~/types/logo.types';
import Button from '~/components/blocks/primitives/Button.astro';
import Vector from '~/components/blocks/primitives/Vector.astro';
import Image from '~/components/blocks/primitives/Image.astro';
import { cn } from '~/utils/styles';
import { mergeConfigs } from '~/utils/mergeConfigs';

type Props = LogoProps;

const { vector, image } = Astro.props;

const defaultLogoConfig: Partial<LogoProps> = {
  href: '/',
  variant: 'link',
  intent: 'neutral',
  label: vector?.src || image?.src ? undefined : SITE.name,
  labelClass: 'text-xl font-bold',
  class: 'shrink-0 p-0 hover:no-underline',
};

const mergedLogoConfig = mergeConfigs({}, defaultLogoConfig, Astro.props);

// The logo renders its own vector/image into the Button slot, so keep both out of the
// Button's own props — Button now owns an `image` prop of its own media slot.
const { vector: mergedVector, image: mergedImage, ...buttonConfig } = mergedLogoConfig;
---

{
  (mergedVector?.src || mergedImage?.src || buttonConfig.label) && (
    <Button {...buttonConfig}>
      {mergedVector?.src ? (
        <Vector
          {...mergedVector}
          class={cn('w-full h-full', mergedVector.class)}
          ariaLabel={mergedVector.ariaLabel || SITE.name}
        />
      ) : mergedImage?.src ? (
        <Image {...mergedImage} alt={mergedImage.alt || SITE.name} />
      ) : null}
    </Button>
  )
}
