---
import type { MapProps } from '~/types/map.types';
import { cn } from '~/utils/styles';

type Props = MapProps;

const {
  lat,
  lon,
  zoom = 13,
  layer = 'mapnik',
  showMarker = true,
  markerTitle,
  height = '400px',
  width = '100%',
  title = 'OpenStreetMap',
  class: className = '',
} = Astro.props;

const mapConfig = JSON.stringify({ lat, lon, zoom, layer, showMarker, markerTitle });
const externalUrl = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=${zoom}/${lat}/${lon}`;
---

<div class={cn('w-full', className)}>
  <div
    data-map-config={mapConfig}
    style={`height: ${height}; width: ${width};`}
    role="application"
    aria-label={title}
  ></div>
  <small class="block mt-1 text-xs text-right">
    &copy;
    <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">
      OpenStreetMap
    </a>{' '}
    contributors &mdash;
    <a href={externalUrl} target="_blank" rel="noopener noreferrer">
      View larger map &rarr;
    </a>
  </small>
</div>

<script>
  import type * as Leaflet from 'leaflet';
  import iconUrl from 'leaflet/dist/images/marker-icon.png?url';
  import iconRetinaUrl from 'leaflet/dist/images/marker-icon-2x.png?url';
  import shadowUrl from 'leaflet/dist/images/marker-shadow.png?url';

  type MapConfig = {
    lat: number;
    lon: number;
    zoom: number;
    layer: string;
    showMarker: boolean;
    markerTitle?: string;
  };

  const ROOT_MARGIN = '200px';

  const tileUrls: Record<string, string> = {
    mapnik: 'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
    humanitarian: 'https://{s}.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png',
    topo: 'https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png',
  };

  const tileSubdomains: Record<string, string> = {
    mapnik: 'abc',
    humanitarian: 'ab',
    topo: 'abc',
  };

  const tileAttributions: Record<string, string> = {
    mapnik:
      '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    humanitarian:
      '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors, Tiles by <a href="https://hot.openstreetmap.org/" target="_blank">HOT</a>',
    topo: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors, &copy; <a href="https://opentopomap.org">OpenTopoMap</a>',
  };

  let leaflet: Promise<typeof Leaflet> | undefined;

  function loadLeaflet(): Promise<typeof Leaflet> {
    leaflet ??= Promise.all([import('leaflet'), import('leaflet/dist/leaflet.css')])
      .then(([mod]) => {
        const L = (mod as { default?: typeof Leaflet }).default ?? mod;
        // Vite's asset bundling breaks the default marker paths; _getIconUrl must go first
        // or mergeOptions has no effect.
        delete (L.Icon.Default.prototype as unknown as Record<string, unknown>)['_getIconUrl'];
        L.Icon.Default.mergeOptions({ iconUrl, iconRetinaUrl, shadowUrl });
        return L;
      })
      .catch((err) => {
        leaflet = undefined;
        throw err;
      });
    return leaflet;
  }

  async function buildMap(el: HTMLElement): Promise<void> {
    const L = await loadLeaflet();
    const { lat, lon, zoom, layer, showMarker, markerTitle }: MapConfig = JSON.parse(
      el.dataset.mapConfig ?? '{}'
    );
    const map = L.map(el).setView([lat, lon], zoom);
    L.tileLayer(tileUrls[layer] ?? tileUrls.mapnik, {
      attribution: tileAttributions[layer] ?? tileAttributions.mapnik,
      subdomains: tileSubdomains[layer] ?? 'abc',
      maxZoom: 19,
    }).addTo(map);
    if (showMarker) {
      const marker = L.marker([lat, lon]).addTo(map);
      if (markerTitle) marker.bindPopup(markerTitle).openPopup();
    }
    el.dataset.mapReady = '';
  }

  const seen = new WeakSet<HTMLElement>();
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const el = entry.target as HTMLElement;
        observer.unobserve(el);
        buildMap(el).catch((err) => {
          console.error(err);
          observer.observe(el);
        });
      }
    },
    { rootMargin: ROOT_MARGIN }
  );

  function initMaps(): void {
    document.querySelectorAll<HTMLElement>('[data-map-config]').forEach((el) => {
      if (seen.has(el)) return;
      seen.add(el);
      observer.observe(el);
    });
  }

  initMaps();
  document.addEventListener('astro:after-swap', initMaps);
</script>
