---
import LanguageToggle from '~/components/blocks/primitives/LanguageToggle.astro';
---

<div class="rounded-lg border border-border bg-surface p-6">
  <div class="flex items-center justify-between mb-4">
    <p class="text-lg font-semibold">Header Example</p>
    <LanguageToggle
      preservePath={false}
      defaultButtonConfig={{ size: 'sm', variant: 'outline', shape: 'pill' }}
    />
  </div>
  <p class="text-muted">
    This is a typical header layout with the language toggle positioned at the top right.
  </p>
</div>
