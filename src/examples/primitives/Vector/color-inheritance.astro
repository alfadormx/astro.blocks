---
import Vector from '~/components/blocks/primitives/Vector.astro';

const demoSvg = 'https://www.svgrepo.com/show/513167/basketball.svg';
---

<div class="flex gap-6">
  <div class="w-32 text-primary">
    <Vector src={demoSvg} ariaLabel="Primary compass" />
  </div>
  <div class="w-32 text-secondary">
    <Vector src={demoSvg} ariaLabel="Secondary compass" />
  </div>
  <div class="w-32 text-accent">
    <Vector src={demoSvg} ariaLabel="Accent compass" />
  </div>
  <div class="w-32 text-error">
    <Vector src={demoSvg} ariaLabel="Error compass" />
  </div>
</div>
