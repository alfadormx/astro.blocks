---
import Button from '~/components/blocks/primitives/Button.astro';
---

<div class="flex flex-wrap items-start gap-4">
  <Button orientation="vertical" icon={{ name: 'heroicons:cube' }} label="Extra Small" size="xs" />
  <Button orientation="vertical" icon={{ name: 'heroicons:cube' }} label="Small" size="sm" />
  <Button orientation="vertical" icon={{ name: 'heroicons:cube' }} label="Medium" size="md" />
  <Button orientation="vertical" icon={{ name: 'heroicons:cube' }} label="Large" size="lg" />
  <Button orientation="vertical" icon={{ name: 'heroicons:cube' }} label="Extra Large" size="xl" />
</div>
