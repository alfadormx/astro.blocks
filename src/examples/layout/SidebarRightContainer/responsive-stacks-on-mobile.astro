---
import SidebarRightContainer from '~/components/blocks/layout/SidebarRightContainer.astro';
---

<SidebarRightContainer
  htmlTag="section"
  containerWidthType="full"
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-8' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  responsive={true}
  spacing={{ margin: 'mb-8' }}
>
  <div slot="main" class="bg-error text-background p-6 rounded">
    <p class="font-semibold text-lg font-bold mb-2">Main Content</p>
    <p class="text-sm">Main content appears first on mobile.</p>
  </div>
  <div slot="sidebar" class="bg-accent text-background p-6 rounded">
    <p class="font-semibold text-lg font-bold mb-2">Sidebar</p>
    <p class="text-sm">This sidebar appears below on mobile devices.</p>
  </div>
</SidebarRightContainer>
