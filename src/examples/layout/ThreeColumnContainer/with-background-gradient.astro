---
import ThreeColumnContainer from '~/components/blocks/layout/ThreeColumnContainer.astro';
---

<ThreeColumnContainer
  containerWidthType="full"
  background={{ class: 'bg-gradient-to-br from-blue via-mauve to-pink' }}
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-12' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  gap="normal"
  spacing={{ margin: 'mb-8' }}
>
  <div slot="left" class="bg-white/90 backdrop-blur p-6 rounded shadow-lg">
    <h3>Service 1</h3>
    <p>Premium quality service with attention to detail.</p>
  </div>
  <div slot="center" class="bg-white/90 backdrop-blur p-6 rounded shadow-lg">
    <h3>Service 2</h3>
    <p>Expert support available 24/7 for your needs.</p>
  </div>
  <div slot="right" class="bg-white/90 backdrop-blur p-6 rounded shadow-lg">
    <h3>Service 3</h3>
    <p>Flexible plans tailored to your requirements.</p>
  </div>
</ThreeColumnContainer>
