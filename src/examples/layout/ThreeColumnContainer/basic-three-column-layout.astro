---
import ThreeColumnContainer from '~/components/blocks/layout/ThreeColumnContainer.astro';
---

<ThreeColumnContainer
  containerWidthType="full"
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-8' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  spacing={{ margin: 'mb-8' }}
>
  <div slot="left" class="bg-primary text-background p-6 rounded text-center">
    <p class="font-semibold">Column 1</p>
    <p>First column content.</p>
  </div>
  <div slot="center" class="bg-success text-background p-6 rounded text-center">
    <p class="font-semibold">Column 2</p>
    <p>Second column content.</p>
  </div>
  <div slot="right" class="bg-secondary text-background p-6 rounded text-center">
    <p class="font-semibold">Column 3</p>
    <p>Third column content.</p>
  </div>
</ThreeColumnContainer>
