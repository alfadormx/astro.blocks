---
import ThreeColumnContainer from '~/components/blocks/layout/ThreeColumnContainer.astro';
---

<ThreeColumnContainer
  containerWidthType="full"
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-8' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  responsive={true}
  spacing={{ margin: 'mb-8' }}
>
  <div slot="left" class="bg-accent text-background p-6 rounded text-center">
    <p class="font-semibold">Mobile Friendly</p>
    <p>Stacks vertically on small screens.</p>
  </div>
  <div slot="center" class="bg-error text-background p-6 rounded text-center">
    <p class="font-semibold">Tablet Ready</p>
    <p>Responsive by default.</p>
  </div>
  <div slot="right" class="bg-tertiary text-background p-6 rounded text-center">
    <p class="font-semibold">Desktop Optimized</p>
    <p>Three columns on larger screens.</p>
  </div>
</ThreeColumnContainer>
