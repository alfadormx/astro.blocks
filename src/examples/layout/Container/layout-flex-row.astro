---
import Container from '~/components/blocks/layout/Container.astro';
---

<Container
  containerWidthType="full"
  layout={{ type: 'flex', class: 'flex-row gap-4 items-center justify-between' }}
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-8' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  spacing={{ margin: 'mb-8' }}
>
  <div class="bg-blue text-white p-4 rounded">Item 1</div>
  <div class="bg-green text-white p-4 rounded">Item 2</div>
  <div class="bg-mauve text-white p-4 rounded">Item 3</div>
</Container>
