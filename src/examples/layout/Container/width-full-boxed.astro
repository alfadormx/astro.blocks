---
import Container from '~/components/blocks/layout/Container.astro';
---

<Container
  containerWidthType="full"
  content={{
    widthType: 'boxed',
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  spacing={{ margin: 'mb-8' }}
>
  <p class="text-center py-8">Full-width container, boxed content (default max-width).</p>
</Container>
