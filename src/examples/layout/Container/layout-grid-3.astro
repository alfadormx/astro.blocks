---
import Container from '~/components/blocks/layout/Container.astro';
---

<Container
  containerWidthType="full"
  layout={{ type: 'grid', class: 'grid-cols-3 gap-4' }}
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-8' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  spacing={{ margin: 'mb-8' }}
>
  <div class="bg-blue text-white p-4 rounded text-center">1</div>
  <div class="bg-green text-white p-4 rounded text-center">2</div>
  <div class="bg-mauve text-white p-4 rounded text-center">3</div>
  <div class="bg-peach text-white p-4 rounded text-center">4</div>
  <div class="bg-pink text-white p-4 rounded text-center">5</div>
  <div class="bg-red text-white p-4 rounded text-center">6</div>
</Container>
