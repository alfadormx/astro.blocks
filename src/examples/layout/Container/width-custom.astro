---
import Container from '~/components/blocks/layout/Container.astro';
---

<Container
  containerWidthType="custom"
  width="w-3/4"
  content={{ border: { width: 'border', color: 'border-border-emphasis border-dotted' } }}
  border={{ width: 'border', color: 'border-border' }}
  spacing={{ margin: 'mb-8' }}
>
  <p class="text-center py-8">Custom container width (background and content custom, e.g., 75%).</p>
</Container>
