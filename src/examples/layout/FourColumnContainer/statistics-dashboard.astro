---
import FourColumnContainer from '~/components/blocks/layout/FourColumnContainer.astro';
---

<FourColumnContainer
  containerWidthType="full"
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-12' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  gap="normal"
  spacing={{ margin: 'mb-8' }}
>
  <div slot="left" class="bg-blue-50 p-6 rounded-lg border-2 border-blue-200">
    <div class="text-3xl font-bold text-blue-600 mb-2">1.2M</div>
    <p class="text-gray-800">Active Users</p>
  </div>
  <div slot="centerLeft" class="bg-green-50 p-6 rounded-lg border-2 border-green-200">
    <div class="text-3xl font-bold text-green-600 mb-2">98%</div>
    <p class="text-gray-800">Satisfaction Rate</p>
  </div>
  <div slot="centerRight" class="bg-purple-50 p-6 rounded-lg border-2 border-purple-200">
    <div class="text-3xl font-bold text-purple-600 mb-2">24/7</div>
    <p class="text-gray-800">Support Available</p>
  </div>
  <div slot="right" class="bg-orange-50 p-6 rounded-lg border-2 border-orange-200">
    <div class="text-3xl font-bold text-orange-600 mb-2">150+</div>
    <p class="text-gray-800">Countries</p>
  </div>
</FourColumnContainer>
