---
import FourColumnContainer from '~/components/blocks/layout/FourColumnContainer.astro';
---

<FourColumnContainer
  containerWidthType="full"
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-8' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  gap="tight"
  spacing={{ margin: 'mb-8' }}
>
  <div slot="left">
    <img
      src="https://images.pexels.com/photos/1170686/pexels-photo-1170686.jpeg?auto=compress&cs=tinysrgb&w=400"
      alt="Gallery 1"
      class="w-full h-48 object-cover rounded"
    />
  </div>
  <div slot="centerLeft">
    <img
      src="https://images.pexels.com/photos/1629236/pexels-photo-1629236.jpeg?auto=compress&cs=tinysrgb&w=400"
      alt="Gallery 2"
      class="w-full h-48 object-cover rounded"
    />
  </div>
  <div slot="centerRight">
    <img
      src="https://images.pexels.com/photos/23384599/pexels-photo-23384599.jpeg?auto=compress&cs=tinysrgb&w=400"
      alt="Gallery 3"
      class="w-full h-48 object-cover rounded"
    />
  </div>
  <div slot="right">
    <img
      src="https://images.pexels.com/photos/1261728/pexels-photo-1261728.jpeg?auto=compress&cs=tinysrgb&w=400"
      alt="Gallery 4"
      class="w-full h-48 object-cover rounded"
    />
  </div>
</FourColumnContainer>
