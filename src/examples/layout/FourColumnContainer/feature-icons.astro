---
import FourColumnContainer from '~/components/blocks/layout/FourColumnContainer.astro';
---

<FourColumnContainer
  containerWidthType="full"
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-12' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  gap="loose"
  spacing={{ margin: 'mb-8' }}
>
  <div slot="left" class="text-center">
    <div class="text-5xl mb-4">🚀</div>
    <h3>Fast</h3>
    <p class="text-sm">Lightning speed performance</p>
  </div>
  <div slot="centerLeft" class="text-center">
    <div class="text-5xl mb-4">🔒</div>
    <h3>Secure</h3>
    <p class="text-sm">Enterprise-grade security</p>
  </div>
  <div slot="centerRight" class="text-center">
    <div class="text-5xl mb-4">💡</div>
    <h3>Smart</h3>
    <p class="text-sm">Intelligent automation</p>
  </div>
  <div slot="right" class="text-center">
    <div class="text-5xl mb-4">🌍</div>
    <h3>Global</h3>
    <p class="text-sm">Worldwide coverage</p>
  </div>
</FourColumnContainer>
