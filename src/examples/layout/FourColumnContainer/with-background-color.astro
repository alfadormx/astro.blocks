---
import FourColumnContainer from '~/components/blocks/layout/FourColumnContainer.astro';
---

<FourColumnContainer
  containerWidthType="full"
  background={{ class: 'bg-elevated' }}
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-12' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  spacing={{ margin: 'mb-8' }}
>
  <div slot="left" class="bg-surface p-6 rounded">
    <p class="font-semibold">Step 1</p>
    <p class="text-sm">Sign up for free</p>
  </div>
  <div slot="centerLeft" class="bg-surface p-6 rounded">
    <p class="font-semibold">Step 2</p>
    <p class="text-sm">Choose your plan</p>
  </div>
  <div slot="centerRight" class="bg-surface p-6 rounded">
    <p class="font-semibold">Step 3</p>
    <p class="text-sm">Start building</p>
  </div>
  <div slot="right" class="bg-surface p-6 rounded">
    <p class="font-semibold">Step 4</p>
    <p class="text-sm">Deploy & scale</p>
  </div>
</FourColumnContainer>
