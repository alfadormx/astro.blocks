---
import FourColumnContainer from '~/components/blocks/layout/FourColumnContainer.astro';
---

<FourColumnContainer
  containerWidthType="full"
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-12' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  gap="loose"
  spacing={{ margin: 'mb-8' }}
>
  <div slot="left">
    <div class="bg-linear-to-br from-blue-400 to-blue-700 w-16 h-16 rounded-lg mb-4 flex items-center justify-center text-white text-2xl">
      📱
    </div>
    <h3>Mobile First</h3>
    <p class="text-sm text-gray-800">Optimized for all mobile devices with responsive design.</p>
  </div>
  <div slot="centerLeft">
    <div class="bg-linear-to-br from-green-400 to-green-700 w-16 h-16 rounded-lg mb-4 flex items-center justify-center text-white text-2xl">
      ⚡
    </div>
    <h3>Lightning Fast</h3>
    <p class="text-sm text-gray-800">Blazing fast performance with optimized code.</p>
  </div>
  <div slot="centerRight">
    <div class="bg-linear-to-br from-purple-400 to-purple-700 w-16 h-16 rounded-lg mb-4 flex items-center justify-center text-white text-2xl">
      🎨
    </div>
    <h3>Customizable</h3>
    <p class="text-sm text-gray-800">Fully customizable with Tailwind CSS utilities.</p>
  </div>
  <div slot="right">
    <div class="bg-linear-to-br from-orange-400 to-orange-700 w-16 h-16 rounded-lg mb-4 flex items-center justify-center text-white text-2xl">
      🔧
    </div>
    <h3>Easy Setup</h3>
    <p class="text-sm text-gray-800">Get started in minutes with simple configuration.</p>
  </div>
</FourColumnContainer>
