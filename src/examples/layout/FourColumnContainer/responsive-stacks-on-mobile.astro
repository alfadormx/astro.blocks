---
import FourColumnContainer from '~/components/blocks/layout/FourColumnContainer.astro';
---

<FourColumnContainer
  containerWidthType="full"
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-8' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  responsive={true}
  spacing={{ margin: 'mb-8' }}
>
  <div slot="left" class="bg-error text-background p-6 rounded text-center">
    <p class="font-semibold">Mobile</p>
  </div>
  <div slot="centerLeft" class="bg-accent text-background p-6 rounded text-center">
    <p class="font-semibold">Tablet</p>
  </div>
  <div slot="centerRight" class="bg-warning text-background p-6 rounded text-center">
    <p class="font-semibold">Desktop</p>
  </div>
  <div slot="right" class="bg-success text-background p-6 rounded text-center">
    <p class="font-semibold">4K</p>
  </div>
</FourColumnContainer>
