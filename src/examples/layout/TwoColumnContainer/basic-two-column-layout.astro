---
import TwoColumnContainer from '~/components/blocks/layout/TwoColumnContainer.astro';
---

<TwoColumnContainer
  containerWidthType="full"
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-8' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  spacing={{ margin: 'mb-8' }}
>
  <div slot="left" class="bg-primary text-background p-6 rounded">
    <p class="font-semibold">Column 1</p>
    <p>This is the first column with some content.</p>
  </div>
  <div slot="right" class="bg-success text-background p-6 rounded">
    <p class="font-semibold">Column 2</p>
    <p>This is the second column with some content.</p>
  </div>
</TwoColumnContainer>
