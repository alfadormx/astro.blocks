---
import TwoColumnContainer from '~/components/blocks/layout/TwoColumnContainer.astro';
import Button from '~/components/blocks/primitives/Button.astro';
import Headline from '~/components/blocks/primitives/Headline.astro';
import Image from '~/components/blocks/primitives/Image.astro';
---

<TwoColumnContainer
  containerWidthType="full"
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-12' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  spacing={{ margin: 'mb-8' }}
>
  <div slot="left">
    <Image
      src="~/assets/images/demos/saas/content-a.jpg"
      alt="Hands over printed charts"
      width={600}
      height={400}
      class="w-full h-full object-cover rounded"
    />
  </div>
  <div slot="right" class="flex flex-col justify-center">
    <Headline title="About Our Product" htmlTag="h4" class="my-0" titleClass="mb-4 text-2xl" />
    <p class="mb-4">
      This is a common pattern for landing pages - image on one side, content on the other.
    </p>
    <p class="mb-4">Perfect for features, about sections, or product showcases.</p>
    <Button label="Learn More" align="left" />
  </div>
</TwoColumnContainer>
