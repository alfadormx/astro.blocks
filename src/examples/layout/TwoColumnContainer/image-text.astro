---
import TwoColumnContainer from '~/components/blocks/layout/TwoColumnContainer.astro';
---

<TwoColumnContainer
  containerWidthType="full"
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-12' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  spacing={{ margin: 'mb-8' }}
>
  <div slot="left">
    <img
      src="https://images.pexels.com/photos/1170686/pexels-photo-1170686.jpeg?auto=compress&cs=tinysrgb&w=600"
      alt="Sample"
      class="w-full h-full object-cover rounded"
    />
  </div>
  <div slot="right" class="flex flex-col justify-center">
    <h3 class="text-2xl font-bold mb-4">About Our Product</h3>
    <p class="mb-4">
      This is a common pattern for landing pages - image on one side, content on the other.
    </p>
    <p class="mb-4">Perfect for features, about sections, or product showcases.</p>
    <button class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700">Learn More</button>
  </div>
</TwoColumnContainer>
