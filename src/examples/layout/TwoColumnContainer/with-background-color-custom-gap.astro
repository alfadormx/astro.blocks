---
import TwoColumnContainer from '~/components/blocks/layout/TwoColumnContainer.astro';
---

<TwoColumnContainer
  containerWidthType="full"
  background={{ class: 'bg-linear-to-r from-tertiary to-accent' }}
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-8' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  gap="loose"
  spacing={{ margin: 'mb-8' }}
>
  <div slot="left" class="bg-surface p-6 rounded shadow-lg">
    <p class="font-semibold">Feature 1</p>
    <p>Larger gap between columns (loose).</p>
  </div>
  <div slot="right" class="bg-surface p-6 rounded shadow-lg">
    <p class="font-semibold">Feature 2</p>
    <p>With gradient background.</p>
  </div>
</TwoColumnContainer>
