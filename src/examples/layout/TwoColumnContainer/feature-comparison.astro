---
import TwoColumnContainer from '~/components/blocks/layout/TwoColumnContainer.astro';
---

<TwoColumnContainer
  containerWidthType="full"
  content={{
    widthType: 'boxed',
    spacing: { padding: 'py-8' },
    border: { width: 'border', color: 'border-border-emphasis border-dotted' },
  }}
  border={{ width: 'border', color: 'border-border' }}
  spacing={{ margin: 'mb-8' }}
>
  <div slot="left" class="space-y-4">
    <h3 class="text-xl font-bold mb-4">Free Plan</h3>
    <div class="flex items-start gap-2">
      <span class="text-green-600">✓</span>
      <span>Basic features</span>
    </div>
    <div class="flex items-start gap-2">
      <span class="text-green-600">✓</span>
      <span>Up to 5 users</span>
    </div>
    <div class="flex items-start gap-2">
      <span class="text-red-600">✗</span>
      <span>Advanced analytics</span>
    </div>
    <div class="flex items-start gap-2">
      <span class="text-red-600">✗</span>
      <span>Priority support</span>
    </div>
  </div>
  <div slot="right" class="space-y-4">
    <h3 class="text-xl font-bold mb-4">Pro Plan</h3>
    <div class="flex items-start gap-2">
      <span class="text-green-600">✓</span>
      <span>All features</span>
    </div>
    <div class="flex items-start gap-2">
      <span class="text-green-600">✓</span>
      <span>Unlimited users</span>
    </div>
    <div class="flex items-start gap-2">
      <span class="text-green-600">✓</span>
      <span>Advanced analytics</span>
    </div>
    <div class="flex items-start gap-2">
      <span class="text-green-600">✓</span>
      <span>Priority support</span>
    </div>
  </div>
</TwoColumnContainer>
