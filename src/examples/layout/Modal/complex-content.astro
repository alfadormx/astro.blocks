---
import Modal from '~/components/blocks/layout/Modal.astro';
import Button from '~/components/blocks/primitives/Button.astro';
import Headline from '~/components/blocks/primitives/Headline.astro';
import Input from '~/components/blocks/primitives/Input.astro';
import TextArea from '~/components/blocks/primitives/TextArea.astro';
---

<Button
  data-modal-trigger="modal-complex"
  icon={{ name: 'heroicons:document-text' }}
  label="Open Form Modal"
/>
<Modal id="modal-complex" size="lg">
  <div class="p-6">
    <Headline title="Contact Form" htmlTag="h2" class="my-0" titleClass="text-xl" />
    <form class="space-y-4">
      <Input label="Name" name="name" placeholder="Enter your name" />
      <Input label="Email" name="email" type="email" placeholder="Enter your email" />
      <TextArea label="Message" name="message" rows={4} placeholder="Enter your message" />
      <div class="flex gap-2 pt-4">
        <Button icon={{ name: 'heroicons:paper-airplane' }} label="Send Message" />
        <Button data-modal-close variant="outline" label="Cancel" />
      </div>
    </form>
  </div>
</Modal>
