---
import Modal from '~/components/blocks/layout/Modal.astro';
import Button from '~/components/blocks/primitives/Button.astro';
import Headline from '~/components/blocks/primitives/Headline.astro';
---

<Button data-modal-trigger="modal-custom" label="Open Custom Modal" />
<Modal
  id="modal-custom"
  size="md"
  backdropClass="bg-linear-to-br from-primary/20 to-accent/20"
  class="border-2 border-primary bg-linear-to-br from-background to-surface"
>
  <div class="p-6">
    <Headline title="Custom Styled Modal" htmlTag="h2" class="my-0" titleClass="text-xl" />
    <p class="text-muted mb-4">
      This modal has custom backdrop and content styling applied through class props.
    </p>
    <Button data-modal-close label="Close" />
  </div>
</Modal>
