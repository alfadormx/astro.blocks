---
import Modal from '~/components/blocks/layout/Modal.astro';
import Button from '~/components/blocks/primitives/Button.astro';
---

<div class="flex flex-wrap gap-4">
  <Button data-modal-trigger="modal-center" size="sm" label="Center" />
  <Button data-modal-trigger="modal-top" size="sm" label="Top" />
  <Button data-modal-trigger="modal-bottom" size="sm" label="Bottom" />
  <Button data-modal-trigger="modal-left" size="sm" label="Left" />
  <Button data-modal-trigger="modal-right" size="sm" label="Right" />
  <Modal id="modal-center" position="center" size="sm">
    <div class="p-6">
      <h3>Center Position</h3>
      <p class="text-sm text-muted">Default centered position.</p>
    </div>
  </Modal>

  <Modal id="modal-top" position="top" size="sm">
    <div class="p-6">
      <h3>Top Position</h3>
      <p class="text-sm text-muted">Appears at the top of the screen.</p>
    </div>
  </Modal>

  <Modal id="modal-bottom" position="bottom" size="sm">
    <div class="p-6">
      <h3>Bottom Position</h3>
      <p class="text-sm text-muted">Appears at the bottom of the screen.</p>
    </div>
  </Modal>

  <Modal id="modal-left" position="left" size="sm">
    <div class="p-6">
      <h3>Left Position</h3>
      <p class="text-sm text-muted">Slides in from the left side.</p>
    </div>
  </Modal>

  <Modal id="modal-right" position="right" size="sm">
    <div class="p-6">
      <h3>Right Position</h3>
      <p class="text-sm text-muted">Slides in from the right side.</p>
    </div>
  </Modal>
</div>
