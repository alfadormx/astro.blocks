---
import Item from '~/components/blocks/composite/Item.astro';
import type { ImageProps } from '~/types/image.types';

const image: ImageProps = {
  src: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4',
  alt: 'Mountain landscape',
  width: 96,
  height: 96,
};
---

<div class="flex flex-wrap items-start gap-6">
  <div class="max-w-xs">
    <Item
      image={image}
      title="Image, Title and Content"
      content="The image replaces the icon in the media slot."
    />
  </div>
  <div class="max-w-xs">
    <Item image={image} />
  </div>
  <div class="max-w-md">
    <Item
      image={image}
      title="Horizontal"
      content="An image works in the horizontal layout too."
      orientation="horizontal"
    />
  </div>
</div>
