---
import Item from '~/components/blocks/composite/Item.astro';
---

<div class="max-w-sm">
  <Item
    icon={{ name: 'heroicons:code-bracket', class: 'text-primary' }}
    title="Open source"
    content="Read the code, try the demo, or tell us what broke."
    defaultActionConfig={{ variant: 'outline', intent: 'accent', size: 'sm' }}
    actions={[
      { label: 'Docs', href: '#' },
      { label: 'Demo', href: '#' },
      { label: 'Report', href: '#', intent: 'error' },
    ]}
  />
</div>
