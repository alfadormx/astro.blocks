---
import Tabs from '~/components/blocks/composite/Tabs.astro';
---

<Tabs
  items={[
    { label: 'Overview' },
    { label: 'API' },
    { label: 'Examples' },
    { label: 'Themes' },
    { label: 'Layout' },
    { label: 'Tokens' },
  ]}
  defaultItemConfig={{
    variant: 'ghost',
    intent: 'neutral',
    orientation: 'vertical',
    icon: { name: 'heroicons:cube' },
  }}
  activeItemConfig={{ variant: 'solid', intent: 'primary' }}
  tabList={{ layout: 'grid', columns: 3 }}
>
  <div slot="panel-0">
    <p>Overview panel content.</p>
  </div>
  <div slot="panel-1">
    <p>API panel content.</p>
  </div>
  <div slot="panel-2">
    <p>Examples panel content.</p>
  </div>
  <div slot="panel-3">
    <p>Themes panel content.</p>
  </div>
  <div slot="panel-4">
    <p>Layout panel content.</p>
  </div>
  <div slot="panel-5">
    <p>Tokens panel content.</p>
  </div>
</Tabs>
