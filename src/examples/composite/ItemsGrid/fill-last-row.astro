---
import ItemsGridBlock from '~/components/blocks/composite/ItemsGrid.astro';
---

<ItemsGridBlock
  columns={2}
  responsive={false}
  fillLastRow
  gap="tight"
  defaultItemConfig={{
    border: { width: 'border', color: 'border-border' },
    spacing: { padding: 'p-4' },
  }}
  items={[
    { title: 'One' },
    { title: 'Two' },
    { title: 'Three' },
    { title: 'Four' },
    { title: 'Five', content: 'Alone in its row, so it spans both columns.' },
  ]}
/>
