---
const tokens = [
  'text',
  'subtext1',
  'subtext0',
  'overlay2',
  'overlay1',
  'overlay0',
  'surface2',
  'surface1',
  'surface0',
  'base',
  'mantle',
  'crust',
  'black',
  'white',
];
---

<div class="grid grid-cols-4 gap-4 sm:grid-cols-7">
  {tokens.map((token) => (
    <div class="flex flex-col items-center gap-1">
      <span class={`size-16 rounded border border-border bg-${token}`} />
      <span class="text-sm text-muted">{token}</span>
    </div>
  ))}
</div>
